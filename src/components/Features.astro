---
import featuresData from '../data/features.json';

const { promise } = featuresData;

const colorClasses = {
  green: 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400',
  yellow: 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400',
  orange: 'bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400',
};
---

<section class="w-full px-4 md:px-10 py-16 bg-[#fcfaf8] dark:bg-[#1e170e] relative overflow-hidden">
  <!-- Floating Abstract Shape -->
  <div class="absolute top-10 left-10 opacity-5 text-text-muted pointer-events-none float-abstract">
    <svg width="150" height="150" viewBox="0 0 200 200" fill="currentColor">
      <path
        d="M44.7,-76.4C58.9,-69.2,71.8,-59.1,81.6,-46.6C91.4,-34.1,98.1,-19.2,95.8,-4.9C93.5,9.3,82.2,22.9,71.2,34.3C60.2,45.7,49.5,54.9,37.9,61.9C26.3,68.9,13.8,73.7,0.4,73C-13,72.3,-26.1,66.1,-38.6,59.6C-51.1,53.1,-63.1,46.3,-72.1,36.5C-81.1,26.7,-87.1,13.9,-85.7,2C-84.3,-9.9,-75.5,-20.9,-66.2,-31C-56.9,-41.1,-47.1,-50.3,-36.2,-59.3C-25.3,-68.3,-13.3,-77.1,0.5,-78C14.3,-78.9,28.7,-71.9,44.7,-76.4Z"
        transform="translate(100 100)"
      />
    </svg>
  </div>
  
  <div class="max-w-7xl mx-auto flex flex-col gap-12 relative z-10">
    <div class="flex flex-col gap-4 text-center items-center">
      <h2 class="text-3xl md:text-4xl font-bold text-text-main dark:text-white">{promise.title}</h2>
      <p class="text-text-muted dark:text-[#a89d91] max-w-2xl text-lg">
        {promise.subtitle}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {promise.features.map((feature) => (
        <div
          class="flex flex-col gap-4 p-6 rounded-2xl border border-[#e7ddcf] dark:border-[#3a2d1e] bg-white dark:bg-[#2a2016] hover:border-primary/50 transition-colors group"
        >
          <div
            class={`size-12 rounded-full ${colorClasses[feature.iconColor as keyof typeof colorClasses]} flex items-center justify-center group-hover:scale-110 transition-transform`}
          >
            <span class="material-symbols-outlined">{feature.icon}</span>
          </div>
          <div>
            <h3 class="text-xl font-bold mb-2">{feature.title}</h3>
            <p class="text-text-muted dark:text-[#a89d91]">{feature.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
