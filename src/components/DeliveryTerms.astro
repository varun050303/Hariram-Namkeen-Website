---
// DeliveryTerms.astro — Refined Heritage Delivery Strip
// Compact, artisanal announcement strip communicating:
// 1. First-order free delivery on min. 1kg (any 4 packs)
// 2. All orders free delivery on 2kg+
// 3. Fresh kitchen dispatch in 24–48 hours
---

<div class="delivery-strip" id="delivery-terms">
  <div class="container">
    <div class="delivery-strip-inner">
      <div class="ds-item">
        <span class="ds-tag">First Order</span>
        <span class="ds-text">Free delivery on <strong>1kg+</strong> <span class="ds-hint">(any 4 packs)</span></span>
      </div>

      <span class="ds-sep" aria-hidden="true">✦</span>

      <div class="ds-item">
        <span class="ds-tag">All Orders</span>
        <span class="ds-text">Free delivery on <strong>2kg or above</strong></span>
      </div>

      <span class="ds-sep" aria-hidden="true">✦</span>

      <div class="ds-item">
        <span class="ds-tag ds-tag-muted">Direct Kitchen</span>
        <span class="ds-text">Dispatched fresh across India in 24–48 hrs</span>
      </div>
    </div>
  </div>
</div>

<style>
  .delivery-strip {
    padding: 10px 0;
    background: transparent;
    position: relative;
    z-index: 2;
  }

  .delivery-strip-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    background: #FFFDF9;
    border: 1px solid rgba(194, 127, 21, 0.28);
    border-radius: 999px;
    padding: 10px 24px;
    box-shadow: 0 2px 10px rgba(35, 15, 6, 0.04);
  }

  .ds-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-dim, #3B1F10);
    line-height: 1.3;
  }

  .ds-tag {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--maroon, #751818);
    background: rgba(117, 24, 24, 0.06);
    border: 1px solid rgba(117, 24, 24, 0.18);
    padding: 2.5px 8px;
    border-radius: 99px;
    white-space: nowrap;
  }

  .ds-tag-muted {
    color: var(--gold-d, #965F0B);
    background: rgba(194, 127, 21, 0.08);
    border-color: rgba(194, 127, 21, 0.25);
  }

  .ds-text {
    font-weight: 500;
    color: var(--text, #180702);
    white-space: nowrap;
  }

  .ds-text strong {
    font-weight: 700;
    color: var(--maroon, #751818);
  }

  .ds-hint {
    color: var(--text-muted, #5A351D);
    font-size: 12px;
  }

  .ds-sep {
    color: var(--gold, #C27F15);
    font-size: 9px;
    opacity: 0.7;
    user-select: none;
  }

  /* ── MOBILE VIEW ────────────────────────── */
  @media (max-width: 768px) {
    .delivery-strip {
      padding: 6px 0;
    }

    .delivery-strip-inner {
      border-radius: 14px;
      padding: 10px 14px;
      gap: 8px 12px;
      justify-content: flex-start;
      background: rgba(255, 253, 249, 0.98);
      border-color: rgba(194, 127, 21, 0.22);
    }

    .ds-item {
      font-size: 12px;
      gap: 6px;
    }

    .ds-tag {
      font-size: 9.5px;
      padding: 2px 7px;
    }

    .ds-text {
      white-space: normal;
    }

    .ds-sep {
      display: none;
    }
  }
</style>
