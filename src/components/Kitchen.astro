---
import contentData from '../data/content.json';

const { kitchen } = contentData;
---

<section class="w-full px-4 md:px-10 py-16 md:py-24 bg-[#3f4a3c] relative overflow-hidden text-white">
  <!-- Background Pattern -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: radial-gradient(rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 24px 24px; opacity: 0.2;"
  >
  </div>

  <!-- Floating Particles -->
  <div class="absolute bottom-10 right-10 opacity-10 text-white pointer-events-none float-leaf">
    <svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor">
      <path
        d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C8.58,15.06 10.13,10.5 18.88,10.96C18.73,11.03 18.29,11.53 17.53,12.87C16.89,14 16.5,15.25 16.5,15.25L18.25,16.25C18.25,16.25 18.78,14.65 19.34,13.67L22.1,8.9L17,8Z"
      />
    </svg>
  </div>

  <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-20 items-center relative z-10">
    <!-- Content -->
    <div class="flex flex-col gap-6 lg:gap-8">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight tracking-tight">
        No Factories.<br />
        Just Our Kitchen.
      </h2>
      <p class="text-lg md:text-xl text-white/80 leading-relaxed max-w-lg">
        {kitchen.description}
      </p>
      <div class="flex flex-wrap gap-8 mt-4">
        {kitchen.badges.map((badge) => (
          <div class="flex items-center gap-4">
            <div class="size-12 rounded-full bg-white/10 flex items-center justify-center backdrop-blur-sm">
              <span class="material-symbols-outlined">{badge.icon}</span>
            </div>
            <div>
              <h3 class="font-bold text-lg">{badge.title}</h3>
              <p class="text-xs text-white/60 uppercase tracking-wider font-bold">{badge.subtitle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Image Grid -->
    <div class="grid grid-cols-2 gap-4 md:gap-6">
      <div class="space-y-4 md:space-y-6 flex flex-col justify-end">
        <div class="aspect-square rounded-2xl overflow-hidden shadow-2xl bg-black/20 group">
          <div
            class="w-full h-full bg-cover bg-center transform group-hover:scale-110 transition-transform duration-700"
            style={`background-image: url("${kitchen.images[0].src}");`}
          >
          </div>
        </div>
        <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl bg-black/20 group">
          <div
            class="w-full h-full bg-cover bg-center transform group-hover:scale-110 transition-transform duration-700"
            style={`background-image: url("${kitchen.images[1].src}");`}
          >
          </div>
        </div>
      </div>
      <div class="space-y-4 md:space-y-6 flex flex-col justify-start pt-8 lg:pt-12">
        <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl bg-black/20 group">
          <div
            class="w-full h-full bg-cover bg-center transform group-hover:scale-110 transition-transform duration-700"
            style={`background-image: url("${kitchen.images[2].src}");`}
          >
          </div>
        </div>
        <div class="aspect-square rounded-2xl overflow-hidden shadow-2xl bg-black/20 group">
          <div
            class="w-full h-full bg-cover bg-center transform group-hover:scale-110 transition-transform duration-700"
            style={`background-image: url("${kitchen.images[3].src}");`}
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
