---
export interface Props {
  id: string;
  name: string;
  description: string;
  price: number;
  weight: string;
  image: string;
  tags: string[];
}

const { name, description, price, weight, image, tags } = Astro.props;
---

<div
  class="bg-white dark:bg-[#221a10] rounded-xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-[#e7ddcf] dark:border-[#3a2d1e] group"
>
  <div class="aspect-square bg-[#f8f7f6] dark:bg-[#2c2217] relative overflow-hidden">
    <div
      class="w-full h-full bg-center bg-contain bg-no-repeat p-4 transform group-hover:scale-110 transition-transform duration-500"
      style={`background-image: url("${image}");`}
    >
    </div>
    {tags.length > 0 && (
      <div class="absolute top-3 right-3 bg-white dark:bg-black/50 backdrop-blur-md rounded-full px-3 py-1 text-xs font-bold shadow-sm">
        {tags[0]}
      </div>
    )}
  </div>
  <div class="p-4 flex flex-col gap-2">
    <h3 class="font-bold text-lg leading-tight">{name}</h3>
    <div class="flex items-center gap-2 text-sm text-text-muted dark:text-[#a89d91]">
      <span class="material-symbols-outlined text-[16px]">scale</span> {weight}
    </div>
    <div class="flex items-center justify-between mt-2">
      <span class="text-xl font-bold text-primary">₹{price}</span>
      <button
        class="bg-[#1b160d] dark:bg-white text-white dark:text-black size-8 rounded-full flex items-center justify-center hover:bg-primary dark:hover:bg-primary transition-colors"
      >
        <span class="material-symbols-outlined !text-[18px]">add</span>
      </button>
    </div>
  </div>
</div>
