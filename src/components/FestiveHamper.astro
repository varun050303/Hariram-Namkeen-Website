<script is:inline>
  // Hamper gallery thumbnail switcher & auto-cycle
  (() => {
    const gallery = document.getElementById('hamper-gallery');
    const thumbs = document.querySelectorAll('#hamper-thumbs .h-thumb');
    if (!gallery) return;
    const imgs = gallery.querySelectorAll('img');
    if (imgs.length < 2) return;
    let idx = 0;
    let timer = null;

    function setSlide(newIdx) {
      imgs[idx].classList.remove('active');
      thumbs[idx]?.classList.remove('active');

      idx = (newIdx + imgs.length) % imgs.length;

      imgs[idx].classList.add('active');
      thumbs[idx]?.classList.add('active');
    }

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => {
        setSlide(i);
        restartTimer();
      });
    });

    function startTimer() {
      timer = setInterval(() => {
        setSlide(idx + 1);
      }, 5000);
    }

    function restartTimer() {
      if (timer) clearInterval(timer);
      startTimer();
    }

    startTimer();
  })();
</script>
