          <img src="/images/hariram_special_4_top_view.png" alt="Hariram Special 4 - Top View Platter" class="active"/>
          <img src="/images/hariram_special_4_v2.png" alt="Hariram Special 4 - Portrait View with Brass Decanter"/>
          <img src="/images/hariram_special_4_top_view_wide_angle.png" alt="Hariram Special 4 - Wide Angle Table Presentation"/>
          <div class="hamper-badge">
            <span>Special 4 Box</span> · ₹499 Delivered
          </div>
        </div>

        <!-- Thumbnails for quick switching -->
        <div class="hamper-thumbs" id="hamper-thumbs">
          <button class="h-thumb active" data-img="0" aria-label="View Platter Top View">
            <img src="/images/hariram_special_4_top_view.png" alt="Platter Top View" />
          </button>
          <button class="h-thumb" data-img="1" aria-label="View Royal Brass Presentation">
            <img src="/images/hariram_special_4_v2.png" alt="Royal Presentation" />
          </button>
          <button class="h-thumb" data-img="2" aria-label="View Wide Angle Presentation">
            <img src="/images/hariram_special_4_top_view_wide_angle.png" alt="Wide Table Presentation" />
          </button>
        </div>
      </div>

      <!-- Right: Value Details & Contents (Tightly Aligned) -->
