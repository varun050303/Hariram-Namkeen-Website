---
// FestiveHamper.astro — Royal Kadhai Gourmet Edition
// Showcases The Hariram Special 4 Box (800g)
// Compact, dignified, gold & royal crimson aesthetic with zero cheap neon colors
---

<section class="hamper-section" id="hamper">
  <div class="hamper-inner">
    <div class="sec-tag hamper-tag"><span>✦</span> शाही उपहार · Artisanal Kadhai Tasting Box</div>
    <h2 class="sec-title">The Hariram <em>Special 4 Box</em></h2>
    <p class="sec-sub">4 fresh 200g signature packs (800g total). Pure yellow mustard oil, zero palm oil, and zero hidden charges.</p>

    <!-- ── SLEEK SINGLE-LINE TRUST RIBBON (COMPACT & DIGNIFIED) ── -->
    <div class="hamper-trust-ribbon">
      <div class="htr-item">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><circle cx="7" cy="18" r="2"/><path d="M15 18H9"/><circle cx="17" cy="18" r="2"/><path d="M17 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 15.52 8H14v10Z"/></svg>
        <span>Free All-India Delivery</span>
      </div>
      <span class="htr-sep">·</span>
      <div class="htr-item">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>No Hidden Fees (Taxes &amp; Packaging Included)</span>
      </div>
      <span class="htr-sep">·</span>
      <div class="htr-item">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
        <span>800g Net Weight (4 × 200g Packs)</span>
      </div>
      <span class="htr-sep">·</span>
      <div class="htr-item">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
        <span>100% Yellow Mustard Oil</span>
      </div>
    </div>

    <!-- ── COMPACT 2-COLUMN MAIN HAMPER GRID ── -->
    <div class="hamper-grid">
      <!-- Left: Interactive Gallery (Proportional & Compact) -->
      <div class="hamper-gallery-wrap">
        <div class="hamper-gallery" id="hamper-gallery">
          <!-- Slide 0: The Hariram Special 4 Box Platter (Single photo of the box) -->
          <img 
            src="/images/hariram_special_4_top_view.webp" 
            alt="The Hariram Special 4 Box (800g)" 
            class="active" 
            data-img="0"
            loading="lazy" 
            width="1024" 
            height="1024"
          />
          <!-- Slide 1: Aloo Bhujia Pack -->
          <img 
            src="/images/aloo_bhujia.webp" 
            alt="Aloo Bhujia (200g Pack)" 
            data-img="1"
            loading="lazy" 
            width="768" 
            height="1365"
          />
          <!-- Slide 2: Masala Chana Dal Pack -->
          <img 
            src="/images/masala_chana_dal.webp" 
            alt="Masala Chana Dal (200g Pack)" 
            data-img="2"
            loading="lazy" 
            width="900" 
            height="1600"
          />
          <!-- Slide 3: Dal Biji Pack -->
          <img 
            src="/images/dal-bhiji.jpg" 
            alt="Dal Biji (200g Pack)" 
            data-img="3"
            loading="lazy" 
            width="1800" 
            height="1200"
          />
          <!-- Slide 4: Spicy Malka Pack -->
          <img 
            src="/images/masala_malka.webp" 
            alt="Spicy Malka (200g Pack)" 
            data-img="4"
            loading="lazy" 
            width="1376" 
            height="768"
          />
          <div class="hamper-badge" id="hamper-badge">
            <span>Special 4 Box</span> · ₹499 Delivered
          </div>
        </div>

        <!-- Thumbnails: Full Box + 4 Individual Packs -->
        <div class="hamper-thumbs" id="hamper-thumbs">
          <button type="button" class="h-thumb active" data-img="0" aria-label="View Full Special 4 Box Platter" title="Special 4 Box">
            <img src="/images/hariram_special_4_top_view.webp" alt="Full Special 4 Box" loading="lazy" width="80" height="80"/>
            <span class="h-thumb-tag">Full Box</span>
          </button>
          <button type="button" class="h-thumb" data-img="1" aria-label="View Aloo Bhujia Pack" title="Aloo Bhujia">
            <img src="/images/aloo_bhujia.webp" alt="Aloo Bhujia Pack" loading="lazy" width="80" height="80"/>
            <span class="h-thumb-tag">Bhujia</span>
          </button>
          <button type="button" class="h-thumb" data-img="2" aria-label="View Masala Chana Dal Pack" title="Masala Chana Dal">
            <img src="/images/masala_chana_dal.webp" alt="Masala Chana Dal Pack" loading="lazy" width="80" height="80"/>
            <span class="h-thumb-tag">Chana</span>
          </button>
          <button type="button" class="h-thumb" data-img="3" aria-label="View Dal Biji Pack" title="Dal Biji">
            <img src="/images/dal-bhiji.jpg" alt="Dal Biji Pack" loading="lazy" width="80" height="80"/>
            <span class="h-thumb-tag">Dal Biji</span>
          </button>
          <button type="button" class="h-thumb" data-img="4" aria-label="View Spicy Malka Pack" title="Spicy Malka">
            <img src="/images/masala_malka.webp" alt="Spicy Malka Pack" loading="lazy" width="80" height="80"/>
            <span class="h-thumb-tag">Malka</span>
          </button>
        </div>
      </div>

      <!-- Right: Value Details & Contents (Tightly Aligned) -->
      <div class="hamper-details">
        <div class="hamper-price-card">
          <div class="hamper-price-left">
            <div class="hamper-price-label">Artisanal Tasting Box (800g)</div>
            <div class="hamper-price-val">₹499 <span class="hamper-price-pill">All-Inclusive</span></div>
          </div>
          <div class="hamper-shipping-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><circle cx="7" cy="18" r="2"/><path d="M15 18H9"/><circle cx="17" cy="18" r="2"/><path d="M17 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 15.52 8H14v10Z"/></svg>
            <div>
              <strong>Free Delivery</strong>
              <span>Across India · serviceable PIN codes</span>
            </div>
          </div>
        </div>

        <p class="hamper-desc">
          Pure ingredient price with zero hidden fees. Handcrafted in heavy iron kadhais with cold-pressed yellow mustard oil and stone-ground spices.
        </p>

        <!-- Interactive Pack Selector Header -->
        <div class="hamper-chips-header">
          <span class="hamper-chips-title">✦ Click any pack to preview:</span>
          <button type="button" class="hamper-reset-pill active" id="hamper-reset-pill" data-img="0" aria-label="View Full 4-Box Platter">
            <span>Show Full Box (800g)</span>
          </button>
        </div>

        <!-- The 4 Varieties Breakdown with clean SVG icons (Interactive Chips) -->
        <div class="hamper-contents" id="hamper-chips">
          <div class="hamper-item" data-img="1" role="button" tabindex="0" aria-label="Preview Aloo Bhujia pack">
            <span class="hamper-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <div class="hamper-item-info">
              <div class="h-name-row">
                <strong>Aloo Bhujia</strong>
                <span class="h-weight">200g</span>
              </div>
              <span class="hamper-item-sub">Crispy potato flakes &amp; besan in pure mustard oil</span>
            </div>
          </div>

          <div class="hamper-item" data-img="2" role="button" tabindex="0" aria-label="Preview Masala Chana Dal pack">
            <span class="hamper-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <div class="hamper-item-info">
              <div class="h-name-row">
                <strong>Masala Chana Dal</strong>
                <span class="h-weight">200g</span>
              </div>
              <span class="hamper-item-sub">Protein-rich roasted Bengal gram with tangy spices</span>
            </div>
          </div>

          <div class="hamper-item" data-img="3" role="button" tabindex="0" aria-label="Preview Dal Biji pack">
            <span class="hamper-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <div class="hamper-item-info">
              <div class="h-name-row">
                <strong>Dal Biji</strong>
                <span class="h-weight">200g</span>
              </div>
              <span class="hamper-item-sub">Traditional Muzaffarnagar moong dal heritage recipe</span>
            </div>
          </div>

          <div class="hamper-item hamper-choice" data-img="4" role="button" tabindex="0" aria-label="Preview Spicy Malka pack">
            <span class="hamper-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <div class="hamper-item-info">
              <div class="h-name-row">
                <strong>Spicy Malka / Moongfali</strong>
                <span class="h-weight">200g</span>
              </div>
              <span class="hamper-item-sub">Your choice of slow-roasted crunch</span>
            </div>
          </div>
        </div>

        <div class="hamper-cta">
          <a 
            href="https://wa.me/916396122920?text=Hi%20Hariram%20Namkeen%2C%20I%20want%20to%20order%20the%20Hariram%20Special%204%20Box%20(800g)%20for%20Rs.499%20with%20Free%20All-India%20Delivery.%20Please%20share%20payment%20and%20delivery%20details." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-hamper-cta" 
            data-magnetic
          >
            <span>Order Special 4 @ ₹499 (Free Delivery)</span>
            <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#products" class="btn-hamper-sec" data-magnetic>
            View Individual Packs
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Hamper gallery interactive pack switcher
  (() => {
    const gallery = document.getElementById('hamper-gallery');
    if (!gallery) return;
    const imgs = gallery.querySelectorAll('img');
    const badge = document.getElementById('hamper-badge');
    const thumbs = document.querySelectorAll('#hamper-thumbs .h-thumb');
    const chips = document.querySelectorAll('#hamper-chips .hamper-item');
    const resetPill = document.getElementById('hamper-reset-pill');

    const badgeTexts = [
      '<span>Special 4 Box</span> · ₹499 Delivered',
      '<span>Aloo Bhujia</span> · 200g Pack (In Box)',
      '<span>Masala Chana Dal</span> · 200g Pack (In Box)',
      '<span>Dal Biji</span> · 200g Pack (In Box)',
      '<span>Spicy Malka</span> · 200g Pack (In Box)'
    ];

    let current = 0;

    function setSlide(newIdx) {
      if (newIdx < 0 || newIdx >= imgs.length) return;
      current = newIdx;

      // Update active image
      imgs.forEach((img, i) => {
        img.classList.toggle('active', i === current);
      });

      // Update badge
      if (badge && badgeTexts[current]) {
        badge.innerHTML = badgeTexts[current];
      }

      // Update thumbs
      thumbs.forEach((thumb) => {
        const idx = parseInt(thumb.getAttribute('data-img'), 10);
        thumb.classList.toggle('active', idx === current);
      });

      // Update chips on the right (indices 1 to 4)
      chips.forEach((chip) => {
        const idx = parseInt(chip.getAttribute('data-img'), 10);
        chip.classList.toggle('active', idx === current);
      });

      // Update reset pill (index 0)
      if (resetPill) {
        resetPill.classList.toggle('active', current === 0);
      }
    }

    // Chips click handler
    chips.forEach((chip) => {
      const idx = parseInt(chip.getAttribute('data-img'), 10);
      const onSelect = () => {
        if (current === idx) {
          // Clicking again toggles back to full box
          setSlide(0);
        } else {
          setSlide(idx);
        }
      };
      chip.addEventListener('click', onSelect);
      chip.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          onSelect();
        }
      });
    });

    // Thumbs click handler
    thumbs.forEach((thumb) => {
      const idx = parseInt(thumb.getAttribute('data-img'), 10);
      thumb.addEventListener('click', () => setSlide(idx));
    });

    // Reset pill click handler
    if (resetPill) {
      resetPill.addEventListener('click', () => setSlide(0));
    }
  })();
</script>
