---
// ReelSection.astro — v2 Cinema Showcase
// 3 videos autoplaying continuously in infinite loop without audio
---

<section class="reel-section">
  <div class="reel-inner">
    <div class="sec-tag reel-tag"><span>✦</span> Behind The Scenes &amp; Unboxing</div>
    <h2 class="reel-heading">Kadhai to Kitchen. <em>Real Crunch.</em></h2>
    
    <div class="reels-grid">
      <!-- Reel 1: Customer Unboxing -->
      <div class="reel-container">
        <video 
          src="/videos/hariram_namkeen_reel_1.mp4" 
          autoplay 
          loop 
          muted 
          playsinline 
          preload="auto" 
          class="reel-video"
          aria-label="Fresh order unboxing reel"
        ></video>
      </div>

      <!-- Reel 2: Kitchen & Packaging -->
      <div class="reel-container">
        <video 
          src="/videos/hariram_namkeen_reel_2.mp4" 
          autoplay 
          loop 
          muted 
          playsinline 
          preload="auto" 
          class="reel-video"
          aria-label="Fresh packaging process reel"
        ></video>
      </div>

      <!-- Reel 3: Aloo Bhujia 360° Studio Shoot -->
      <div class="reel-container">
        <video 
          src="/videos/aloo_bhujia_rotating_shoot.mp4" 
          autoplay 
          loop 
          muted 
          playsinline 
          preload="auto" 
          class="reel-video"
          aria-label="360° Aloo Bhujia close-up texture reel"
        ></video>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Ensure all reel videos stay muted and autoplaying
  (() => {
    document.querySelectorAll('.reel-video').forEach(video => {
      video.muted = true;
      video.play().catch(() => {});
    });
  })();
</script>
