---
// ReelSection.astro — v2
// 3 video reels: 2 original + 1 new aloo bhujia rotating shoot
---

<section class="reel-section">
  <div class="reel-inner">
    <h2 class="reel-heading">Unboxing orders. <em>Real reactions.</em></h2>
    
    <div class="reels-grid">
      <!-- Reel 1 -->
      <div class="reel-container">
        <div class="reel-thumbnail">
          <img src="/images/dal-bhiji.jpg" alt="Reel 1 - Customer Unboxing" loading="lazy" />
          <button class="reel-play-btn" aria-label="Play Reel">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
        <div class="reel-embed-wrapper hidden">
          <video src="/videos/hariram_namkeen_reel_1.mp4" playsinline loop muted preload="metadata" style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;"></video>
        </div>
      </div>

      <!-- Reel 2 -->
      <div class="reel-container">
        <div class="reel-thumbnail">
          <img src="/images/premium.jpg" alt="Reel 2 - Premium Unboxing" loading="lazy" />
          <button class="reel-play-btn" aria-label="Play Reel">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
        <div class="reel-embed-wrapper hidden">
          <video src="/videos/hariram_namkeen_reel_2.mp4" playsinline loop muted preload="metadata" style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;"></video>
        </div>
      </div>

      <!-- Reel 3 - Aloo Bhujia 360° Shoot -->
      <div class="reel-container">
        <div class="reel-thumbnail">
          <img src="/images/aloo_bhujia.png" alt="Aloo Bhujia 360° Product Shoot" loading="lazy" />
          <button class="reel-play-btn" aria-label="Play Reel">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
        <div class="reel-embed-wrapper hidden">
          <video src="/videos/aloo_bhujia_rotating_shoot.mp4" playsinline loop muted preload="metadata" style="width: 100%; height: 100%; object-fit: cover; cursor: pointer;"></video>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Reel play/pause toggle
  (() => {
    document.querySelectorAll('.reel-container').forEach(container => {
      const thumbnail = container.querySelector('.reel-thumbnail');
      const embedWrapper = container.querySelector('.reel-embed-wrapper');
      const video = embedWrapper?.querySelector('video');
      if (!thumbnail || !embedWrapper || !video) return;

      thumbnail.addEventListener('click', () => {
        thumbnail.style.display = 'none';
        embedWrapper.classList.remove('hidden');
        video.muted = false;
        video.play();
      });

      video.addEventListener('click', () => {
        if (video.paused) {
          video.play();
        } else {
          video.pause();
        }
      });
    });
  })();
</script>
