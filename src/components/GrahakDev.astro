---
// GrahakDev.astro
// Indian cultural heritage section: ग्राहक देव तुल्य
// "The customer is equal to God" — our foundational ethos
---

<section class="gd-section" id="grahak-dev">
  <div class="gd-bg-text" aria-hidden="true">ग्राहक</div>

  <div class="gd-inner">
    <!-- Central Sanskrit proclamation -->
    <div class="gd-proclamation">
      <div class="sec-tag gd-tag">
        <span>✦</span> हमारी संस्कृति · Our Culture
      </div>
      <h2 class="gd-hindi-main">ग्राहक देव तुल्य</h2>
      <div class="gd-transliteration">Grahak Dev Tulya</div>
      <p class="gd-meaning">
        "The customer is equal to God."
      </p>
    </div>

    <!-- Three value pillars -->
    <div class="gd-pillars">
      <div class="gd-pillar">
        <div class="gd-pillar-symbol">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3c-1.5 2-4 5.5-4 9a4 4 0 0 0 8 0c0-3.5-2.5-7-4-9z"/>
            <path d="M12 7c-.5 1-1.5 2.5-1.5 4a1.5 1.5 0 0 0 3 0c0-1.5-1-3-1.5-4z"/>
            <path d="M5 21h14"/>
            <path d="M7 17h10"/>
          </svg>
        </div>
        <h3 class="gd-pillar-title">आदर · Respect</h3>
        <p class="gd-pillar-body">Every order is treated as a sacred gesture of trust. We never compromise on quality — from cold-pressing our own mustard oil to hand-checking every batch.</p>
      </div>

      <div class="gd-pillar gd-pillar--center">
        <div class="gd-pillar-symbol">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
            <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
            <path d="M7 21h10"/>
            <path d="M12 3v18"/>
            <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
          </svg>
        </div>
        <h3 class="gd-pillar-title">ईमानदारी · Honesty</h3>
        <p class="gd-pillar-body">No hidden ingredients. No misleading chemical fillers. What you read on our packet is exactly what goes in the kadhai — 100% genuine and transparent.</p>
      </div>

      <div class="gd-pillar">
        <div class="gd-pillar-symbol">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
          </svg>
        </div>
        <h3 class="gd-pillar-title">शुद्धता · Purity</h3>
        <p class="gd-pillar-body">Serving anything adulterated to a guest is considered the highest disrespect. We cook every namkeen with the exact reverence we cook for our own families.</p>
      </div>
    </div>

    <!-- Bottom quote -->
    <div class="gd-bottom-quote">
      <span class="gd-quote-line"></span>
      <p class="gd-quote-hindi">आप का विश्वास ही हमारी सबसे बड़ी पूंजी है।</p>
      <p class="gd-quote-eng">"Your satisfaction and trust are our greatest heritage."</p>
      <span class="gd-quote-line"></span>
    </div>
  </div>
</section>
