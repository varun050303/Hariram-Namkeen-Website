---
import faqData from '../data/faq.json';

const { faqs } = faqData;
---

<section class="w-full px-4 md:px-10 py-16 md:py-24 bg-background-light dark:bg-background-dark">
  <div class="max-w-4xl mx-auto flex flex-col gap-10">
    <div class="flex flex-col gap-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-text-main dark:text-white">
        Frequently Asked Questions
      </h2>
      <p class="text-text-muted dark:text-[#a89d91] text-lg">
        Everything you need to know about our authentic namkeen
      </p>
    </div>

    <div class="flex flex-col gap-4">
      {faqs.map((faq, index) => (
        <details
          class="group bg-white dark:bg-[#2a2016] rounded-xl border border-[#e7ddcf] dark:border-[#3a2d1e] overflow-hidden"
        >
          <summary class="flex items-center justify-between p-6 cursor-pointer hover:bg-[#fcfaf8] dark:hover:bg-[#33281d] transition-colors">
            <h3 class="text-lg font-bold text-text-main dark:text-white pr-4">
              {faq.question}
            </h3>
            <span class="material-symbols-outlined text-primary shrink-0 group-open:rotate-180 transition-transform">
              expand_more
            </span>
          </summary>
          <div class="px-6 pb-6">
            <p class="text-text-muted dark:text-[#a89d91] leading-relaxed">
              {faq.answer}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- FAQ Schema for SEO -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
})} />
