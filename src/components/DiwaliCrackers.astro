---
// DiwaliCrackers.astro — Festive Diwali Firecrackers & Sparkler Burst Effect
// Triggers realistic, celebratory golden firecracker bursts when visitors scroll into sections.
// Also allows playful click/tap sparkler bursts!
// Zero external libraries (Pure Vanilla Canvas2D), 60FPS, 0% CPU when idle.
---

<canvas id="diwali-fireworks-canvas" class="diwali-fireworks-canvas" aria-hidden="true"></canvas>

<style>
  .diwali-fireworks-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 999;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .diwali-fireworks-canvas {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    // Respect user's motion preferences
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const canvas = document.getElementById('diwali-fireworks-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    function resizeCanvas() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);
    }

    window.addEventListener('resize', resizeCanvas, { passive: true });
    resizeCanvas();

    // ── FESTIVE COLOR PALETTES ──────────────────────────────
    // Golden Mustard, Royal Crimson, Saffron Flame, & Warm Starlight
    const PALETTES = {
      gold: ['#FDE047', '#F59E0B', '#D97706', '#FEF08A', '#FFFDF0', '#C27F15', '#B45309'],
      crimsonGold: ['#E11D48', '#BE123C', '#F59E0B', '#FDE047', '#FAF5EB', '#991B1B', '#EA580C'],
      saffronFlame: ['#F97316', '#EA580C', '#FBBF24', '#FDE047', '#FFFFFF', '#D97706'],
      grandDiwali: ['#FDE047', '#F59E0B', '#E11D48', '#EA580C', '#FEF08A', '#FFFFFF', '#C27F15', '#FFEDD5']
    };

    const particles = [];
    const stars = [];
    let isAnimating = false;

    // ── SPARK PARTICLE CLASS ────────────────────────────────
    class SparkParticle {
      constructor(x, y, color, vx, vy, options = {}) {
        this.x = x;
        this.y = y;
        this.color = color;
        this.vx = vx;
        this.vy = vy;
        this.friction = options.friction || 0.96;
        this.gravity = options.gravity || 0.12;
        this.alpha = 1;
        this.decay = options.decay || (0.012 + Math.random() * 0.015);
        this.size = options.size || (2.2 + Math.random() * 2.2);
        this.trail = [];
        this.maxTrail = options.trailLength || 4;
        this.sparkle = Math.random() > 0.35;
      }

      update() {
        this.trail.unshift({ x: this.x, y: this.y, alpha: this.alpha });
        if (this.trail.length > this.maxTrail) {
          this.trail.pop();
        }

        this.vx *= this.friction;
        this.vy *= this.friction;
        this.vy += this.gravity;

        this.x += this.vx;
        this.y += this.vy;

        this.alpha -= this.decay;
        return this.alpha > 0;
      }

      draw(c) {
        if (this.alpha <= 0) return;

        // Draw glowing motion trail
        for (let i = 0; i < this.trail.length; i++) {
          const pt = this.trail[i];
          const trailAlpha = (pt.alpha * (1 - i / this.trail.length)) * 0.55;
          c.beginPath();
          c.arc(pt.x, pt.y, Math.max(0.6, this.size * (1 - i / this.trail.length)), 0, Math.PI * 2);
          c.fillStyle = this.color;
          c.globalAlpha = trailAlpha;
          c.fill();
        }

        // Outer soft glow halo
        c.beginPath();
        c.arc(this.x, this.y, this.size * 2.2, 0, Math.PI * 2);
        c.fillStyle = this.color;
        c.globalAlpha = this.alpha * 0.3;
        c.fill();

        // Bright ember core
        c.beginPath();
        const flicker = this.sparkle ? (0.75 + Math.random() * 0.5) : 1;
        c.arc(this.x, this.y, this.size * flicker, 0, Math.PI * 2);
        c.fillStyle = this.color;
        c.globalAlpha = Math.min(1, this.alpha * flicker);
        c.fill();
      }
    }

    // ── TWINKLING STARBURST PARTICLE ────────────────────────
    class StarParticle {
      constructor(x, y, color) {
        this.x = x;
        this.y = y;
        this.color = color;
        this.angle = Math.random() * Math.PI;
        this.rotationSpeed = (Math.random() - 0.5) * 0.12;
        this.vx = (Math.random() - 0.5) * 2.4;
        this.vy = (Math.random() - 0.5) * 2.4 - 0.5;
        this.size = 3.5 + Math.random() * 4.5;
        this.alpha = 1;
        this.decay = 0.014 + Math.random() * 0.018;
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;
        this.angle += this.rotationSpeed;
        this.alpha -= this.decay;
        return this.alpha > 0;
      }

      draw(c) {
        if (this.alpha <= 0) return;
        c.save();
        c.translate(this.x, this.y);
        c.rotate(this.angle);
        c.globalAlpha = this.alpha;
        c.fillStyle = this.color;

        // Draw 4-point star (✦)
        c.beginPath();
        const s = this.size;
        c.moveTo(0, -s);
        c.quadraticCurveTo(0, 0, s, 0);
        c.quadraticCurveTo(0, 0, 0, s);
        c.quadraticCurveTo(0, 0, -s, 0);
        c.quadraticCurveTo(0, 0, 0, -s);
        c.fill();
        c.restore();
      }
    }

    // ── BURST GENERATORS ────────────────────────────────────
    function createRocketBurst(x, y, paletteName = 'grandDiwali', particleCount = 60) {
      const palette = PALETTES[paletteName] || PALETTES.grandDiwali;

      for (let i = 0; i < particleCount; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 2.5 + Math.random() * 7.5;
        const vx = Math.cos(angle) * speed;
        const vy = Math.sin(angle) * speed;
        const color = palette[Math.floor(Math.random() * palette.length)];

        particles.push(new SparkParticle(x, y, color, vx, vy, {
          gravity: 0.09,
          friction: 0.96,
          size: 2.0 + Math.random() * 2.2,
          decay: 0.011 + Math.random() * 0.015
        }));
      }

      // Add a cluster of twinkling starbursts (✦)
      for (let i = 0; i < 9; i++) {
        const starColor = palette[Math.floor(Math.random() * palette.length)];
        stars.push(new StarParticle(
          x + (Math.random() - 0.5) * 36,
          y + (Math.random() - 0.5) * 36,
          starColor
        ));
      }

      startLoop();
    }

    // Anaar / Flowerpot upward fountain
    function createFountainBurst(x, y, paletteName = 'gold', particleCount = 44) {
      const palette = PALETTES[paletteName] || PALETTES.gold;

      for (let i = 0; i < particleCount; i++) {
        const angle = -Math.PI / 2 + (Math.random() - 0.5) * 0.85; // Upward spray cone
        const speed = 7 + Math.random() * 8.5;
        const vx = Math.cos(angle) * speed;
        const vy = Math.sin(angle) * speed;
        const color = palette[Math.floor(Math.random() * palette.length)];

        particles.push(new SparkParticle(x, y, color, vx, vy, {
          gravity: 0.19,
          friction: 0.97,
          size: 1.8 + Math.random() * 2.4,
          decay: 0.013 + Math.random() * 0.017,
          trailLength: 5
        }));
      }

      startLoop();
    }

    // Grand Double Celebration Burst
    function createDoubleBurst(paletteName = 'grandDiwali') {
      const leftX = width * (0.22 + Math.random() * 0.12);
      const rightX = width * (0.66 + Math.random() * 0.12);
      const burstY = height * (0.26 + Math.random() * 0.16);

      createRocketBurst(leftX, burstY, paletteName, 60);

      setTimeout(() => {
        createRocketBurst(rightX, burstY - 15, paletteName, 60);
      }, 190);
    }

    // ── ANIMATION LOOP (0% CPU WHEN IDLE) ───────────────────
    function animate() {
      if (particles.length === 0 && stars.length === 0) {
        ctx.clearRect(0, 0, width, height);
        isAnimating = false;
        return;
      }

      ctx.clearRect(0, 0, width, height);

      // Render & update sparks
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        if (p.update()) {
          p.draw(ctx);
        } else {
          particles.splice(i, 1);
        }
      }

      // Render & update stars
      for (let i = stars.length - 1; i >= 0; i--) {
        const s = stars[i];
        if (s.update()) {
          s.draw(ctx);
        } else {
          stars.splice(i, 1);
        }
      }

      ctx.globalAlpha = 1;
      requestAnimationFrame(animate);
    }

    function startLoop() {
      if (!isAnimating) {
        isAnimating = true;
        requestAnimationFrame(animate);
      }
    }

    // ── SCROLL TRIGGER LOGIC ─────────────────────────────────
    // Bulletproof section entry tracker with dual IntersectionObserver + Scroll monitoring
    const sectionTargets = [
      { id: 'craft', selector: '#craft, .craft-section', type: 'fountain', palette: 'gold' },
      { id: 'oil-truth', selector: '#oil-truth, #oil-truth-wrap', type: 'single', palette: 'saffronFlame' },
      { id: 'products', selector: '#products, .products', type: 'double', palette: 'grandDiwali' },
      { id: 'hamper', selector: '#hamper, .hamper-section', type: 'double', palette: 'grandDiwali' },
      { id: 'story', selector: '#story, .story-section', type: 'single', palette: 'gold' },
      { id: 'process', selector: '#process, .process-section', type: 'fountain', palette: 'gold' },
      { id: 'reels', selector: '.reel-section', type: 'single', palette: 'saffronFlame' },
      { id: 'reviews', selector: '.reviews-section', type: 'single', palette: 'crimsonGold' },
      { id: 'grahak-dev', selector: '#grahak-dev, .grahak-section', type: 'single', palette: 'gold' },
      { id: 'contact', selector: '#contact, .cta-section', type: 'double', palette: 'grandDiwali' }
    ];

    const lastTriggeredMap = new Map();
    const SECTION_COOLDOWN_MS = 4000; // 4s cooldown per section
    let lastGlobalBurstTime = 0;
    const GLOBAL_MIN_INTERVAL_MS = 650; // Prevent burst overlap during fast scroll

    function triggerSectionFirecrackers(sec) {
      const now = Date.now();
      if (now - lastGlobalBurstTime < GLOBAL_MIN_INTERVAL_MS) return;

      const lastSecTime = lastTriggeredMap.get(sec.id) || 0;
      if (now - lastSecTime < SECTION_COOLDOWN_MS) return;

      lastTriggeredMap.set(sec.id, now);
      lastGlobalBurstTime = now;

      const topY = height * (0.24 + Math.random() * 0.16);

      if (sec.type === 'double') {
        createDoubleBurst(sec.palette);
      } else if (sec.type === 'fountain') {
        createFountainBurst(width * 0.15, height * 0.92, sec.palette, 44);
        setTimeout(() => {
          createFountainBurst(width * 0.85, height * 0.92, sec.palette, 44);
        }, 150);
      } else {
        const targetX = width * (0.35 + Math.random() * 0.3);
        createRocketBurst(targetX, topY, sec.palette, 56);
      }
    }

    // 1. IntersectionObserver with negative rootMargin
    // Triggers when top of section crosses ~25% from bottom of viewport
    let isInitialLoad = true;
    setTimeout(() => {
      isInitialLoad = false;
    }, 800); // Ignore initial intersection before visitor begins scrolling

    const observer = new IntersectionObserver((entries) => {
      if (isInitialLoad) return;

      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const el = entry.target;
        const matched = sectionTargets.find(t => el.matches(t.selector));
        if (matched) {
          triggerSectionFirecrackers(matched);
        }
      });
    }, {
      rootMargin: '0px 0px -25% 0px',
      threshold: 0
    });

    sectionTargets.forEach((sec) => {
      const el = document.querySelector(sec.selector);
      if (el) observer.observe(el);
    });

    // 2. Direct Window Scroll Listener (guarantees triggers on all browsers/devices)
    let scrollTimeout = null;
    let lastScrollY = window.scrollY;

    window.addEventListener('scroll', () => {
      if (isInitialLoad) return;

      const currentScrollY = window.scrollY;
      const isScrollingDown = currentScrollY > lastScrollY;
      lastScrollY = currentScrollY;

      // Throttle check
      if (scrollTimeout) return;
      scrollTimeout = setTimeout(() => {
        scrollTimeout = null;

        const viewportHeight = window.innerHeight;
        const triggerLine = viewportHeight * 0.72; // 72% from top of screen

        for (const sec of sectionTargets) {
          const el = document.querySelector(sec.selector);
          if (!el) continue;

          const rect = el.getBoundingClientRect();
          // When the section header crosses the trigger line
          if (rect.top <= triggerLine && rect.bottom >= viewportHeight * 0.2) {
            triggerSectionFirecrackers(sec);
            break;
          }
        }
      }, 100);
    }, { passive: true });

    // ── PLAYFUL INTERACTIVE CLICK/TAP BURST ──────────────────
    // Clicking anywhere on the page pops a lovely little sparkler burst
    window.addEventListener('pointerdown', (e) => {
      // Don't fire if user clicked on buttons, links, or form elements
      const target = e.target;
      if (
        target.closest('button') ||
        target.closest('a') ||
        target.closest('input') ||
        target.closest('select') ||
        target.closest('textarea') ||
        target.closest('.mobile-menu-btn') ||
        target.closest('#mobile-nav')
      ) {
        return;
      }

      createRocketBurst(e.clientX, e.clientY, 'grandDiwali', 36);
    }, { passive: true });

    // Expose a global method so any component can trigger crackers
    window.fireDiwaliCrackers = (type = 'double', palette = 'grandDiwali') => {
      if (type === 'double') createDoubleBurst(palette);
      else if (type === 'fountain') createFountainBurst(width * 0.5, height * 0.92, palette);
      else createRocketBurst(width * 0.5, height * 0.32, palette);
    };
  })();
</script>
