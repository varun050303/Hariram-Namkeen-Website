---
import siteData from '../data/site.json';
import navData from '../data/navigation.json';
---

<header
  class="sticky top-0 z-50 w-full bg-background-light/95 dark:bg-background-dark/95 backdrop-blur-sm border-b border-[#e7ddcf] dark:border-[#3a2d1e]"
>
  <div class="px-4 md:px-10 py-4 flex items-center justify-between max-w-7xl mx-auto">
    <div class="flex items-center gap-3">
      <div class="size-8 text-primary flex items-center justify-center">
        <span class="material-symbols-outlined !text-[32px]">{siteData.logo}</span>
      </div>
      <h2 class="text-xl md:text-2xl font-bold tracking-tight text-text-main dark:text-white">
        Hariram
      </h2>
    </div>
    
    <!-- Desktop Nav -->
    <nav class="hidden md:flex flex-1 justify-center gap-8">
      {navData.main.map((item) => (
        <a
          class="text-sm font-medium hover:text-primary transition-colors"
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>
    
    <div class="flex items-center gap-4">
      <button
        class="flex items-center gap-2 bg-primary text-[#1b160d] hover:bg-primary/90 transition-colors rounded-xl px-4 py-2 font-bold text-sm"
      >
        <span class="material-symbols-outlined !text-[20px]">shopping_cart</span>
        <span class="hidden sm:inline">Cart (0)</span>
      </button>
    </div>
  </div>
</header>
