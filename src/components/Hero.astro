      </div>

      <!-- Interactive Carousel Controller / Navigation -->
      <div class="hero-carousel-controls">
        <button class="carousel-arrow prev" id="hero-prev" aria-label="Previous slide">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
        </button>

        <div class="carousel-pills" id="hero-pills">
          <button class="c-pill active" data-index="0">🎥 Aloo Bhujia 360°</button>
          <button class="c-pill" data-index="1">🎁 Special 4 (800g)</button>
          <button class="c-pill" data-index="2">🥜 Chana Dal</button>
          <button class="c-pill" data-index="3">🍛 Dal Biji</button>
          <button class="c-pill" data-index="4">🫘 Moongfali</button>
        </div>

        <button class="carousel-arrow next" id="hero-next" aria-label="Next slide">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

    </div>
  </div>

  <a href="#craft" class="hero-scroll-hint" aria-label="Scroll down">
    <span class="hero-scroll-label">Scroll to Explore</span>
    <span class="hero-scroll-arrow">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </span>
  </a>
</section>

<script is:inline>
  // Hero Interactive Carousel Switcher
  (() => {
    const slides = document.querySelectorAll('.hero-slide-pane');
    const pills = document.querySelectorAll('#hero-pills .c-pill');
    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');
    if (!slides.length) return;

    let currentIndex = 0;
    let timer = null;

    function goToSlide(idx) {
      slides[currentIndex].classList.remove('active');
      pills[currentIndex]?.classList.remove('active');

      currentIndex = (idx + slides.length) % slides.length;

      slides[currentIndex].classList.add('active');
      pills[currentIndex]?.classList.add('active');

      // If slide has video, ensure it plays
      const vid = slides[currentIndex].querySelector('video');
      if (vid && vid.paused) {
        vid.play().catch(() => {});
      }
    }

    pills.forEach((pill, i) => {
      pill.addEventListener('click', () => {
        goToSlide(i);
        resetTimer();
      });
    });

    prevBtn?.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
      resetTimer();
    });

    nextBtn?.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
      resetTimer();
    });

    function startTimer() {
      // Auto advance every 6 seconds if user is idle
      timer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 6000);
    }

    function resetTimer() {
      if (timer) clearInterval(timer);
      startTimer();
    }

    startTimer();
  })();
</script>
