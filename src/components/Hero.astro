---
// Hero.astro — Focused Special 4 Box Conversion Hero
// Hariram Namkeen: 4 varieties, 800g, ₹499, free delivery across India, yellow mustard oil.
---

<section class="hero" id="hero">
  <!-- Subtle architectural background ambience -->
  <div class="hero-arch-pattern" aria-hidden="true"></div>
  <div class="hero-radial-glow" aria-hidden="true"></div>

  <div class="hero-inner">
    <!-- Left column: Editorial Value Proposition -->
    <div class="hero-content">
      <!-- 1. H1 Trust Headline + UP Hindi Line -->
      <div class="hero-headline-wrap">
        <h1 class="hero-headline" id="hero-h1">
          Namkeen made in <em class="hl-oil">yellow mustard oil.</em>
        </h1>
        <p class="hero-hindi">पीली सरसों के तेल में बनी नमकीन</p>
      </div>

      <!-- 2. Subline (Concise, no duplicate lines) -->
      <p class="hero-sub" id="hero-sub">
        <strong>Zero palm oil, zero preservatives.</strong>
      </p>

      <!-- 3. Offer block (The Royal Maroon Card with Gold Price) -->
      <div class="hero-box-card" id="hero-offer">
        <div class="hbc-header">
          <div class="hbc-title-wrap">
            <span class="hbc-name">The Special 4 Box</span>
            <span class="hbc-wt">4 varieties · 800g (4 × 200g)</span>
          </div>
          <div class="hbc-price-wrap">
            <span class="hbc-price">₹499</span>
            <span class="hbc-ship">Free Delivery Across India</span>
          </div>
        </div>
        <div class="hbc-menu-row">
          <span class="hbc-menu-label">Includes:</span>
          <span class="hbc-menu-items">
            <strong>Aloo Bhujia</strong> · 
            <strong>Masala Chana Dal</strong> · 
            <strong>Dal Biji</strong> · 
            <strong>Light Malka / Masala Moongfali</strong>
          </span>
        </div>
      </div>

      <!-- 4. One primary button (Gold CTA) -->
      <div class="hero-cta-wrap" id="hero-cta">
        <a 
          href="https://wa.me/916396122920?text=Hi%20Hariram%20Namkeen%2C%20I%20want%20to%20order%20the%20Special%204%20Box%20(800g)%20for%20Rs.499%20with%20Free%20All-India%20Delivery.%20Please%20share%20payment%20and%20delivery%20details." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-hero-order" 
          data-magnetic
        >
          <!-- WhatsApp Icon -->
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          <span>Order the 4-Box, ₹499</span>
        </a>
      </div>

      <!-- 5. Proof row (Fried fresh to order enlarged) -->
      <div class="hero-trust-inline" id="hero-proof">
        <span class="trust-highlight">✦ Fried fresh to order</span>
        <span class="ht-sep">·</span>
        <span>Muzaffarnagar Craft</span>
        <span class="ht-sep">·</span>
        <span>Zero Palm Oil</span>
      </div>
    </div>

    <!-- Right column: ONE static image in a rounded gold-bordered card -->
    <div class="hero-visual" id="hero-visual">
      <div class="hero-image-card">
        <img 
          src="/images/hariram_special_4_top_view.webp" 
          alt="Hariram Special 4 Box - 4 varieties (800g) fried in yellow mustard oil" 
          class="hero-card-img"
          loading="eager"
          fetchpriority="high"
          width="1024"
          height="1024"
        />
      </div>
    </div>
  </div>
</section>
