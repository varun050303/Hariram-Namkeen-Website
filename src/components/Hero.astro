      <!-- Action Buttons -->
      <div class="hh-actions">
        <a href="https://wa.me/916396122920?text=Hi%20Hariram%20Namkeen%2C%20I%20want%20to%20claim%20the%20Special%204%20Box%20(800g)%20for%20Rs.499%20with%20Free%20All-India%20Delivery.%20Please%20share%20order%20details." target="_blank" rel="noopener noreferrer" class="btn-hook-order" data-magnetic>
