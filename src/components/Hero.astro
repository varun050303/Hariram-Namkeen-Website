---
// Hero.astro
// Animation: headline line-by-line reveal, parallax on hero-visual
// All driven by GSAP timeline in animations.js (heroTl)
// Mobile: shows namkeen image as background + namkeen-first messaging
import HeritageBorder from "./HeritageBorder.astro";
import DiwaliDiyas from "./DiwaliDiyas.astro";
import DiwaliPriceDrop from "./DiwaliPriceDrop.astro";
import HeroMobileCarousel from "./HeroMobileCarousel.astro";
---

<section class="hero" id="hero">
  <!-- Festive Swinging Diwali Diyas & Marigold Garlands -->
  <DiwaliDiyas position="both" />

  <div class="hero-content">
    <div class="hero-origin" id="h-origin">
      <span class="hero-origin-dot"></span>
      Muzaffarnagar, UP
    </div>

    <h1 class="hero-headline">
      <span class="split-line"
        ><span class="split-inner" id="hl1">We Make Namkeen In</span></span
      >
      <span class="split-line"
        ><em><span class="split-inner" id="hl2">Yellow Mustard Oil.</span></em
        ></span
      >
    </h1>

    <!-- Mobile-only Interactive Product Carousel (Swipeable with tags & links) -->
    <HeroMobileCarousel />

    <div class="hero-btns" id="h-btns">
      <a href="#hamper" class="hero-btn-primary">
        <span class="btn-desktop-text">Explore Namkeen &rarr;</span>
        <span class="btn-mobile-text">Get Special 4 Box (₹449) &rarr;</span>
      </a>
      <a
        href="https://wa.me/916396122920?text=Hi%2C%20I%20want%20The%20Hariram%20Special%204%20(%E2%82%B9499).%20My%20pincode%20is%20___."
        target="_blank"
        rel="noopener noreferrer"
        class="hero-wa-link"
        id="hero-cta"
        data-wa-click
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
          ></path></svg
        >
        <span>Order on WhatsApp</span>
      </a>
    </div>

    <!-- Editorial Integrated Product Offer (No bordered rectangle, subtle gold divider) -->
    <div class="hero-offer-editorial" id="h-offer-card">
      <div class="hoe-divider" aria-hidden="true">
        <span class="hoe-divider-line"></span>
        <span class="hoe-divider-diamond">
          <svg width="24" height="12" viewBox="0 0 24 12" fill="none">
            <polygon points="12,0 20,6 12,12 4,6" fill="var(--maroon)"
            ></polygon>
            <polygon points="12,2 17,6 12,10 7,6" fill="var(--gold)"></polygon>
            <circle cx="12" cy="6" r="1.5" fill="#FAF5EB"></circle>
          </svg>
        </span>
        <span class="hoe-divider-line"></span>
      </div>
      <div class="hoe-tag">The Hariram 4 &middot; Special Box</div>
      <h2 class="hoe-title">Four favourites. One box.</h2>
      <p class="hoe-snacks">
        Aloo Bhujia &middot; Chana Dal &middot; Dal Biji &middot; Spicy Malka
      </p>
      <div class="hoe-meta-row">
        <div class="hoe-pricing">
          <DiwaliPriceDrop />
          <span class="hoe-shipping">Free delivery across India</span>
        </div>
        <a href="#hamper" class="hoe-link"> Explore the Special Box &rarr; </a>
      </div>
    </div>

    <div class="hero-benefits-line" id="h-trust">
      <span class="hero-jain-tag">🌿 No Onion No Garlic</span>
    </div>
  </div>

  <div class="hero-visual">
    <div class="hero-overlay"></div>
    <div id="hero-parallax">
      <div class="hero-slideshow">
        <img
          src="/images/aloo_bhujia_vertical.webp"
          alt="Aloo Bhujia - Pure Mustard Oil Namkeen"
          class="hero-slide active"
          width="600"
          height="1066"
        />
        <img
          src="/images/hariram_special_4_top_view.webp"
          alt="The Hariram Special 4 Box - Top View"
          class="hero-slide"
          width="1024"
          height="1024"
          loading="lazy"
        />
        <img
          src="/images/masala_chana_dal.webp"
          alt="Crispy Masala Chana Dal"
          class="hero-slide"
          width="700"
          height="1244"
          loading="lazy"
        />
        <img
          src="/images/masala_moongfali.webp"
          alt="Roasted Masala Moongfali"
          class="hero-slide"
          width="800"
          height="597"
          loading="lazy"
        />
        <img
          src="/images/premium.webp"
          alt="Premium Shahi Dal Bhiji"
          class="hero-slide"
          width="900"
          height="600"
          loading="lazy"
        />
      </div>
    </div>
  </div>

  <a href="#craft" class="hero-scroll-hint" aria-label="Scroll down">
    <span class="hero-scroll-label">Scroll</span>
    <span class="hero-scroll-arrow">
      <svg
        width="16"
        height="16"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"></path></svg
      >
    </span>
  </a>

  <!-- Continuous Ethnic Geometric Border Ribbon (Images 2 & 3) -->
  <HeritageBorder
    id="hero-bottom-border"
    class="hero-bottom-border"
    height={30}
  />
</section>

<script is:inline>
  (() => {
    const desktopSlides = document.querySelectorAll(".hero-slide");
    let currentSlide = 0;
    if (desktopSlides.length > 0) {
      setInterval(() => {
        desktopSlides[currentSlide]?.classList.remove("active");
        currentSlide = (currentSlide + 1) % desktopSlides.length;
        desktopSlides[currentSlide]?.classList.add("active");
      }, 4000);
    }
  })();
</script>
