---
// Hero.astro — Cinematic Edge-to-Edge Visual Showcase
// Visual-first: Card-free, full-height visual pane with 360° rotating video & carousel
// Punchy, high-converting offer copy with zero vague fluff
---

<section class="hero" id="hero">
  <!-- Subtle architectural background ambience -->
  <div class="hero-arch-pattern" aria-hidden="true"></div>
  <div class="hero-radial-glow" aria-hidden="true"></div>

  <!-- Left: Open, High-Impact Editorial Copy (Card-Free) -->
  <div class="hero-content">
    <!-- Prestige Heritage Origin Tag -->
    <div class="hero-prestige-tag" id="h-origin">
      <span class="prestige-dot"></span>
      <span class="prestige-text">Fresh From Muzaffarnagar Kadhai</span>
    </div>

    <!-- Direct, Punchy Headline (Focus on Mustard Oil & Crunch) -->
    <h1 class="hero-headline">
      <span class="split-line"><span class="split-inner" id="hl1">Zero Palm Oil.</span></span>
      <span class="split-line"><em class="headline-crimson"><span class="split-inner" id="hl2">Pure Mustard Oil Crunch.</span></em></span>
    </h1>

    <!-- ── THE PRIMARY VALUE HOOK (OPEN & DIRECT) ── -->
    <div class="hero-offer-hook" id="h-hook">
      <div class="hero-hook-badge">
        <span class="hook-dot"></span>
        <span class="hook-badge-text">Launch Special · Free Express Delivery Across India</span>
      </div>

      <div class="hero-offer-main">
        <div class="offer-lead">The Hariram Special 4 Box</div>
        <div class="offer-price-row">
          <span class="offer-price">₹499</span>
          <span class="offer-weight">for 800g (4 × 200g Fresh Packs)</span>
          <span class="offer-ship">Free Shipping</span>
        </div>
      </div>

      <p class="hero-offer-sub" id="h-sub">
        4 signature snacks — Aloo Bhujia, Masala Chana Dal, Dal Biji &amp; Masala Moongfali — slow-cooked in cold-pressed Kachi Ghani mustard oil with home-ground spices. No chemical preservatives, no warehouse stock. Handcrafted in Muzaffarnagar and delivered fresh to your door.
      </p>

      <div class="hero-cta-group" id="h-btns">
        <a 
          href="https://wa.me/916396122920?text=Hi%20Hariram%20Namkeen%2C%20I%20want%20to%20order%20the%20Special%204%20Box%20(800g)%20for%20Rs.499%20with%20Free%20All-India%20Delivery.%20Please%20share%20payment%20and%20delivery%20details." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-hero-cta" 
          data-magnetic
        >
          <span>Claim Special 4 Box @ ₹499 (Free Delivery)</span>
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#products" class="btn-hero-sec">View All 5 Snacks ↓</a>
      </div>

      <div class="hero-trust-row" id="h-trust">
        <span class="ht-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="20 6 9 17 4 12"/></svg>
          100% Kachi Ghani Oil
        </span>
        <span class="ht-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="20 6 9 17 4 12"/></svg>
          Zero Delivery Fees
        </span>
        <span class="ht-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="20 6 9 17 4 12"/></svg>
          FSSAI Certified
        </span>
      </div>
    </div>
  </div>

  <!-- ── HERO RIGHT: EDGE-TO-EDGE CINEMATIC VISUAL SHOWCASE (CARD-FREE) ── -->
  <div class="hero-visual" id="hero-visual-pane">
    <!-- Feathering gradient blend that seamlessly merges the visual into the left column -->
    <div class="hero-visual-blend" aria-hidden="true"></div>
    <div class="hero-visual-vignette" aria-hidden="true"></div>

    <!-- Parallax Slide Container (Full Bleed) -->
    <div id="hero-parallax" class="hero-parallax-wrap">
      <div class="hero-slideshow">

        <!-- Slide 0: Aloo Bhujia 360° Infinite Video -->
        <div class="hero-visual-slide active" data-slide="0">
          <video 
            src="/videos/aloo_bhujia_rotating_shoot.mp4" 
            autoplay 
            loop 
            muted 
            playsinline 
            preload="auto"
            class="hero-media-element"
            aria-label="360° studio rotation of fresh Hariram Aloo Bhujia"
          ></video>
        </div>

        <!-- Slide 1: Hariram Special 4 Box Tasting Platter -->
        <div class="hero-visual-slide" data-slide="1">
          <img 
            src="/images/hariram_special_4_top_view.png" 
            alt="The Hariram Special 4 Tasting Platter (800g)" 
            class="hero-media-element"
            loading="eager"
          />
        </div>

        <!-- Slide 2: Masala Chana Dal -->
        <div class="hero-visual-slide" data-slide="2">
          <img 
            src="/images/masala_chana_dal.png" 
            alt="Masala Chana Dal Studio Shoot" 
            class="hero-media-element"
            loading="lazy" 
          />
        </div>

        <!-- Slide 3: Traditional Dal Biji -->
        <div class="hero-visual-slide" data-slide="3">
          <img 
            src="/images/dal-bhiji.jpg" 
            alt="Traditional Dal Biji with Moong Dal" 
            class="hero-media-element"
            loading="lazy" 
          />
        </div>

        <!-- Slide 4: Masala Moongfali -->
        <div class="hero-visual-slide" data-slide="4">
          <img 
            src="/images/masala_moongfali.png" 
            alt="Masala Moongfali Roasted Peanuts" 
            class="hero-media-element"
            loading="lazy" 
          />
        </div>

      </div>
    </div>

    <!-- Floating Live Studio Badge (No Card, Frosted Glass) -->
    <div class="hero-floating-studio-badge">
      <span class="live-pulse-dot"></span>
      <span class="badge-text">360° Studio View · Pure Mustard Oil</span>
    </div>

    <!-- Sleek Floating Carousel Controller -->
    <div class="hero-visual-controls">
      <button class="hero-ctrl-arrow prev" id="hero-prev" aria-label="Previous slide">
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
      </button>

      <div class="hero-ctrl-pills" id="hero-pills">
        <button class="h-pill active" data-index="0">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>
          360° Video
        </button>
        <button class="h-pill" data-index="1">Special 4 Box</button>
        <button class="h-pill" data-index="2">Chana Dal</button>
        <button class="h-pill" data-index="3">Dal Biji</button>
        <button class="h-pill" data-index="4">Moongfali</button>
      </div>

      <button class="hero-ctrl-arrow next" id="hero-next" aria-label="Next slide">
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <!-- Ambient Glow Layer -->
    <div class="hero-visual-ambient-glow" aria-hidden="true"></div>
  </div>

  <!-- Scroll Down Cue -->
  <a href="#craft" class="hero-scroll-cue" aria-label="Scroll down to explore">
    <span class="cue-label">Explore The Craft</span>
    <span class="cue-arrow">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </span>
  </a>
</section>

<script is:inline>
  // Hero Visual Slideshow & Video Controller
  (() => {
    const slides = document.querySelectorAll('.hero-visual-slide');
    const pills = document.querySelectorAll('#hero-pills .h-pill');
    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');
    if (!slides.length) return;

    let current = 0;
    let timer = null;

    function showSlide(idx) {
      slides[current]?.classList.remove('active');
      pills[current]?.classList.remove('active');

      current = (idx + slides.length) % slides.length;

      slides[current]?.classList.add('active');
      pills[current]?.classList.add('active');

      // Video playback assurance
      const vid = slides[current]?.querySelector('video');
      if (vid && vid.paused) {
        vid.play().catch(() => {});
      }
    }

    pills.forEach((p, i) => {
      p.addEventListener('click', () => {
        showSlide(i);
        restartTimer();
      });
    });

    prevBtn?.addEventListener('click', () => {
      showSlide(current - 1);
      restartTimer();
    });

    nextBtn?.addEventListener('click', () => {
      showSlide(current + 1);
      restartTimer();
    });

    function startTimer() {
      timer = setInterval(() => {
        showSlide(current + 1);
      }, 6500);
    }

    function restartTimer() {
      if (timer) clearInterval(timer);
      startTimer();
    }

    startTimer();
  })();
</script>
