---
// Hero.astro — Professional Gourmet Luxury Edition
// 1. Authoritative bold typography (Playfair Display 800 + Plus Jakarta Sans)
// 2. Infinite-playing Aloo Bhujia 360° rotating video in arch-framed royal pedestal
// 3. High-converting Royal Certificate Hook Card for ₹499 (800g, ₹0 delivery, zero hidden charges)
// 4. Zero plain emojis — replaced with bespoke fine-line SVG vector icons
// 5. Unique, non-repetitive product photography in carousel switcher
---

<section class="hero" id="hero">
  <!-- Architectural background atmosphere -->
  <div class="hero-arch-pattern" aria-hidden="true"></div>
  <div class="hero-radial-glow" aria-hidden="true"></div>

  <div class="hero-content">
    <!-- Prestige Location & Heritage Tag -->
    <div class="hero-prestige-tag" id="h-origin">
      <span class="prestige-dot"></span>
      <span class="prestige-text">Muzaffarnagar, UP · Authentic Heritage Kadhai</span>
    </div>

    <!-- Bold, High-Contrast Main Headline -->
    <h1 class="hero-headline">
      <span class="split-line"><span class="split-inner" id="hl1">Authentic UP Namkeen.</span></span>
      <span class="split-line"><em class="headline-crimson"><span class="split-inner" id="hl2">Pure Mustard Oil.</span></em></span>
      <span class="split-line"><span class="headline-gold"><span class="split-inner" id="hl3">Zero Shortcuts.</span></span></span>
    </h1>

    <p class="hero-sub" id="h-sub">
      Slow-cooked in cold-pressed <strong>Kachi Ghani mustard oil</strong> with fresh stone-ground spices from our own kitchen. Zero palm oil. Zero chemical preservatives. Made fresh every week.
    </p>

    <!-- ── THE ₹499 ROYAL CERTIFICATE HOOK CARD ──────────────────── -->
    <div class="hero-certificate-card" id="h-hook">
      <div class="cert-corner tl">✦</div>
      <div class="cert-corner tr">✦</div>
      <div class="cert-corner bl">✦</div>
      <div class="cert-corner br">✦</div>

      <!-- Top Hook Badges -->
      <div class="cert-badge-row">
        <span class="cert-pill-launch">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Direct Kitchen Launch Offer
        </span>
        <span class="cert-pill-shipping">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><circle cx="7" cy="18" r="2"/><path d="M15 18H9"/><circle cx="17" cy="18" r="2"/><path d="M17 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 15.52 8H14v10Z"/></svg>
          Free All-India Express Delivery
        </span>
      </div>

      <!-- Main Price & Weight Showcase -->
      <div class="cert-showcase">
        <div class="cert-price-col">
          <div class="cert-box-title">The Hariram Special 4 Box</div>
          <div class="cert-price-wrap">
            <span class="cert-curr">₹</span>
            <span class="cert-val">499</span>
            <span class="cert-tax-note">All-Inclusive (No Added GST)</span>
          </div>
        </div>

        <div class="cert-weight-badge">
          <div class="cert-weight-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
          </div>
          <div class="cert-weight-text">
            <strong>TOTAL 800g</strong>
            <span>4 × 200g Fresh Packs</span>
          </div>
        </div>
      </div>

      <!-- 4 Value Guarantee Pillars -->
      <div class="cert-pillars-grid">
        <div class="cert-pillar">
          <div class="cert-p-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="cert-p-body">
            <strong>No Delivery Fees</strong>
            <span>₹0 shipping to any Indian pin code</span>
          </div>
        </div>

        <div class="cert-pillar">
          <div class="cert-p-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="cert-p-body">
            <strong>Zero Hidden Charges</strong>
            <span>No handling or surprise checkout costs</span>
          </div>
        </div>

        <div class="cert-pillar">
          <div class="cert-p-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="cert-p-body">
            <strong>Pure Product Value</strong>
            <span>Just ~₹62 / 100g delivered to your door</span>
          </div>
        </div>

        <div class="cert-pillar">
          <div class="cert-p-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="cert-p-body">
            <strong>4 Fresh 200g Packs</strong>
            <span>Aloo Bhujia · Chana Dal · Dal Biji · Moongfali</span>
          </div>
        </div>
      </div>

      <!-- High-Impact Action CTAs -->
      <div class="cert-action-bar">
        <a 
          href="https://wa.me/916396122920?text=Hi%20Hariram%20Namkeen%2C%20I%20want%20to%20order%20the%20Special%204%20Box%20(800g)%20for%20Rs.499%20with%20Free%20All-India%20Delivery.%20Please%20share%20payment%20and%20delivery%20details." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-cert-primary" 
          data-magnetic
        >
          <span>Claim Special 4 Box @ ₹499 (Free Delivery)</span>
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#products" class="btn-cert-secondary">Explore Products</a>
      </div>
    </div>
  </div>

  <!-- ── HERO RIGHT: ARCH-FRAMED 360° VIDEO & INTERACTIVE SWITCHER ── -->
  <div class="hero-visual-col">
    <div class="hero-arch-card" id="hero-media-card">

      <!-- Viewport Frame -->
      <div class="hero-arch-viewport">

        <!-- Slide 0: Aloo Bhujia 360° Rotating Studio Video (Active on load) -->
        <div class="arch-slide-pane active" data-slide="0">
          <video 
            src="/videos/aloo_bhujia_rotating_shoot.mp4" 
            autoplay 
            loop 
            muted 
            playsinline 
            preload="auto"
            class="arch-video"
            aria-label="360° studio rotation of fresh Hariram Aloo Bhujia"
          ></video>
          <div class="arch-vignette"></div>

          <!-- Studio Live Indicator -->
          <div class="arch-meta-chip chip-top-left">
            <span class="meta-pulse-dot"></span>
            <span>360° Rotating Shoot</span>
          </div>

          <!-- Ingredient Callouts (Vector Icons) -->
          <div class="arch-feature-chip chip-top-right">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span>Fresh Potato Flakes &amp; Besan</span>
          </div>

          <div class="arch-feature-chip chip-bottom-left">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            <span>Pure Kachi Ghani Mustard Oil</span>
          </div>
        </div>

        <!-- Slide 1: Masala Chana Dal -->
        <div class="arch-slide-pane" data-slide="1">
          <img src="/images/masala_chana_dal.png" alt="Masala Chana Dal Studio Shoot" loading="lazy" />
          <div class="arch-vignette"></div>
          <div class="arch-meta-chip chip-top-left">
            <span>Masala Chana Dal · 200g</span>
          </div>
          <div class="arch-feature-chip chip-top-right">
            <span>High Protein · Stone-Ground Amchur</span>
          </div>
        </div>

        <!-- Slide 2: Traditional Dal Biji -->
        <div class="arch-slide-pane" data-slide="2">
          <img src="/images/dal-bhiji.jpg" alt="Traditional Moong Dal Dal Biji" loading="lazy" />
          <div class="arch-vignette"></div>
          <div class="arch-meta-chip chip-top-left">
            <span>Dal Biji · Muzaffarnagar Classic</span>
          </div>
          <div class="arch-feature-chip chip-top-right">
            <span>Moong Dal &amp; Heritage Spices</span>
          </div>
        </div>

        <!-- Slide 3: Masala Moongfali -->
        <div class="arch-slide-pane" data-slide="3">
          <img src="/images/masala_moongfali.png" alt="Masala Moongfali Peanuts" loading="lazy" />
          <div class="arch-vignette"></div>
          <div class="arch-meta-chip chip-top-left">
            <span>Masala Moongfali · 200g</span>
          </div>
          <div class="arch-feature-chip chip-top-right">
            <span>Kashmiri Chilli &amp; Roasted Peanuts</span>
          </div>
        </div>

        <!-- Slide 4: Special 4 Platter Preview -->
        <div class="arch-slide-pane" data-slide="4">
          <img src="/images/hariram_special_4_top_view.png" alt="Hariram Special 4 Platter Top View" loading="lazy" />
          <div class="arch-vignette"></div>
          <div class="arch-meta-chip chip-top-left">
            <span>The Special 4 Tasting Platter</span>
          </div>
          <div class="arch-feature-chip chip-top-right">
            <span>₹499 All-Inclusive · Free Shipping</span>
          </div>
        </div>

      </div>

      <!-- Professional Carousel Controller -->
      <div class="hero-arch-controls">
        <button class="arch-nav-arrow prev" id="hero-prev" aria-label="Previous product">
          <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
        </button>

        <div class="arch-pills-bar" id="hero-pills">
          <button class="arch-pill active" data-index="0">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
            Aloo Bhujia 360°
          </button>
          <button class="arch-pill" data-index="1">Chana Dal</button>
          <button class="arch-pill" data-index="2">Dal Biji</button>
          <button class="arch-pill" data-index="3">Moongfali</button>
          <button class="arch-pill" data-index="4">Special 4 Box</button>
        </div>

        <button class="arch-nav-arrow next" id="hero-next" aria-label="Next product">
          <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Scroll Down Hint -->
  <a href="#craft" class="hero-scroll-cue" aria-label="Scroll down to explore">
    <span class="cue-label">Explore The Craft</span>
    <span class="cue-arrow">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </span>
  </a>
</section>

<script is:inline>
  // Hero Arch Carousel Controller
  (() => {
    const panes = document.querySelectorAll('.arch-slide-pane');
    const pills = document.querySelectorAll('#hero-pills .arch-pill');
    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');
    if (!panes.length) return;

    let current = 0;
    let timer = null;

    function showSlide(idx) {
      panes[current].classList.remove('active');
      pills[current]?.classList.remove('active');

      current = (idx + panes.length) % panes.length;

      panes[current].classList.add('active');
      pills[current]?.classList.add('active');

      // Video play state
      const vid = panes[current].querySelector('video');
      if (vid && vid.paused) {
        vid.play().catch(() => {});
      }
    }

    pills.forEach((p, i) => {
      p.addEventListener('click', () => {
        showSlide(i);
        restartTimer();
      });
    });

    prevBtn?.addEventListener('click', () => {
      showSlide(current - 1);
      restartTimer();
    });

    nextBtn?.addEventListener('click', () => {
      showSlide(current + 1);
      restartTimer();
    });

    function startTimer() {
      timer = setInterval(() => {
        showSlide(current + 1);
      }, 6500);
    }

    function restartTimer() {
      if (timer) clearInterval(timer);
      startTimer();
    }

    startTimer();
  })();
</script>
