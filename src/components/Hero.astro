---
// Hero.astro — Cinematic Edge-to-Edge Visual Showcase
// Visual-first: Card-free, full-height visual pane with 360° rotating video & carousel
// Balanced typography with cloudy frosted visual divider
---

<section class="hero" id="hero">
  <!-- Subtle architectural background ambience -->
  <div class="hero-arch-pattern" aria-hidden="true"></div>
  <div class="hero-radial-glow" aria-hidden="true"></div>

  <!-- Left: Open, Elegant Editorial Copy (Card-Free) -->
  <div class="hero-content">
    <!-- Heritage Origin Tag -->
    <div class="hero-prestige-tag" id="h-origin">
      <span class="prestige-dot"></span>
      <span class="prestige-text">Muzaffarnagar, Uttar Pradesh</span>
    </div>

    <!-- Refined, Balanced Headline (Not unnecessarily large) -->
    <h1 class="hero-headline">
      <span class="split-line"><span class="split-inner" id="hl1">Made in Pure Yellow Mustard Oil.</span></span>
      <span class="split-line"><em class="headline-crimson"><span class="split-inner" id="hl2">The Authentic UP Namkeen.</span></em></span>
    </h1>

    <p class="hero-sub" id="h-sub">
      Slow-cooked in small batches with cold-pressed Kachi Ghani mustard oil and stone-ground spices. Zero palm oil. Zero preservatives.
    </p>

    <!-- ── THE HARIRAM SPECIAL 4 BOX HOOK (UNIFIED VALUE CALLOUT) ── -->
    <div class="hero-offer-hook" id="h-hook">
      <div class="hero-box-card">
        <div class="hbc-header">
          <div class="hbc-title-wrap">
            <span class="hbc-name">The Hariram Special 4 Box</span>
            <span class="hbc-wt">800g Total (4 × 200g Fresh Packs)</span>
          </div>
          <div class="hbc-price-wrap">
            <span class="hbc-price">₹499</span>
            <span class="hbc-ship">Free Delivery Included</span>
          </div>
        </div>

        <div class="hbc-menu-row">
          <span class="hbc-menu-label">Includes:</span>
          <span class="hbc-menu-items">
            <strong>Aloo Bhujia</strong> · 
            <strong>Masala Chana Dal</strong> · 
            <strong>Dal Biji</strong> · 
            <strong>Light Malka / Moongfali</strong>
          </span>
        </div>
      </div>

      <!-- ONE CLEAR ACTION: Single Primary Button + Subtle Text Link -->
      <div class="hero-action-group" id="h-btns">
        <a 
          href="https://wa.me/916396122920?text=Hi%20Hariram%20Namkeen%2C%20I%20want%20to%20order%20the%20Special%204%20Box%20(800g)%20for%20Rs.499%20with%20Free%20All-India%20Delivery.%20Please%20share%20payment%20and%20delivery%20details." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-hero-order" 
          data-magnetic
        >
          <!-- WhatsApp Icon -->
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          <span>Order Special 4 Box @ ₹499</span>
        </a>
        <a href="#products" class="hero-link-explore">
          <span>Explore all snacks</span>
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Clean Trust Note (Whisper, not chunky chips) -->
      <div class="hero-trust-inline" id="h-trust">
        <span>✓ 100% Mustard Oil</span>
        <span class="ht-sep">·</span>
        <span>✓ Zero Palm Oil</span>
        <span class="ht-sep">·</span>
        <span>✓ FSSAI Certified</span>
      </div>
    </div>
  </div>

  <!-- ── HERO RIGHT: EDGE-TO-EDGE CINEMATIC VISUAL WITH CLOUDY FROSTED BLEND ── -->
  <div class="hero-visual" id="hero-visual-pane">
    <!-- Cloudy / Frosted Glass Mist Divider that seamlessly melts into the cream background -->
    <div class="hero-visual-frost" aria-hidden="true"></div>

    <!-- Parallax Slide Container (Full Bleed) -->
    <div id="hero-parallax" class="hero-parallax-wrap">
      <div class="hero-slideshow">

        <!-- Slide 0: Aloo Bhujia 360° Infinite Video (Smooth, Flicker-Free) -->
        <div class="hero-visual-slide active" data-slide="0">
          <video 
            src="/videos/aloo_bhujia_rotating_shoot.mp4" 
            autoplay 
            loop 
            muted 
            playsinline 
            preload="auto"
            class="hero-media-element hero-video-el"
            aria-label="360° studio rotation of fresh Hariram Aloo Bhujia"
          ></video>
        </div>

        <!-- Slide 1: Hariram Special 4 Box Tasting Platter -->
        <div class="hero-visual-slide" data-slide="1">
          <img 
            src="/images/hariram_special_4_top_view.png" 
            alt="The Hariram Special 4 Tasting Platter (800g)" 
            class="hero-media-element"
            loading="eager"
          />
        </div>

        <!-- Slide 2: Masala Chana Dal -->
        <div class="hero-visual-slide" data-slide="2">
          <img 
            src="/images/masala_chana_dal.png" 
            alt="Masala Chana Dal Studio Shoot" 
            class="hero-media-element"
            loading="lazy" 
          />
        </div>

        <!-- Slide 3: Traditional Dal Biji -->
        <div class="hero-visual-slide" data-slide="3">
          <img 
            src="/images/premium.jpg" 
            alt="Traditional Dal Biji with Moong Dal" 
            class="hero-media-element"
            loading="lazy" 
          />
        </div>

        <!-- Slide 4: Masala Moongfali -->
        <div class="hero-visual-slide" data-slide="4">
          <img 
            src="/images/masala_moongfali.png" 
            alt="Masala Moongfali Roasted Peanuts" 
            class="hero-media-element"
            loading="lazy" 
          />
        </div>

      </div>
    </div>

    <!-- Floating Live Studio Badge (Frosted Glass) -->
    <div class="hero-floating-studio-badge">
      <span class="live-pulse-dot"></span>
      <span class="badge-text">360° Studio View · Pure Yellow Mustard Oil</span>
    </div>

    <!-- Sleek Floating Carousel Controller -->
    <div class="hero-visual-controls">
      <button class="hero-ctrl-arrow prev" id="hero-prev" aria-label="Previous slide">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
      </button>

      <div class="hero-ctrl-pills" id="hero-pills">
        <button class="h-pill active" data-index="0">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>
          360° Video
        </button>
        <button class="h-pill" data-index="1">Special 4 Box</button>
        <button class="h-pill" data-index="2">Chana Dal</button>
        <button class="h-pill" data-index="3">Dal Biji</button>
        <button class="h-pill" data-index="4">Moongfali</button>
      </div>

      <button class="hero-ctrl-arrow next" id="hero-next" aria-label="Next slide">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>

  <!-- Scroll Down Cue -->
  <a href="#craft" class="hero-scroll-cue" aria-label="Scroll down to explore">
    <span class="cue-label">Scroll to Explore</span>
    <span class="cue-arrow">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </span>
  </a>
</section>

<script is:inline>
  // Hero Visual Slideshow & Video Controller (Flicker-free)
  (() => {
    const slides = document.querySelectorAll('.hero-visual-slide');
    const pills = document.querySelectorAll('#hero-pills .h-pill');
    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');
    if (!slides.length) return;

    let current = 0;
    let timer = null;

    // Ensure video is playing and unmuted
    const firstVid = slides[0]?.querySelector('video');
    if (firstVid) {
      firstVid.muted = true;
      firstVid.play().catch(() => {});
    }

    function showSlide(idx) {
      slides[current]?.classList.remove('active');
      pills[current]?.classList.remove('active');

      current = (idx + slides.length) % slides.length;

      slides[current]?.classList.add('active');
      pills[current]?.classList.add('active');

      const vid = slides[current]?.querySelector('video');
      if (vid && vid.paused) {
        vid.muted = true;
        vid.play().catch(() => {});
      }
    }

    pills.forEach((p, i) => {
      p.addEventListener('click', () => {
        showSlide(i);
        restartTimer();
      });
    });

    prevBtn?.addEventListener('click', () => {
      showSlide(current - 1);
      restartTimer();
    });

    nextBtn?.addEventListener('click', () => {
      showSlide(current + 1);
      restartTimer();
    });

    function startTimer() {
      timer = setInterval(() => {
        showSlide(current + 1);
      }, 7000);
    }

    function restartTimer() {
      if (timer) clearInterval(timer);
      startTimer();
    }

    startTimer();
  })();
</script>
