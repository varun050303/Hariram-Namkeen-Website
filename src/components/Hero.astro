          <div class="hero-live-badge">
            <span>🥜 Masala Chana Dal · 200g</span>
          </div>
          <div class="hero-floating-badge badge-top-right">
            <span>Hand-Ground Amchur &amp; Chaat Masala</span>
          </div>
        </div>

        <!-- Slide 4: Dal Biji -->
        <div class="hero-slide-pane" data-slide="3">
          <img src="/images/dal-bhiji.jpg" alt="Traditional Dal Biji" loading="lazy" />
          <div class="hero-media-overlay"></div>
          <div class="hero-live-badge">
            <span>🍛 Dal Biji · Heritage Muzaffarnagar</span>
          </div>
        </div>

        <!-- Slide 5: Masala Moongfali -->
        <div class="hero-slide-pane" data-slide="4">
          <img src="/images/masala_moongfali.png" alt="Masala Moongfali Peanuts" loading="lazy" />
          <div class="hero-media-overlay"></div>
