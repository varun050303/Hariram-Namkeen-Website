          <div class="hero-media-overlay"></div>
          <div class="hero-live-badge">
            <span>👑 4 Flavours · 800g Royal Platter</span>
          </div>
          <div class="hero-floating-badge badge-top-right">
            <span>₹499 Free All-India Delivery</span>
          </div>
        </div>

        <!-- Slide 3: Masala Chana Dal -->
        <div class="hero-slide-pane" data-slide="2">
          <img src="/images/masala_chana_dal.png" alt="Masala Chana Dal" loading="lazy" />
