---
// Hero.astro
// Animation: headline line-by-line reveal, parallax on hero-visual
// All driven by GSAP timeline in animations.js (heroTl)
// Mobile: shows namkeen image as background + namkeen-first messaging
import HeritageBorder from "./HeritageBorder.astro";
import DiwaliDiyas from "./DiwaliDiyas.astro";
import HeroMobileCarousel from "./HeroMobileCarousel.astro";
---

<section class="hero" id="hero">
  <!-- Festive Swinging Diwali Diyas & Marigold Garlands -->
  <DiwaliDiyas position="both" />

  <div class="hero-content">
    <div class="hero-origin" id="h-origin">
      <span class="hero-origin-dot"></span>
      Muzaffarnagar, UP
    </div>

    <!-- One headline: “Namkeen made in yellow mustard oil.” with Apple "hello" write-on motion on "Namkeen" & "mustard" -->
    <h1 class="hero-headline" id="hero-headline">
      <span class="split-line">
        <span class="split-inner" id="hl1">
          <span class="apple-hello-wrap apple-hello-namkeen" id="word-namkeen">
            <span class="apple-hello-text">Namkeen</span>
            <svg
              class="apple-hello-flourish"
              viewBox="0 0 160 22"
              fill="none"
              aria-hidden="true"
            >
              <path
                class="apple-flourish-path"
                pathLength="1"
                d="M 4 8 C 45 3, 115 4, 148 9 C 158 11, 159 15, 146 17 C 110 20, 55 18, 18 15"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
          <span class="hl-plain">made in yellow</span>
          <span class="apple-hello-wrap apple-hello-mustard" id="word-mustard">
            <span class="apple-hello-text">mustard</span>
            <svg
              class="apple-hello-flourish"
              viewBox="0 0 135 22"
              fill="none"
              aria-hidden="true"
            >
              <path
                class="apple-flourish-path"
                pathLength="1"
                d="M 4 8 C 38 3, 98 4, 124 9 C 134 11, 135 15, 123 17 C 92 20, 45 18, 14 15"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
          <span class="hl-plain">oil.</span>
        </span>
      </span>
    </h1>

    <!-- Value Bridge Strip: Kills shipping + pricing objections before the CTA -->
    <p class="hero-value-bridge" id="h-sub">
      <span class="hvb-hook">🚚 First order? <strong>Delivery is on us</strong></span>
      <span class="hvb-dot">&middot;</span>
      <span class="hvb-hook">Bestsellers from <strong>₹400</strong></span>
    </p>

    <!-- Mobile-only Interactive Product Carousel (Swipeable with tags & links) -->
    <HeroMobileCarousel />

    <!-- Single Clear Call to Action with Trust & Inside Links -->
    <div class="hero-actions-row" id="h-btns">
      <a
        href="https://wa.me/916396122920?text=Hi%2C%20I%20want%20to%20order%20Hariram%20Namkeen.%20My%20pincode%20is%20___."
        target="_blank"
        rel="noopener noreferrer"
        class="hero-btn-primary-wa"
        id="hero-cta"
        data-wa-click
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
          ></path>
        </svg>
        <span>Order on WhatsApp</span>
      </a>

      <a href="#hamper" class="hero-link-secondary">
        <span>Explore Flavours &amp; Tasting Box &rarr;</span>
      </a>

      <a
        href="https://wa.me/916396122920?text=Hi%2C%20I%27m%20interested%20in%20bulk%20or%20custom%20orders%20for%20events%2Fgifting.%20Please%20share%20details."
        target="_blank"
        rel="noopener noreferrer"
        class="hero-link-secondary hero-link-bulk"
      >
        <span>Events &amp; Gifting &middot; Bulk Orders &rarr;</span>
      </a>
    </div>

    <div class="hero-benefits-line" id="h-trust">
      <span class="hero-jain-tag">🌿 Strictly No Onion No Garlic</span>
      <span class="hero-jain-tag">🚫 Zero Palm Oil</span>
      <span class="hero-jain-tag">✦ 100% Pure Mustard Oil</span>
    </div>
  </div>

  <div class="hero-visual">
    <div class="hero-overlay"></div>
    <div id="hero-parallax">
      <div class="hero-slideshow">
        <img
          src="/images/aloo_bhujia_vertical.webp"
          alt="Aloo Bhujia - Pure Mustard Oil Namkeen"
          class="hero-slide active"
          width="600"
          height="1066"
        />
        <img
          src="/images/hariram_special_4_top_view.webp"
          alt="The Hariram Special 4 Box - Top View"
          class="hero-slide"
          width="1024"
          height="1024"
          loading="lazy"
        />
        <img
          src="/images/masala_chana_dal.webp"
          alt="Crispy Masala Chana Dal"
          class="hero-slide"
          width="700"
          height="1244"
          loading="lazy"
        />
        <img
          src="/images/masala_moongfali.webp"
          alt="Roasted Masala Moongfali"
          class="hero-slide"
          width="800"
          height="597"
          loading="lazy"
        />
        <img
          src="/images/premium.webp"
          alt="Premium Shahi Dal Bhiji"
          class="hero-slide"
          width="900"
          height="600"
          loading="lazy"
        />
      </div>
    </div>
  </div>

  <a href="#craft" class="hero-scroll-hint" aria-label="Scroll down">
    <span class="hero-scroll-label">Scroll</span>
    <span class="hero-scroll-arrow">
      <svg
        width="16"
        height="16"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"></path></svg
      >
    </span>
  </a>

  <!-- Continuous Ethnic Geometric Border Ribbon (Images 2 & 3) -->
  <HeritageBorder
    id="hero-bottom-border"
    class="hero-bottom-border"
    height={30}
  />
</section>

<script is:inline>
  (() => {
    const desktopSlides = document.querySelectorAll(".hero-slide");
    let currentSlide = 0;
    if (desktopSlides.length > 0) {
      setInterval(() => {
        desktopSlides[currentSlide]?.classList.remove("active");
        currentSlide = (currentSlide + 1) % desktopSlides.length;
        desktopSlides[currentSlide]?.classList.add("active");
      }, 4000);
    }

    // Buttery-smooth Apple "hello" write-on motion sequence
    function initAppleHelloWriteOn() {
      const namkeenWrap = document.getElementById("word-namkeen");
      const mustardWrap = document.getElementById("word-mustard");
      const namkeenText = namkeenWrap?.querySelector(".apple-hello-text");
      const namkeenFlourish = namkeenWrap?.querySelector(
        ".apple-flourish-path",
      );
      const mustardText = mustardWrap?.querySelector(".apple-hello-text");
      const mustardFlourish = mustardWrap?.querySelector(
        ".apple-flourish-path",
      );

      if (!namkeenText || !mustardText) return;

      // Reset flourish paths with normalized pathLength="1"
      if (namkeenFlourish) {
        namkeenFlourish.setAttribute("pathLength", "1");
        namkeenFlourish.style.strokeDasharray = "1";
        namkeenFlourish.style.strokeDashoffset = "1";
      }
      if (mustardFlourish) {
        mustardFlourish.setAttribute("pathLength", "1");
        mustardFlourish.style.strokeDasharray = "1";
        mustardFlourish.style.strokeDashoffset = "1";
      }

      // Initial state: feathered ink mask hiding text
      namkeenText.style.webkitMaskImage =
        "linear-gradient(to right, black 0%, transparent 14%)";
      namkeenText.style.maskImage =
        "linear-gradient(to right, black 0%, transparent 14%)";
      mustardText.style.webkitMaskImage =
        "linear-gradient(to right, black 0%, transparent 14%)";
      mustardText.style.maskImage =
        "linear-gradient(to right, black 0%, transparent 14%)";

      let introDone = false;

      function setupInteractiveHover(wrap, textEl) {
        if (!wrap || !textEl) return;

        const triggerShimmer = () => {
          if (!introDone && window.gsap) return;
          if (textEl.classList.contains("is-shimmering")) return;
          textEl.classList.add("is-shimmering");
        };

        wrap.addEventListener("mouseenter", triggerShimmer);
        wrap.addEventListener("pointerdown", triggerShimmer);

        textEl.addEventListener("animationend", (e) => {
          if (e.animationName === "appleSmoothShimmer") {
            textEl.classList.remove("is-shimmering");
          }
        });
      }

      setupInteractiveHover(namkeenWrap, namkeenText);
      setupInteractiveHover(mustardWrap, mustardText);

      const runWithGsap = () => {
        const gsap = window.gsap;
        if (!gsap) {
          namkeenText.style.webkitMaskImage = "none";
          namkeenText.style.maskImage = "none";
          mustardText.style.webkitMaskImage = "none";
          mustardText.style.maskImage = "none";
          if (namkeenFlourish) namkeenFlourish.style.strokeDashoffset = "0";
          if (mustardFlourish) mustardFlourish.style.strokeDashoffset = "0";
          introDone = true;
          return;
        }

        const tl = gsap.timeline({
          delay: 0.35,
          onComplete: () => {
            introDone = true;
          },
        });

        // 1. "Namkeen" ink write-on (feathered soft reveal)
        const nk = { p: 0 };
        tl.to(nk, {
          p: 100,
          duration: 1.8,
          ease: "power1.out",
          onUpdate: () => {
            const p = nk.p;
            const feather = Math.max(6, 18 * (1 - p / 100));
            namkeenText.style.webkitMaskImage = `linear-gradient(to right, black ${p}%, transparent ${p + feather}%)`;
            namkeenText.style.maskImage = `linear-gradient(to right, black ${p}%, transparent ${p + feather}%)`;
          },
          onComplete: () => {
            namkeenText.style.webkitMaskImage = "none";
            namkeenText.style.maskImage = "none";
          },
        });

        // 2. Flourish underline draws as final pen stroke of "Namkeen"
        if (namkeenFlourish) {
          tl.to(
            namkeenFlourish,
            {
              strokeDashoffset: 0,
              duration: 1.0,
              ease: "power1.inOut",
            },
            "-=0.3",
          );
        }

        // 3. Gentle luminous shimmer across "Namkeen"
        tl.to(
          namkeenText,
          {
            backgroundPosition: "-40% 0",
            duration: 1.5,
            ease: "power1.inOut",
          },
          "-=0.4",
        );

        // 4. Natural pause as eye reads "made in yellow", then "mustard" begins
        const ms = { p: 0 };
        tl.to(
          ms,
          {
            p: 100,
            duration: 1.7,
            ease: "power1.out",
            onUpdate: () => {
              const p = ms.p;
              const feather = Math.max(6, 18 * (1 - p / 100));
              mustardText.style.webkitMaskImage = `linear-gradient(to right, black ${p}%, transparent ${p + feather}%)`;
              mustardText.style.maskImage = `linear-gradient(to right, black ${p}%, transparent ${p + feather}%)`;
            },
            onComplete: () => {
              mustardText.style.webkitMaskImage = "none";
              mustardText.style.maskImage = "none";
            },
          },
          "+=0.35",
        );

        // 5. Golden flourish draws as final pen stroke of "mustard"
        if (mustardFlourish) {
          tl.to(
            mustardFlourish,
            {
              strokeDashoffset: 0,
              duration: 0.95,
              ease: "power1.inOut",
            },
            "-=0.3",
          );
        }

        // 6. Gentle golden shimmer across "mustard"
        tl.to(
          mustardText,
          {
            backgroundPosition: "-40% 0",
            duration: 1.5,
            ease: "power1.inOut",
          },
          "-=0.4",
        );

        // 7. Intro write-on complete — ready for interactive hover shimmer
        tl.call(() => {
          introDone = true;
        });
      };

      if (window.gsap) {
        runWithGsap();
      } else {
        const checkGsap = setInterval(() => {
          if (window.gsap) {
            clearInterval(checkGsap);
            runWithGsap();
          }
        }, 30);
        setTimeout(() => clearInterval(checkGsap), 3000);
      }
    }

    if (
      document.readyState === "complete" ||
      document.readyState === "interactive"
    ) {
      setTimeout(initAppleHelloWriteOn, 150);
    } else {
      window.addEventListener(
        "DOMContentLoaded",
        () => setTimeout(initAppleHelloWriteOn, 150),
        { once: true },
      );
    }
  })();
</script>
