---
// Hero.astro — High-Converting Graphic-Dominant Edition
// Visual-first: Grand 360° video pedestal + punchy, uncluttered hook
---

<section class="hero" id="hero">
  <!-- Architectural background atmosphere -->
  <div class="hero-arch-pattern" aria-hidden="true"></div>
  <div class="hero-radial-glow" aria-hidden="true"></div>

  <div class="hero-content">
    <!-- Prestige Location & Heritage Tag -->
    <div class="hero-prestige-tag" id="h-origin">
      <span class="prestige-dot"></span>
      <span class="prestige-text">Fresh From Muzaffarnagar Kadhai</span>
    </div>

    <!-- Concrete, High-Converting Headline (Zero vague fluff, directly addressing customer need) -->
    <h1 class="hero-headline">
      <span class="split-line"><span class="split-inner" id="hl1">Zero Palm Oil.</span></span>
      <span class="split-line"><em class="headline-crimson"><span class="split-inner" id="hl2">Pure Mustard Oil Crunch.</span></em></span>
    </h1>

    <!-- ── THE PRIMARY CONVERSION HOOK (OPEN, CARD-FREE & HIGH-IMPACT) ── -->
    <div class="hero-offer-hook" id="h-hook">
      <div class="hero-hook-badge">
        <span class="hook-dot"></span>
        <span class="hook-badge-text">Launch Special · Free Express Delivery Across India</span>
      </div>

      <div class="hero-offer-main">
        <div class="offer-lead">The Hariram Special 4 Box</div>
        <div class="offer-price-row">
          <span class="offer-price">₹499</span>
          <span class="offer-weight">for 800g (4 × 200g Fresh Packs)</span>
          <span class="offer-ship">Free Shipping</span>
        </div>
      </div>

      <p class="hero-offer-sub" id="h-sub">
        4 signature snacks — Aloo Bhujia, Masala Chana Dal, Dal Biji &amp; Masala Moongfali — slow-cooked in cold-pressed Kachi Ghani mustard oil with home-ground spices. No chemical preservatives, no warehouse stock. Just ~₹62 / 100g delivered to your door.
      </p>

      <div class="hero-cta-group">
        <a 
          href="https://wa.me/916396122920?text=Hi%20Hariram%20Namkeen%2C%20I%20want%20to%20order%20the%20Special%204%20Box%20(800g)%20for%20Rs.499%20with%20Free%20All-India%20Delivery.%20Please%20share%20payment%20and%20delivery%20details." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-hero-cta" 
          data-magnetic
        >
          <span>Claim Special 4 Box @ ₹499 (Free Delivery)</span>
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#products" class="btn-hero-sec">View All 5 Snacks ↓</a>
      </div>

      <div class="hero-trust-row">
        <span class="ht-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="20 6 9 17 4 12"/></svg>
          100% Kachi Ghani Oil
        </span>
        <span class="ht-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="20 6 9 17 4 12"/></svg>
          Zero Delivery Fees
        </span>
        <span class="ht-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="20 6 9 17 4 12"/></svg>
          FSSAI Certified
        </span>
      </div>
    </div>
  </div>

  <!-- ── HERO RIGHT: ARCH-FRAMED 360° VIDEO SHOWCASE ── -->
  <div class="hero-visual-col">
    <div class="hero-arch-card" id="hero-media-card">

      <!-- Viewport Frame -->
      <div class="hero-arch-viewport">

        <!-- Slide 0: Aloo Bhujia 360° Rotating Studio Video -->
        <div class="arch-slide-pane active" data-slide="0">
          <video 
            src="/videos/aloo_bhujia_rotating_shoot.mp4" 
            autoplay 
            loop 
            muted 
            playsinline 
            preload="auto"
            class="arch-video"
            aria-label="360° studio rotation of fresh Hariram Aloo Bhujia"
          ></video>
          <div class="arch-vignette"></div>

          <!-- Studio Live Indicator -->
          <div class="arch-meta-chip chip-top-left">
            <span class="meta-pulse-dot"></span>
            <span>360° Rotating Shoot</span>
          </div>

          <div class="arch-feature-chip chip-bottom-left">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            <span>Pure Kachi Ghani Mustard Oil</span>
          </div>
        </div>

        <!-- Slide 1: Masala Chana Dal -->
        <div class="arch-slide-pane" data-slide="1">
          <img src="/images/masala_chana_dal.png" alt="Masala Chana Dal Studio Shoot" loading="lazy" />
          <div class="arch-vignette"></div>
          <div class="arch-meta-chip chip-top-left">
            <span>Masala Chana Dal · 200g</span>
          </div>
          <div class="arch-feature-chip chip-bottom-left">
            <span>High Protein · Stone-Ground Amchur</span>
          </div>
        </div>

        <!-- Slide 2: Traditional Dal Biji -->
        <div class="arch-slide-pane" data-slide="2">
          <img src="/images/dal-bhiji.jpg" alt="Traditional Moong Dal Dal Biji" loading="lazy" />
          <div class="arch-vignette"></div>
          <div class="arch-meta-chip chip-top-left">
            <span>Dal Biji · Muzaffarnagar Classic</span>
          </div>
          <div class="arch-feature-chip chip-bottom-left">
            <span>Moong Dal &amp; Heritage Spices</span>
          </div>
        </div>

        <!-- Slide 3: Masala Moongfali -->
        <div class="arch-slide-pane" data-slide="3">
          <img src="/images/masala_moongfali.png" alt="Masala Moongfali Peanuts" loading="lazy" />
          <div class="arch-vignette"></div>
          <div class="arch-meta-chip chip-top-left">
            <span>Masala Moongfali · 200g</span>
          </div>
          <div class="arch-feature-chip chip-bottom-left">
            <span>Kashmiri Chilli &amp; Roasted Peanuts</span>
          </div>
        </div>

        <!-- Slide 4: Special 4 Platter Preview -->
        <div class="arch-slide-pane" data-slide="4">
          <img src="/images/hariram_special_4_top_view.png" alt="Hariram Special 4 Platter Top View" loading="lazy" />
          <div class="arch-vignette"></div>
          <div class="arch-meta-chip chip-top-left">
            <span>Special 4 Tasting Platter (800g)</span>
          </div>
          <div class="arch-feature-chip chip-bottom-left">
            <span>₹499 All-Inclusive · Free Shipping</span>
          </div>
        </div>

      </div>

      <!-- Professional Carousel Controller -->
      <div class="hero-arch-controls">
        <button class="arch-nav-arrow prev" id="hero-prev" aria-label="Previous product">
          <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
        </button>

        <div class="arch-pills-bar" id="hero-pills">
          <button class="arch-pill active" data-index="0">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            Aloo Bhujia 360°
          </button>
          <button class="arch-pill" data-index="1">Chana Dal</button>
          <button class="arch-pill" data-index="2">Dal Biji</button>
          <button class="arch-pill" data-index="3">Moongfali</button>
          <button class="arch-pill" data-index="4">Special 4 Box</button>
        </div>

        <button class="arch-nav-arrow next" id="hero-next" aria-label="Next product">
          <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Scroll Down Hint -->
  <a href="#craft" class="hero-scroll-cue" aria-label="Scroll down to explore">
    <span class="cue-label">Explore The Craft</span>
    <span class="cue-arrow">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </a>
</section>

<script is:inline>
  // Hero Arch Carousel Controller
  (() => {
    const panes = document.querySelectorAll('.arch-slide-pane');
    const pills = document.querySelectorAll('#hero-pills .arch-pill');
    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');
    if (!panes.length) return;

    let current = 0;
    let timer = null;

    function showSlide(idx) {
      panes[current].classList.remove('active');
      pills[current]?.classList.remove('active');

      current = (idx + panes.length) % panes.length;

      panes[current].classList.add('active');
      pills[current]?.classList.add('active');

      // Video play state
      const vid = panes[current].querySelector('video');
      if (vid && vid.paused) {
        vid.play().catch(() => {});
      }
    }

    pills.forEach((p, i) => {
      p.addEventListener('click', () => {
        showSlide(i);
        restartTimer();
      });
    });

    prevBtn?.addEventListener('click', () => {
      showSlide(current - 1);
      restartTimer();
    });

    nextBtn?.addEventListener('click', () => {
      showSlide(current + 1);
      restartTimer();
    });

    function startTimer() {
      timer = setInterval(() => {
        showSlide(current + 1);
      }, 6500);
    }

    function restartTimer() {
      if (timer) clearInterval(timer);
      startTimer();
    }

    startTimer();
  })();
</script>
