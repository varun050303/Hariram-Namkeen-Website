        <a href="#products" class="btn-hook-sec">Explore All Products</a>
      </div>
    </div>

  </div>

  <!-- ── RIGHT COLUMN: CINEMATIC 360° VIDEO & INTERACTIVE CAROUSEL ── -->
  <div class="hero-visual-wrap">
    <div class="hero-media-card" id="hero-media-card">

      <!-- Slides Container -->
      <div class="hero-slides-viewport">

        <!-- Slide 1: Aloo Bhujia 360° Rotating Studio Video (Active by default) -->
        <div class="hero-slide-pane active" data-slide="0">
          <video 
            src="/videos/aloo_bhujia_rotating_shoot.mp4" 
            autoplay 
            loop 
            muted 
            playsinline 
            preload="auto"
            class="hero-video-loop"
            aria-label="360° rotating view of Hariram Aloo Bhujia"
          ></video>
          <div class="hero-media-overlay"></div>
          <div class="hero-live-badge">
            <span class="live-dot"></span>
            <span>360° Studio Shoot · Aloo Bhujia</span>
          </div>
          <div class="hero-floating-badge badge-top-right">
            <span>🥔 Crispy Potato Flakes &amp; Besan</span>
          </div>
