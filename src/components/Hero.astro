---
// Hero.astro — Focused Special 4 Box Conversion Hero
// Hariram Namkeen: 4 varieties, 800g, ₹499, free delivery across India, yellow mustard oil.
---

<section class="hero" id="hero">
  <!-- Blurred ambient video background -->
  <div class="hero-bg-video-wrap" aria-hidden="true">
    <video
      id="hero-bg-video"
      class="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="/videos/aloo_bhujia_hero_widescreen.mp4" type="video/mp4" />
      <source src="/videos/aloo_bhujia_rotating_shoot.mp4" type="video/mp4" />
    </video>
    <div class="hero-bg-video-overlay"></div>
  </div>

  <div class="hero-inner">
    <!-- Left column: Editorial Value Proposition -->
    <div class="hero-content">
      <!-- 1. H1 Trust Headline + UP Hindi Line -->
      <div class="hero-headline-wrap">
        <h1 class="hero-headline" id="hero-h1">
          Namkeen made in <br class="headline-br" /><em class="hl-oil">yellow mustard oil.</em>
        </h1>
        <p class="hero-hindi">पीली सरसों के तेल में बनी नमकीन</p>
      </div>

      <!-- 2. Subline (Concise, no duplicate lines) -->
      <p class="hero-sub" id="hero-sub">
        <strong>Zero palm oil, zero preservatives.</strong>
      </p>

      <!-- 3. Offer block (The Royal Maroon Card with Gold Price) -->
      <div class="hero-box-card" id="hero-offer">
        <div class="hbc-header">
          <div class="hbc-title-wrap">
            <span class="hbc-name">The Special 4 Box</span>
            <span class="hbc-wt">4 varieties · 800g (4 × 200g)</span>
          </div>
          <div class="hbc-price-wrap">
            <span class="hbc-price">₹499</span>
            <span class="hbc-ship">Free Delivery Across India</span>
          </div>
        </div>
        <div class="hbc-menu-row">
          <span class="hbc-menu-label">Includes:</span>
          <span class="hbc-menu-items">
            <strong>Aloo Bhujia</strong> · 
            <strong>Masala Chana Dal</strong> · 
            <strong>Dal Biji</strong> · 
            <strong>Spicy Malka / Masala Moongfali</strong>
          </span>
        </div>
      </div>

      <!-- 4. One primary button (Gold CTA) -->
      <div class="hero-cta-wrap" id="hero-cta">
        <a 
          href="https://wa.me/916396122920?text=Hi%20Hariram%20Namkeen%2C%20I%20want%20to%20order%20the%20Special%204%20Box%20(800g)%20for%20Rs.499%20with%20Free%20All-India%20Delivery.%20Please%20share%20payment%20and%20delivery%20details." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-hero-order" 
          data-magnetic
        >
          <!-- WhatsApp Icon -->
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          <span>Order the 4-Box, ₹499</span>
        </a>
      </div>

      <!-- 5. Proof row (Fried fresh to order enlarged) -->
      <div class="hero-trust-inline" id="hero-proof">
        <span class="trust-highlight">✦ Fried fresh to order</span>
        <span class="ht-sep">·</span>
        <span>Muzaffarnagar Craft</span>
        <span class="ht-sep">·</span>
        <span>Zero Palm Oil</span>
      </div>
    </div>

    <!-- Right column: One complete image and name carousel card -->
    <div class="hero-visual" id="hero-visual">
      <div class="hero-carousel-card" id="hero-carousel">
        <div class="hero-carousel-slides">
          <!-- Slide 1: Aloo Bhujia -->
          <div class="hero-carousel-slide active" data-slide="0">
            <img 
              src="/images/aloo_bhujia.webp" 
              alt="Aloo Bhujia" 
              class="hc-slide-img" 
              loading="eager" 
              fetchpriority="high"
              width="768" 
              height="1365" 
            />
            <div class="hc-name-badge">Aloo Bhujia</div>
          </div>

          <!-- Slide 2: Masala Chana Dal -->
          <div class="hero-carousel-slide" data-slide="1">
            <img 
              src="/images/masala_chana_dal.webp" 
              alt="Masala Chana Dal" 
              class="hc-slide-img" 
              loading="lazy" 
              width="900" 
              height="1600" 
            />
            <div class="hc-name-badge">Masala Chana Dal</div>
          </div>

          <!-- Slide 3: Dal Biji -->
          <div class="hero-carousel-slide" data-slide="2">
            <img 
              src="/images/dal-bhiji.webp" 
              alt="Dal Biji" 
              class="hc-slide-img" 
              loading="lazy" 
              width="900" 
              height="600" 
            />
            <div class="hc-name-badge">Dal Biji</div>
          </div>

          <!-- Slide 4: Masala Moongfali -->
          <div class="hero-carousel-slide" data-slide="3">
            <img 
              src="/images/masala_moongfali.webp" 
              alt="Masala Moongfali" 
              class="hc-slide-img" 
              loading="lazy" 
              width="1200" 
              height="896" 
            />
            <div class="hc-name-badge">Masala Moongfali</div>
          </div>

          <!-- Slide 5: Shahi Dal Biji -->
          <div class="hero-carousel-slide" data-slide="4">
            <img 
              src="/images/premium.webp" 
              alt="Shahi Dal Biji" 
              class="hc-slide-img" 
              loading="lazy" 
              width="900" 
              height="600" 
            />
            <div class="hc-name-badge">Shahi Dal Biji</div>
          </div>

          <!-- Slide 6: Spicy Malka -->
          <div class="hero-carousel-slide" data-slide="5">
            <img 
              src="/images/masala_malka.webp" 
              alt="Spicy Malka" 
              class="hc-slide-img" 
              loading="lazy" 
              width="1376" 
              height="768" 
            />
            <div class="hc-name-badge">Spicy Malka</div>
          </div>
        </div>

        <!-- Carousel Dots -->
        <div class="hc-dots" id="hc-dots">
          <button class="hc-dot active" data-index="0" aria-label="Slide 1: Aloo Bhujia"></button>
          <button class="hc-dot" data-index="1" aria-label="Slide 2: Masala Chana Dal"></button>
          <button class="hc-dot" data-index="2" aria-label="Slide 3: Dal Biji"></button>
          <button class="hc-dot" data-index="3" aria-label="Slide 4: Masala Moongfali"></button>
          <button class="hc-dot" data-index="4" aria-label="Slide 5: Shahi Dal Biji"></button>
          <button class="hc-dot" data-index="5" aria-label="Slide 6: Spicy Malka"></button>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Hero background video controller: ensure video plays actively and visibly
  (() => {
    const v = document.getElementById('hero-bg-video');
    if (!v) return;

    v.muted = true;
    v.defaultMuted = true;

    const playVideo = () => {
      const p = v.play();
      if (p !== undefined) {
        p.catch(() => {
          // If browser policy prevents unprompted autoplay, play on first user interaction
          const unlock = () => {
            v.play().catch(() => {});
            ['click', 'scroll', 'touchstart'].forEach(evt => document.removeEventListener(evt, unlock));
          };
          ['click', 'scroll', 'touchstart'].forEach(evt => document.addEventListener(evt, unlock, { once: true }));
        });
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', playVideo);
    } else {
      playVideo();
    }

    // Only pause when hero is completely scrolled off-screen
    const hero = document.getElementById('hero');
    if ('IntersectionObserver' in window && hero) {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      }, { threshold: 0 }).observe(hero);
    }
  })();

  // Hero Carousel Logic (cycles through 5 snacks with complete image and name only)
  (() => {
    const card = document.getElementById('hero-carousel');
    if (!card) return;
    const slides = card.querySelectorAll('.hero-carousel-slide');
    const dots = card.querySelectorAll('.hc-dot');
    if (!slides.length) return;

    let current = 0;
    let timer = null;

    function goTo(idx) {
      slides[current]?.classList.remove('active');
      dots[current]?.classList.remove('active');
      current = (idx + slides.length) % slides.length;
      slides[current]?.classList.add('active');
      dots[current]?.classList.add('active');
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function startAuto() {
      stopAuto();
      timer = setInterval(next, 3500);
    }
    function stopAuto() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); startAuto(); });
    });

    // Touch swipe support
    let startX = 0;
    card.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      stopAuto();
    }, { passive: true });

    card.addEventListener('touchend', (e) => {
      const diffX = e.changedTouches[0].clientX - startX;
      if (Math.abs(diffX) > 40) {
        if (diffX > 0) prev(); else next();
      }
      startAuto();
    }, { passive: true });

    card.addEventListener('mouseenter', stopAuto);
    card.addEventListener('mouseleave', startAuto);

    startAuto();
  })();
</script>
