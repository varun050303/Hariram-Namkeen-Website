---
// DiwaliPriceDrop.astro — Animated Festive Price Drop (₹499 → ₹449)
// Story: "Chintu" the festive boy sneaks in, places a Diwali sutli bomb next to ₹499,
// runs back covering his ears, the bomb BOOMS with fireworks, and the price drops to ₹449 with Diwali savings!
---

<div class="diwali-price-drop-wrapper" id="diwali-price-drop-wrapper">
  <!-- Price Display Row -->
  <div class="dpd-pricing-row">
    <div class="dpd-prices" id="dpd-prices">
      <!-- Old Price (starts prominent, gets blown up & struck through) -->
      <span class="dpd-price-old is-initial" id="dpd-price-old">&#8377;499</span>
      <!-- New Discounted Price (revealed with energetic bounce) -->
      <span class="dpd-price-new" id="dpd-price-new" style="display: none;">&#8377;449</span>
    </div>

    <!-- Festive Diwali Savings Pill Badge & Replay Trigger -->
    <div class="dpd-meta">
      <div class="dpd-badge" id="dpd-badge" style="display: none;">
        <span class="badge-icon">💥</span>
        <span class="badge-text">Diwali Dhamaka &middot; Save &#8377;50</span>
      </div>

      <button class="dpd-replay-btn" id="dpd-replay-btn" style="display: none;" aria-label="Replay Diwali price drop animation" title="Watch firecracker blast again">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        <span>Replay 💥</span>
      </button>
    </div>
  </div>

  <!-- Animated Character & Firecracker Stage -->
  <div class="dpd-stage" id="dpd-stage" aria-hidden="true">
    <!-- Character Rig (Tiptoeing, ear-covering, cheering) -->
    <div class="dpd-character" id="dpd-character">
      <svg class="char-svg" viewBox="0 0 64 74" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Skin Gradient -->
          <linearGradient id="charSkinGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#FED7AA"/>
            <stop offset="100%" stop-color="#FDBA74"/>
          </linearGradient>
          <!-- Saffron Kurta Gradient -->
          <linearGradient id="charKurtaGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#FB923C"/>
            <stop offset="50%" stop-color="#EA580C"/>
            <stop offset="100%" stop-color="#C2410C"/>
          </linearGradient>
          <!-- Hair Gradient -->
          <linearGradient id="charHairGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#1E293B"/>
            <stop offset="100%" stop-color="#0F172A"/>
          </linearGradient>
        </defs>

        <!-- Body / Kurta -->
        <g class="char-body">
          <!-- Pants & Legs (Festive cream-gold with crisp border for contrast) -->
          <rect x="23" y="52" width="7" height="15" rx="3.5" fill="#F3E7D3" stroke="#C4A882" stroke-width="1"/>
          <rect x="34" y="52" width="7" height="15" rx="3.5" fill="#F3E7D3" stroke="#C4A882" stroke-width="1"/>
          <!-- Mojaris (Traditional shoes) -->
          <path d="M 21 66 C 21 64 26 64 30 65 C 31 67 29 68 22 68 Z" fill="#9A3412"/>
          <path d="M 33 66 C 33 64 38 64 42 65 C 43 67 41 68 34 68 Z" fill="#9A3412"/>

          <!-- Kurta Torso -->
          <path d="M 19 33 C 19 30 25 29 32 29 C 39 29 45 30 45 33 L 48 53 C 48 54 44 55 32 55 C 20 55 16 54 16 53 Z" fill="url(#charKurtaGrad)"/>
          <!-- Golden trim on kurta -->
          <line x1="32" y1="30" x2="32" y2="48" stroke="#FDE047" stroke-width="1.2"/>
          <circle cx="32" cy="35" r="1" fill="#FDE047"/>
          <circle cx="32" cy="41" r="1" fill="#FDE047"/>
          <!-- Kurta Collar -->
          <path d="M 28 29 L 32 34 L 36 29" stroke="#FDE047" stroke-width="1.2" fill="none"/>
        </g>

        <!-- Head & Facial Expressions -->
        <g class="char-head">
          <!-- Neck -->
          <rect x="29" y="26" width="6" height="5" fill="url(#charSkinGrad)"/>
          <!-- Ears -->
          <circle cx="17" cy="19" r="3.2" fill="url(#charSkinGrad)"/>
          <circle cx="47" cy="19" r="3.2" fill="url(#charSkinGrad)"/>
          <!-- Face Contour -->
          <ellipse cx="32" cy="19" rx="14" ry="13" fill="url(#charSkinGrad)"/>

          <!-- Cheeks Blush -->
          <circle cx="22" cy="22" r="3" fill="#F43F5E" opacity="0.32"/>
          <circle cx="42" cy="22" r="3" fill="#F43F5E" opacity="0.32"/>

          <!-- Hair -->
          <path d="M 18 16 C 17 8 23 5 32 5 C 41 5 47 8 46 16 C 44 14 41 12 37 13 C 33 11 27 10 23 13 C 20 14 19 15 18 16 Z" fill="url(#charHairGrad)"/>
          <path d="M 26 12 Q 30 7 35 11 Q 31 10 26 12 Z" fill="url(#charHairGrad)"/>

          <!-- POSE 1 & 3: Normal/Happy Eyes & Smile -->
          <g class="face-normal">
            <path d="M 22 13 Q 25 11 28 13" stroke="#0F172A" stroke-width="1.2" stroke-linecap="round" fill="none"/>
            <path d="M 36 13 Q 39 11 42 13" stroke="#0F172A" stroke-width="1.2" stroke-linecap="round" fill="none"/>
            <ellipse cx="25" cy="17" rx="2.5" ry="3.5" fill="#0F172A"/>
            <ellipse cx="39" cy="17" rx="2.5" ry="3.5" fill="#0F172A"/>
            <circle cx="24.2" cy="15.8" r="1.1" fill="#FFFFFF"/>
            <circle cx="38.2" cy="15.8" r="1.1" fill="#FFFFFF"/>
            <path d="M 27 23 Q 32 28 37 23" stroke="#831843" stroke-width="1.6" stroke-linecap="round" fill="none"/>
          </g>

          <!-- POSE 2: Scared Eyes (Tightly squeezed during fuse sizzle) -->
          <g class="face-scared">
            <path d="M 22 16 L 27 18 L 22 20" stroke="#0F172A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M 42 16 L 37 18 L 42 20" stroke="#0F172A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <ellipse cx="32" cy="24" rx="2.5" ry="3.2" fill="#831843"/>
          </g>
        </g>

        <!-- ARMS POSE 1: Holding Bomb (Sneaking in) -->
        <g class="arms-sneaking">
          <path d="M 42 33 Q 48 38 46 45" stroke="#EA580C" stroke-width="4.5" stroke-linecap="round" fill="none"/>
          <circle cx="46" cy="45" r="2.8" fill="url(#charSkinGrad)"/>
          <path d="M 22 34 Q 13 36 9 44" stroke="#EA580C" stroke-width="4.5" stroke-linecap="round" fill="none"/>
          <circle cx="9" cy="44" r="3" fill="url(#charSkinGrad)"/>
        </g>

        <!-- ARMS POSE 2: Covering Ears (Scared/Ducking) -->
        <g class="arms-covering-ears">
          <path d="M 20 36 Q 14 26 18 19" stroke="#EA580C" stroke-width="4.5" stroke-linecap="round" fill="none"/>
          <circle cx="17" cy="19" r="3.6" fill="url(#charSkinGrad)"/>
          <path d="M 44 36 Q 50 26 46 19" stroke="#EA580C" stroke-width="4.5" stroke-linecap="round" fill="none"/>
          <circle cx="47" cy="19" r="3.6" fill="url(#charSkinGrad)"/>
        </g>

        <!-- ARMS POSE 3: Cheering (Both Hands Up in Victory) -->
        <g class="arms-cheering">
          <path d="M 20 34 Q 12 24 10 14" stroke="#EA580C" stroke-width="4.5" stroke-linecap="round" fill="none"/>
          <circle cx="10" cy="13" r="3.2" fill="url(#charSkinGrad)"/>
          <path d="M 44 34 Q 52 24 54 14" stroke="#EA580C" stroke-width="4.5" stroke-linecap="round" fill="none"/>
          <circle cx="54" cy="13" r="3.2" fill="url(#charSkinGrad)"/>
        </g>
      </svg>
    </div>

    <!-- The Diwali Sutli Bomb (Placed right next to ₹499) -->
    <div class="dpd-bomb" id="dpd-bomb">
      <svg class="bomb-svg" viewBox="0 0 32 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="bombGreenGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#22C55E"/>
            <stop offset="50%" stop-color="#15803D"/>
            <stop offset="100%" stop-color="#14532D"/>
          </linearGradient>
        </defs>

        <!-- Bomb Base -->
        <rect x="5" y="14" width="22" height="19" rx="3.5" fill="url(#bombGreenGrad)" filter="drop-shadow(0 3px 6px rgba(0,0,0,0.25))"/>
        <!-- Golden Jute Rope Twine -->
        <line x1="5" y1="14" x2="27" y2="33" stroke="#FDE047" stroke-width="1.4" opacity="0.85"/>
        <line x1="5" y1="33" x2="27" y2="14" stroke="#FDE047" stroke-width="1.4" opacity="0.85"/>
        <line x1="16" y1="14" x2="16" y2="33" stroke="#FBBF24" stroke-width="1.2" opacity="0.75"/>
        <line x1="5" y1="23.5" x2="27" y2="23.5" stroke="#FBBF24" stroke-width="1.2" opacity="0.75"/>

        <!-- Twisted Rope Fuse -->
        <path d="M 16 14 Q 14 7 19 3" stroke="#78350F" stroke-width="2.2" stroke-linecap="round" fill="none"/>
        <path d="M 16 14 Q 14 7 19 3" stroke="#D97706" stroke-width="1" stroke-dasharray="2 2" fill="none"/>

        <!-- Sizzling Fuse Spark -->
        <g class="bomb-spark">
          <circle cx="19" cy="3" r="4.5" fill="#FEF08A" class="spark-pulse"/>
          <circle cx="19" cy="3" r="2.2" fill="#FFFFFF"/>
          <path d="M 19 0 L 19 6 M 16 3 L 22 3 M 17 1 L 21 5 M 17 5 L 21 1" stroke="#F59E0B" stroke-width="1.2"/>
        </g>
      </svg>
    </div>

    <!-- Comic Explosion Burst & Smoke Puff -->
    <div class="dpd-blast" id="dpd-blast">
      <svg class="blast-svg" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="60" cy="60" r="48" fill="rgba(251, 191, 36, 0.45)" class="blast-ring"/>
        <path
          d="M 60 8 L 68 38 L 98 22 L 86 50 L 115 60 L 86 70 L 98 98 L 68 82 L 60 112 L 52 82 L 22 98 L 34 70 L 5 60 L 34 50 L 22 22 L 52 38 Z"
          fill="#F59E0B"
          class="blast-star"
        />
        <path
          d="M 60 20 L 66 44 L 88 32 L 80 52 L 102 60 L 80 68 L 88 88 L 66 76 L 60 100 L 54 76 L 32 88 L 40 68 L 18 60 L 40 52 L 32 32 L 54 44 Z"
          fill="#FEF08A"
          class="blast-star-inner"
        />
        <circle cx="60" cy="60" r="14" fill="#FFFFFF" class="blast-core"/>
        <circle cx="44" cy="48" r="16" fill="#FAF5EB" opacity="0.85" class="smoke-1"/>
        <circle cx="76" cy="48" r="18" fill="#F3E9D8" opacity="0.8" class="smoke-2"/>
        <circle cx="60" cy="72" r="15" fill="#FAF5EB" opacity="0.85" class="smoke-3"/>
      </svg>
    </div>
  </div>
</div>

<style>
  /* ── WRAPPER & PRICING ROW ────────────────────────────── */
  .diwali-price-drop-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin-top: 4px;
    width: 100%;
  }

  .dpd-pricing-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    position: relative;
    z-index: 4;
  }

  .dpd-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .dpd-prices {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    position: relative;
    cursor: pointer;
  }

  /* ── OLD PRICE (₹499) ─────────────────────────────────── */
  .dpd-price-old {
    font-family: var(--F, "Playfair Display", serif);
    font-size: clamp(1.85rem, 1.5rem + 1vw, 2.375rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #734503;
    display: inline-block;
    position: relative;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .dpd-price-old.is-initial {
    background: linear-gradient(115deg, #734503 0%, #A06D10 25%, #D49B2A 50%, #A06D10 75%, #734503 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: goldPriceShimmer 3.8s linear infinite;
  }

  .dpd-price-old.is-blasted {
    font-size: clamp(1.15rem, 1rem + 0.3vw, 1.35rem);
    color: #991B1B;
    -webkit-text-fill-color: #991B1B;
    opacity: 0.65;
    text-decoration: line-through;
    text-decoration-color: #DC2626;
    text-decoration-thickness: 2.5px;
    transform: translateY(-2px);
    animation: oldPriceShake 0.45s ease-out;
  }

  @keyframes oldPriceShake {
    0%, 100% { transform: translate(0, -2px) rotate(0deg); }
    20% { transform: translate(-3px, -4px) rotate(-4deg); }
    40% { transform: translate(3px, -1px) rotate(3deg); }
    60% { transform: translate(-2px, -3px) rotate(-2deg); }
    80% { transform: translate(2px, -2px) rotate(1deg); }
  }

  /* ── NEW PRICE (₹449) ─────────────────────────────────── */
  .dpd-price-new {
    font-family: var(--F, "Playfair Display", serif);
    font-size: clamp(2.1rem, 1.7rem + 1.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(115deg, #854D0E 0%, #CA8A04 22%, #FACC15 45%, #FEF08A 55%, #EAB308 70%, #854D0E 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 8px rgba(202, 138, 4, 0.42));
    display: inline-block;
    animation: goldPriceShimmer 3.4s linear infinite, newPriceBounce 0.65s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes newPriceBounce {
    0% {
      opacity: 0;
      transform: scale(0.3) translateY(18px);
      filter: drop-shadow(0 0 24px rgba(245, 158, 11, 1));
    }
    60% {
      opacity: 1;
      transform: scale(1.22) translateY(-4px);
    }
    85% {
      transform: scale(0.96) translateY(1px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes goldPriceShimmer {
    0% { background-position: 200% 0; }
    100% { background-position: 0% 0; }
  }

  /* ── DIWALI SAVINGS BADGE ─────────────────────────────── */
  .dpd-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #751818 0%, #991B1B 100%);
    color: #FFFDF9;
    font-family: var(--B, "Plus Jakarta Sans", sans-serif);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid #FBBF24;
    box-shadow: 0 3px 10px rgba(153, 27, 27, 0.35);
    animation: badgePop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
  }

  @keyframes badgePop {
    0% {
      opacity: 0;
      transform: scale(0.4) rotate(-6deg);
    }
    70% {
      transform: scale(1.12) rotate(2deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  .dpd-badge .badge-icon {
    font-size: 13px;
    animation: badgeIconPulse 1.6s ease-in-out infinite alternate;
  }

  @keyframes badgeIconPulse {
    0% { transform: scale(1); }
    100% { transform: scale(1.3) rotate(8deg); }
  }

  /* ── REPLAY BUTTON ────────────────────────────────────── */
  .dpd-replay-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(200, 147, 26, 0.09);
    border: 1px solid rgba(200, 147, 26, 0.32);
    color: var(--text-muted, #734503);
    font-family: var(--B, sans-serif);
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    opacity: 0.85;
  }

  .dpd-replay-btn:hover {
    opacity: 1;
    background: rgba(200, 147, 26, 0.18);
    border-color: var(--gold, #C8931A);
    color: var(--maroon, #751818);
    transform: translateY(-1px);
  }

  .dpd-replay-btn svg {
    transition: transform 0.4s ease;
  }

  .dpd-replay-btn:hover svg {
    transform: rotate(-180deg);
  }

  /* ── ANIMATION STAGE & CHARACTERS ─────────────────────── */
  .dpd-stage {
    position: absolute;
    top: -30px;
    left: 0;
    width: 100%;
    height: 90px;
    pointer-events: none;
    z-index: 6;
  }

  /* ── CHARACTER CONTAINER ──────────────────────────────── */
  .dpd-character {
    position: absolute;
    top: 0;
    left: 0;
    width: 52px;
    height: 60px;
    transform: translateX(240px);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .char-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Character Poses switching */
  .face-scared,
  .arms-covering-ears,
  .arms-cheering {
    display: none;
  }

  /* ── BOMB CONTAINER ───────────────────────────────────── */
  .dpd-bomb {
    position: absolute;
    top: 26px;
    left: 48px;
    width: 26px;
    height: 30px;
    opacity: 0;
    transform: scale(0.2);
    transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .bomb-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .bomb-spark .spark-pulse {
    animation: sparkFlicker 0.15s ease-in-out infinite alternate;
  }

  @keyframes sparkFlicker {
    0% { transform: scale(0.8); opacity: 0.8; }
    100% { transform: scale(1.4); opacity: 1; }
  }

  /* ── BLAST CONTAINER ──────────────────────────────────── */
  .dpd-blast {
    position: absolute;
    top: -10px;
    left: 10px;
    width: 95px;
    height: 95px;
    opacity: 0;
    transform: scale(0);
    pointer-events: none;
  }

  .blast-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ── PHASE 1: SNEAK IN ────────────────────────────────── */
  .diwali-price-drop-wrapper.state-sneaking .dpd-character {
    opacity: 1;
    animation: charSneakIn 1.25s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  @keyframes charSneakIn {
    0% {
      transform: translateX(230px) translateY(0);
    }
    20% {
      transform: translateX(180px) translateY(-5px);
    }
    40% {
      transform: translateX(140px) translateY(0);
    }
    60% {
      transform: translateX(110px) translateY(-5px);
    }
    80% {
      transform: translateX(85px) translateY(0);
    }
    100% {
      transform: translateX(72px) translateY(0);
    }
  }

  /* ── PHASE 2: PLACE BOMB ──────────────────────────────── */
  .diwali-price-drop-wrapper.state-placing .dpd-character {
    opacity: 1;
    transform: translateX(72px) translateY(0);
  }

  .diwali-price-drop-wrapper.state-placing .dpd-bomb,
  .diwali-price-drop-wrapper.state-runaway .dpd-bomb {
    opacity: 1;
    transform: scale(1);
    animation: bombSizzle 0.8s ease-in-out infinite alternate;
  }

  @keyframes bombSizzle {
    0% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.08) rotate(3deg); }
    100% { transform: scale(0.96) rotate(-3deg); }
  }

  /* ── PHASE 3: RUN AWAY & COVER EARS ───────────────────── */
  .diwali-price-drop-wrapper.state-runaway .dpd-character {
    opacity: 1;
    animation: charRunAway 0.55s ease-out forwards;
  }

  .diwali-price-drop-wrapper.state-runaway .face-normal,
  .diwali-price-drop-wrapper.state-runaway .arms-sneaking {
    display: none !important;
  }

  .diwali-price-drop-wrapper.state-runaway .face-scared,
  .diwali-price-drop-wrapper.state-runaway .arms-covering-ears {
    display: block !important;
  }

  @keyframes charRunAway {
    0% {
      transform: translateX(72px) scaleX(1);
    }
    35% {
      transform: translateX(180px) translateY(-6px) scaleX(1);
    }
    70% {
      transform: translateX(330px) translateY(-3px) scaleX(1);
    }
    100% {
      transform: translateX(475px) translateY(2px) scaleX(1);
    }
  }

  /* ── PHASE 4: BOOM BLAST ──────────────────────────────── */
  .diwali-price-drop-wrapper.state-boom .dpd-bomb {
    opacity: 0 !important;
    transform: scale(0) !important;
  }

  .diwali-price-drop-wrapper.state-boom .dpd-blast {
    animation: blastPop 0.65s ease-out forwards;
  }

  @keyframes blastPop {
    0% {
      opacity: 0;
      transform: scale(0.1) rotate(0deg);
    }
    20% {
      opacity: 1;
      transform: scale(1.2) rotate(15deg);
    }
    50% {
      opacity: 0.95;
      transform: scale(1.35) rotate(25deg);
    }
    100% {
      opacity: 0;
      transform: scale(1.5) rotate(35deg);
    }
  }

  /* ── PHASE 5: CELEBRATION DANCE ───────────────────────── */
  .diwali-price-drop-wrapper.state-celebrate .dpd-character {
    opacity: 1;
    transform: translateX(475px) translateY(0);
    animation: charCheerBounce 1.4s ease-in-out infinite alternate;
  }

  .diwali-price-drop-wrapper.state-celebrate .face-scared,
  .diwali-price-drop-wrapper.state-celebrate .arms-sneaking,
  .diwali-price-drop-wrapper.state-celebrate .arms-covering-ears {
    display: none !important;
  }

  .diwali-price-drop-wrapper.state-celebrate .face-normal,
  .diwali-price-drop-wrapper.state-celebrate .arms-cheering {
    display: block !important;
  }

  @keyframes charCheerBounce {
    0% {
      transform: translateX(475px) translateY(0) rotate(0deg);
    }
    50% {
      transform: translateX(475px) translateY(-7px) rotate(4deg);
    }
    100% {
      transform: translateX(475px) translateY(0) rotate(-4deg);
    }
  }

  /* ── RESPONSIVE SCALING FOR TABLET & MOBILE ────────────── */
  @media (max-width: 640px) {
    .dpd-stage {
      top: -18px;
    }
    .dpd-pricing-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .dpd-meta {
      gap: 8px;
    }
    .dpd-character {
      transform: translateX(180px);
    }
    @keyframes charSneakIn {
      0% { transform: translateX(180px); }
      100% { transform: translateX(65px); }
    }
    @keyframes charRunAway {
      0% { transform: translateX(65px); }
      100% { transform: translateX(148px); }
    }
    .diwali-price-drop-wrapper.state-celebrate .dpd-character {
      transform: translateX(148px);
    }
    @keyframes charCheerBounce {
      0% { transform: translateX(148px) translateY(0); }
      50% { transform: translateX(148px) translateY(-5px); }
      100% { transform: translateX(148px) translateY(0); }
    }
    .dpd-badge {
      font-size: 10.5px;
      padding: 3px 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dpd-character,
    .dpd-bomb,
    .dpd-blast {
      display: none !important;
    }
    .dpd-price-old {
      text-decoration: line-through;
      opacity: 0.6;
    }
    .dpd-price-new,
    .dpd-badge {
      display: inline-flex !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const wrapper = document.getElementById('diwali-price-drop-wrapper');
    const priceOld = document.getElementById('dpd-price-old');
    const priceNew = document.getElementById('dpd-price-new');
    const badge = document.getElementById('dpd-badge');
    const replayBtn = document.getElementById('dpd-replay-btn');

    if (!wrapper || !priceOld || !priceNew || !badge) return;

    let animTimeouts = [];

    function clearAllTimeouts() {
      animTimeouts.forEach(t => clearTimeout(t));
      animTimeouts = [];
    }

    function runDiwaliPriceDropSequence() {
      clearAllTimeouts();

      // Reset to Initial State
      wrapper.className = 'diwali-price-drop-wrapper';
      priceOld.className = 'dpd-price-old is-initial';
      priceOld.style.display = 'inline-block';
      priceNew.style.display = 'none';
      badge.style.display = 'none';
      if (replayBtn) replayBtn.style.display = 'none';

      // Phase 1: Sneak In (After 1.1s)
      animTimeouts.push(setTimeout(() => {
        wrapper.classList.add('state-sneaking');
      }, 1100));

      // Phase 2: Place Bomb (After 2.35s)
      animTimeouts.push(setTimeout(() => {
        wrapper.classList.remove('state-sneaking');
        wrapper.classList.add('state-placing');
      }, 2350));

      // Phase 3: Run Away & Cover Ears (After 3.05s)
      animTimeouts.push(setTimeout(() => {
        wrapper.classList.remove('state-placing');
        wrapper.classList.add('state-runaway');
      }, 3050));

      // Phase 4: BOOM EXPLOSION & PRICE DROP (After 3.65s)
      animTimeouts.push(setTimeout(() => {
        wrapper.classList.remove('state-runaway');
        wrapper.classList.add('state-boom');

        // Reveal new price and slashed old price
        priceOld.className = 'dpd-price-old is-blasted';
        priceNew.style.display = 'inline-block';
        badge.style.display = 'inline-flex';

        // Trigger celebratory firecracker sparks directly over price!
        if (typeof window.fireDiwaliCrackers === 'function') {
          window.fireDiwaliCrackers('single', 'grandDiwali');
        }
      }, 3650));

      // Phase 5: Celebrate & Victory Dance (After 4.15s)
      animTimeouts.push(setTimeout(() => {
        wrapper.classList.remove('state-boom');
        wrapper.classList.add('state-celebrate');
        if (replayBtn) replayBtn.style.display = 'inline-flex';
      }, 4150));
    }

    // Auto-play when hero enters view
    runDiwaliPriceDropSequence();

    // Replay on button click
    if (replayBtn) {
      replayBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        runDiwaliPriceDropSequence();
      });
    }

    // Also replay if someone taps on the price area!
    const pricesBox = document.getElementById('dpd-prices');
    if (pricesBox) {
      pricesBox.addEventListener('click', () => {
        if (wrapper.classList.contains('state-celebrate')) {
          runDiwaliPriceDropSequence();
        }
      });
    }
  })();
</script>
