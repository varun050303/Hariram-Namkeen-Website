---
// Platforms.astro
// Where to order: Swiggy, Zomato, Amazon, Flipkart, Meesho
// TODO: Replace href="#" with actual storefront URLs
---

<section class="platforms-section" id="order">
  <div style="max-width:1200px;margin:0 auto;padding:0 40px;">
    <div class="platforms-label">Available On</div>
    <h2 class="platforms-hl">Order where you <em>already shop.</em></h2>
    <p class="platforms-sub">No app to download. No new account. Just order on the platform you trust.</p>
    <div class="platforms-grid">
      <a href="#" class="platform-card" data-magnetic>
        <span class="platform-icon" style="background:rgba(252,88,0,.15); color:#FC5800;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
        </span>
        <span>Swiggy</span>
      </a>
      <a href="#" class="platform-card" data-magnetic>
        <span class="platform-icon" style="background:rgba(203,31,27,.12); color:#CB1F1B;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
        </span>
        <span>Zomato</span>
      </a>
      <a href="#" class="platform-card" data-magnetic>
        <span class="platform-icon" style="background:rgba(247,155,0,.12); color:#F79B00;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        </span>
        <span>Amazon</span>
      </a>
      <a href="#" class="platform-card" data-magnetic>
        <span class="platform-icon" style="background:rgba(40,116,240,.12); color:#2874F0;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        </span>
        <span>Flipkart</span>
      </a>
      <a href="#" class="platform-card" data-magnetic>
        <span class="platform-icon" style="background:rgba(255,58,129,.12); color:#FF3A81;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </span>
        <span>Meesho</span>
      </a>
    </div>
  </div>
</section>
