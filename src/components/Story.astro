---
import contentData from '../data/content.json';

const { story } = contentData;
---

<section class="w-full px-4 md:px-10 py-16 md:py-24">
  <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 lg:gap-20 items-center">
    <div class="relative rounded-2xl overflow-hidden aspect-[4/3] group">
      <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors z-10"></div>
      <!-- Decorative elements -->
      <div class="absolute -bottom-6 -left-6 size-24 bg-primary/20 rounded-full blur-2xl z-0"></div>
      <div class="absolute -top-6 -right-6 size-32 bg-yellow-500/20 rounded-full blur-3xl z-0"></div>
      <div
        class="w-full h-full bg-cover bg-center relative z-10"
        style={`background-image: url("${story.image.src}");`}
      >
      </div>
    </div>
    
    <div class="flex flex-col gap-6">
      <span class="text-primary font-bold uppercase tracking-widest text-sm">{story.badge}</span>
      <h2 class="text-3xl md:text-5xl font-black text-text-main dark:text-white leading-tight">
        From Our Kitchen <br />in Uttar Pradesh
      </h2>
      {story.content.map((paragraph) => (
        <p class="text-lg text-text-muted dark:text-[#d1c2b0] leading-relaxed">
          {paragraph}
        </p>
      ))}
      <div class="pt-2">
        <a
          class="inline-flex items-center gap-2 text-primary font-bold hover:gap-3 transition-all"
          href="#"
        >
          {story.cta} <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>
    </div>
  </div>
</section>
