---
// HeroMobileCarousel.astro
// Visual-first interactive mobile product carousel for Hariram Namkeen Hero section
// Displays high-resolution snack photography with floating name tags and clickable product links.

const items = [
  {
    title: "Aloo Bhujia",
    hindiName: "आलू भुजिया",
    badge: "Crisp Potato & Besan",
    desc: "Crispy potato & besan sev in pure mustard oil",
    image: "/images/aloo_bhujia.webp",
    link: "/products/aloo-bhujia/",
    featured: true,
  },
  {
    title: "Dal Biji",
    hindiName: "दाल बीजी",
    badge: "Moong Dal & Magaz",
    desc: "Crisp moong dal & magaz melon seeds",
    image: "/images/dal-bhiji.webp",
    link: "/products/dal-biji/",
    featured: false,
  },
  {
    title: "Masala Chana Dal",
    hindiName: "मसाला चना दाल",
    badge: "Bengal Gram & Amchur",
    desc: "Split Bengal gram & tangy dried mango amchur",
    image: "/images/masala_chana_dal.webp",
    link: "/products/chana-dal/",
    featured: false,
  },
  {
    title: "Spicy Malka",
    hindiName: "स्पाइसी मलका",
    badge: "Whole Red Masoor",
    desc: "Whole red lentils & Kashmiri red chilli",
    image: "/images/masala_malka.webp",
    link: "/products/spicy-malka/",
    featured: false,
  },
  {
    title: "Shahi Dal Biji",
    hindiName: "शाही दाल बीजी",
    badge: "Cashews & Raisins",
    desc: "Whole cashews, Kishmish raisins & melon seeds",
    image: "/images/premium.webp",
    link: "/products/shahi-dal-biji/",
    featured: false,
  },
  {
    title: "Masala Moongfali",
    hindiName: "मसाला मूंगफली",
    badge: "Roasted Peanuts",
    desc: "Slow-roasted peanuts with roasted spices",
    image: "/images/masala_moongfali.webp",
    link: "/products/masala-peanuts/",
    featured: false,
  },
];
---

<div class="hm-carousel-wrapper" id="hmCarouselWrapper" aria-label="Hariram Signature Namkeen Showcase">
  <!-- Swipeable Card Track -->
  <div class="hm-carousel-track" id="hmCarouselTrack" tabindex="0" role="region" aria-label="Snack products carousel">
    {
      items.map((item, index) => (
        <a
          href={item.link}
          class={`hm-card ${item.featured ? "is-featured" : ""}`}
          data-slide-index={index}
          aria-label={item.title}
        >
          <!-- Product Photography -->
          <div class="hm-card-media">
            <img
              src={item.image}
              alt={`${item.title} - Pure Mustard Oil Namkeen`}
              width="600"
              height="450"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "low"}
              decoding={index === 0 ? "sync" : "async"}
              class="hm-card-img"
            />
            <div class="hm-card-scrim" />

            <!-- Floating Top Badge Tag -->
            {item.badge && (
              <div class="hm-card-top-tag">
                <span class="hm-badge-pill">{item.badge}</span>
              </div>
            )}

            <!-- Floating Bottom Name & Flavour Highlights -->
            <div class="hm-card-bottom-tag">
              <div class="hm-card-titles">
                <div class="hm-card-name-row">
                  <h3 class="hm-card-name">{item.title}</h3>
                  <span class="hm-card-hindi">{item.hindiName}</span>
                </div>
                {item.desc && <p class="hm-card-desc">{item.desc}</p>}
              </div>

              <div class="hm-card-explore-pill">
                <span>View Snack &rarr;</span>
              </div>
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <!-- Subtle swipe dots & indicator -->
  <div class="hm-carousel-dots" id="hmCarouselDots" aria-hidden="true">
    <div class="hm-dots-row">
      {items.map((_, i) => (
        <span class={`hm-dot ${i === 0 ? "active" : ""}`} data-index={i}></span>
      ))}
    </div>
    <span class="hm-swipe-label">Swipe to explore {items.length} artisanal snacks &rarr;</span>
  </div>
</div>

<script is:inline>
  (() => {
    const track = document.getElementById("hmCarouselTrack");
    const dots = document.querySelectorAll(".hm-dot");
    if (!track || dots.length === 0) return;

    let ticking = false;
    track.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrollLeft = track.scrollLeft;
          const cardWidth = track.querySelector(".hm-card")?.offsetWidth || 280;
          const activeIndex = Math.min(
            dots.length - 1,
            Math.max(0, Math.round(scrollLeft / (cardWidth + 12)))
          );
          dots.forEach((dot, i) => {
            dot.classList.toggle("active", i === activeIndex);
          });
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  })();
</script>

<style>
  /* ── MOBILE CAROUSEL WRAPPER (Mobile-First) ─────────────── */
  .hm-carousel-wrapper {
    display: block;
    width: 100%;
    margin: 8px 0 14px 0;
    position: relative;
    user-select: none;
  }

  @media (min-width: 961px) {
    .hm-carousel-wrapper {
      display: none !important;
    }
  }

  /* ── SCROLL TRACK ──────────────────────────────────────── */
  .hm-carousel-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Hide standard scrollbar */
    padding: 2px 2px 6px 2px;
    margin: 0 -4px;
  }

  .hm-carousel-track::-webkit-scrollbar {
    display: none;
  }

  /* ── PRODUCT CARD ──────────────────────────────────────── */
  .hm-card {
    flex: 0 0 84%;
    max-width: 320px;
    min-width: 250px;
    scroll-snap-align: center;
    position: relative;
    text-decoration: none;
    color: inherit;
    border-radius: 18px;
    overflow: hidden;
    background: #1A0D05;
    border: 1.5px solid rgba(200, 147, 26, 0.32);
    box-shadow: none;
    transition: transform 0.25s ease, border-color 0.25s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .hm-card.is-featured {
    border-color: rgba(200, 147, 26, 0.65);
    box-shadow: none;
  }

  .hm-card:active {
    transform: scale(0.985);
  }

  /* ── CARD MEDIA ────────────────────────────────────────── */
  .hm-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .hm-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.04) brightness(1.02) saturate(1.06);
    transition: transform 0.4s ease;
  }

  .hm-card:hover .hm-card-img {
    transform: scale(1.04);
  }

  /* Remove dark gray shadow overlay from hero images */
  .hm-card-scrim {
    display: none;
  }

  /* ── TOP BADGE TAG ─────────────────────────────────────── */
  .hm-card-top-tag {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
  }

  .hm-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2.5px 8px;
    background: rgba(24, 8, 2, 0.85);
    border: 1px solid rgba(254, 240, 138, 0.35);
    border-radius: 999px;
    font-size: 9.5px;
    font-weight: 700;
    color: #FEF3C7;
    letter-spacing: 0.03em;
    box-shadow: none;
  }

  /* ── BOTTOM NAME & FLAVOUR HIGHLIGHTS ──────────────────── */
  .hm-card-bottom-tag {
    position: absolute;
    bottom: 6px;
    left: 6px;
    right: 6px;
    padding: 6px 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: rgba(26, 13, 5, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 10px;
    border: 1px solid rgba(200, 147, 26, 0.35);
  }

  .hm-card-titles {
    display: flex;
    flex-direction: column;
    gap: 1.5px;
    min-width: 0;
    flex: 1;
  }

  .hm-card-name-row {
    display: flex;
    align-items: baseline;
    gap: 5px;
    flex-wrap: wrap;
  }

  .hm-card-name {
    font-family: var(--B, "Plus Jakarta Sans", system-ui, -apple-system, sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: #FFFDF9;
    margin: 0;
    text-shadow: none;
  }

  .hm-card-hindi {
    font-size: 10px;
    font-weight: 600;
    color: #FCD34D;
    opacity: 0.92;
  }

  .hm-card-desc {
    font-size: 10px;
    color: rgba(253, 243, 227, 0.85);
    line-height: 1.2;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hm-card-explore-pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    background: rgba(200, 147, 26, 0.2);
    border: 1px solid rgba(254, 240, 138, 0.4);
    border-radius: 999px;
    font-size: 9.5px;
    font-weight: 700;
    color: #FFFDF9;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* ── CAROUSEL DOTS & HINT ──────────────────────────────── */
  .hm-carousel-dots {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2px 4px;
    margin-top: 4px;
  }

  .hm-dots-row {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .hm-dot {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: rgba(200, 147, 26, 0.28);
    transition: all 0.25s ease;
  }

  .hm-dot.active {
    width: 18px;
    background: var(--gold, #C8931A);
  }

  .hm-swipe-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted, #734503);
    letter-spacing: 0.02em;
    opacity: 0.85;
  }
</style>
