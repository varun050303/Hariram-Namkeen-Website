---
// HeroMobileCarousel.astro
// Visual-first interactive mobile product carousel for Hariram Namkeen Hero section
// Displays high-resolution snack photography with floating name tags and clickable product links.

const items = [
  {
    title: "The Special 4 Box",
    hindiName: "दिवाली स्पेशल बॉक्स",
    badge: "✦ Artisanal Tasting Platter",
    desc: "Sampler Box · Assorted Snacks",
    image: "/images/hariram_special_4_top_view.webp",
    link: "#hamper",
    featured: true,
  },
  {
    title: "Aloo Bhujia",
    hindiName: "आलू भुजिया",
    badge: "🥔 Crisp & Golden",
    desc: "Crispy potato & besan sev in pure mustard oil",
    image: "/images/aloo_bhujia.webp",
    link: "/products/aloo-bhujia/",
    featured: false,
  },
  {
    title: "Dal Biji",
    hindiName: "दाल बीजी",
    badge: "🏛️ Muzaffarnagar Classic",
    desc: "Crisp moong dal & magaz melon seeds",
    image: "/images/dal-bhiji.webp",
    link: "/products/dal-biji/",
    featured: false,
  },
  {
    title: "Masala Chana Dal",
    hindiName: "मसाला चना दाल",
    badge: "☕ Teatime Favourite",
    desc: "Split Bengal gram & tangy dried mango amchur",
    image: "/images/masala_chana_dal.webp",
    link: "/products/chana-dal/",
    featured: false,
  },
  {
    title: "Spicy Malka",
    hindiName: "स्पाइसी मलका",
    badge: "🔥 Whole Red Masoor",
    desc: "Whole red lentils & Kashmiri red chilli",
    image: "/images/masala_malka.webp",
    link: "/products/spicy-malka/",
    featured: false,
  },
  {
    title: "Shahi Dal Biji",
    hindiName: "शाही दाल बीजी",
    badge: "👑 Royal Blend",
    desc: "Whole cashews, Kishmish raisins & melon seeds",
    image: "/images/premium.webp",
    link: "/products/shahi-dal-biji/",
    featured: false,
  },
  {
    title: "Masala Moongfali",
    hindiName: "मसाला मूंगफली",
    badge: "🥜 Crunchy Peanuts",
    desc: "Slow-roasted peanuts with roasted spices",
    image: "/images/masala_moongfali.webp",
    link: "/products/masala-peanuts/",
    featured: false,
  },
];
---

<div class="hm-carousel-wrapper" id="hmCarouselWrapper" aria-label="Hariram Signature Namkeen Showcase">
  <!-- Swipeable Card Track -->
  <div class="hm-carousel-track" id="hmCarouselTrack" tabindex="0" role="region" aria-label="Snack products carousel">
    {
      items.map((item, index) => (
        <a
          href={item.link}
          class={`hm-card ${item.featured ? "is-featured" : ""}`}
          data-slide-index={index}
          aria-label={item.title}
        >
          <!-- Product Photography -->
          <div class="hm-card-media">
            <img
              src={item.image}
              alt={`${item.title} - Pure Mustard Oil Namkeen`}
              width="600"
              height="450"
              loading={index < 2 ? "eager" : "lazy"}
              class="hm-card-img"
            />
            <div class="hm-card-scrim" />

            <!-- Floating Top Badge Tag -->
            {item.badge && (
              <div class="hm-card-top-tag">
                <span class="hm-badge-pill">{item.badge}</span>
              </div>
            )}

            <!-- Floating Bottom Name & Flavour Highlights -->
            <div class="hm-card-bottom-tag">
              <div class="hm-card-titles">
                <div class="hm-card-name-row">
                  <h3 class="hm-card-name">{item.title}</h3>
                  <span class="hm-card-hindi">{item.hindiName}</span>
                </div>
                {item.desc && <p class="hm-card-desc">{item.desc}</p>}
              </div>

              <div class="hm-card-explore-pill">
                <span>{item.featured ? "Taste The Box" : "View Details"} &rarr;</span>
              </div>
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <!-- Subtle swipe dots & indicator -->
  <div class="hm-carousel-dots" id="hmCarouselDots" aria-hidden="true">
    <div class="hm-dots-row">
      {items.map((_, i) => (
        <span class={`hm-dot ${i === 0 ? "active" : ""}`} data-index={i}></span>
      ))}
    </div>
    <span class="hm-swipe-label">Swipe to explore 7 authentic snacks &rarr;</span>
  </div>
</div>

<script is:inline>
  (() => {
    const track = document.getElementById("hmCarouselTrack");
    const dots = document.querySelectorAll(".hm-dot");
    if (!track || dots.length === 0) return;

    let ticking = false;
    track.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrollLeft = track.scrollLeft;
          const cardWidth = track.querySelector(".hm-card")?.offsetWidth || 280;
          const activeIndex = Math.min(
            dots.length - 1,
            Math.max(0, Math.round(scrollLeft / (cardWidth + 12)))
          );
          dots.forEach((dot, i) => {
            dot.classList.toggle("active", i === activeIndex);
          });
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  })();
</script>

<style>
  /* ── MOBILE CAROUSEL WRAPPER ───────────────────────────── */
  .hm-carousel-wrapper {
    display: none; /* Shown only on mobile & tablet via media query */
    width: 100%;
    margin: 8px 0 14px 0;
    position: relative;
    user-select: none;
  }

  @media (max-width: 960px) {
    .hm-carousel-wrapper {
      display: block;
    }
  }

  /* ── SCROLL TRACK ──────────────────────────────────────── */
  .hm-carousel-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Hide standard scrollbar */
    padding: 2px 2px 6px 2px;
    margin: 0 -4px;
  }

  .hm-carousel-track::-webkit-scrollbar {
    display: none;
  }

  /* ── PRODUCT CARD ──────────────────────────────────────── */
  .hm-card {
    flex: 0 0 84%;
    max-width: 320px;
    min-width: 250px;
    scroll-snap-align: center;
    position: relative;
    text-decoration: none;
    color: inherit;
    border-radius: 18px;
    overflow: hidden;
    background: #1A0D05;
    border: 1.5px solid rgba(200, 147, 26, 0.32);
    box-shadow: 0 6px 20px rgba(35, 15, 6, 0.14);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .hm-card.is-featured {
    border-color: rgba(200, 147, 26, 0.65);
    box-shadow: 0 8px 26px rgba(117, 24, 24, 0.2);
  }

  .hm-card:active {
    transform: scale(0.985);
  }

  /* ── CARD MEDIA ────────────────────────────────────────── */
  .hm-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .hm-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.04) brightness(1.02) saturate(1.06);
    transition: transform 0.4s ease;
  }

  .hm-card:hover .hm-card-img {
    transform: scale(1.04);
  }

  /* Gradient scrim for perfect text contrast */
  .hm-card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(24, 8, 2, 0.2) 0%,
      rgba(24, 8, 2, 0.05) 30%,
      rgba(20, 7, 2, 0.65) 65%,
      rgba(15, 5, 1, 0.94) 100%
    );
    pointer-events: none;
  }

  /* ── TOP BADGE TAG ─────────────────────────────────────── */
  .hm-card-top-tag {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
  }

  .hm-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3.5px 10px;
    background: rgba(24, 8, 2, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(254, 240, 138, 0.35);
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
    color: #FEF3C7;
    letter-spacing: 0.02em;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  /* ── BOTTOM NAME & FLAVOUR HIGHLIGHTS ──────────────────── */
  .hm-card-bottom-tag {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 12px 14px 10px 14px;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
  }

  .hm-card-titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .hm-card-name-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }

  .hm-card-name {
    font-family: var(--F, "Playfair Display", serif);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.15;
    color: #FFFDF9;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  .hm-card-hindi {
    font-size: 11px;
    font-weight: 500;
    color: #FBBF24;
    opacity: 0.9;
  }

  .hm-card-desc {
    font-size: 11px;
    color: rgba(253, 243, 227, 0.9);
    line-height: 1.25;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hm-card-explore-pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    background: rgba(200, 147, 26, 0.2);
    border: 1px solid rgba(254, 240, 138, 0.4);
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
    color: #FFFDF9;
    letter-spacing: 0.02em;
    white-space: nowrap;
    backdrop-filter: blur(4px);
  }

  /* ── CAROUSEL DOTS & HINT ──────────────────────────────── */
  .hm-carousel-dots {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2px 4px;
    margin-top: 4px;
  }

  .hm-dots-row {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .hm-dot {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: rgba(200, 147, 26, 0.28);
    transition: all 0.25s ease;
  }

  .hm-dot.active {
    width: 18px;
    background: var(--gold, #C8931A);
  }

  .hm-swipe-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted, #734503);
    letter-spacing: 0.02em;
    opacity: 0.85;
  }
</style>
