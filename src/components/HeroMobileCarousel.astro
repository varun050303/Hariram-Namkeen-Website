---
// HeroMobileCarousel.astro
// Visual-first interactive mobile product carousel for Hariram Namkeen Hero section
// Displays high-resolution snack photography with floating name tags, prices, and clickable product links.

const items = [
  {
    title: "The Special 4 Box",
    hindiName: "दिवाली स्पेशल बॉक्स",
    badge: "💥 Diwali Dhamaka · 800g",
    price: "₹449",
    originalPrice: "₹499",
    desc: "4 Signature Snacks · Free Pan-India Delivery",
    image: "/images/hariram_special_4_top_view.webp",
    link: "#hamper",
    cta: "View Box →",
    featured: true,
  },
  {
    title: "Aloo Bhujia",
    hindiName: "आलू भुजिया",
    badge: "⭐ Best Seller",
    price: "₹125",
    desc: "Melt-in-mouth potato & besan sev in pure mustard oil",
    image: "/images/aloo_bhujia.webp",
    link: "/products/aloo-bhujia/",
    cta: "View Snack →",
  },
  {
    title: "Dal Biji",
    hindiName: "दाल बीजी",
    badge: "🏛️ Muzaffarnagar Classic",
    price: "₹125",
    desc: "Crisp moong dal & muskmelon magaz",
    image: "/images/dal-bhiji.webp",
    link: "/products/dal-biji/",
    cta: "View Snack →",
  },
  {
    title: "Masala Chana Dal",
    hindiName: "मसाला चना दाल",
    badge: "☕ Teatime Favorite",
    price: "₹125",
    desc: "Bold split Bengal gram with tangy amchur",
    image: "/images/masala_chana_dal.webp",
    link: "/products/chana-dal/",
    cta: "View Snack →",
  },
  {
    title: "Spicy Malka",
    hindiName: "स्पाइसी मलका",
    badge: "🔥 High Protein",
    price: "₹125",
    desc: "Whole red lentils dusted with Kashmiri mirch",
    image: "/images/masala_malka.webp",
    link: "/products/spicy-malka/",
    cta: "View Snack →",
  },
  {
    title: "Shahi Dal Biji",
    hindiName: "शाही दाल बीजी",
    badge: "👑 Royal Blend",
    price: "₹200",
    desc: "Whole cashews, golden raisins & dry coconut",
    image: "/images/premium.webp",
    link: "/products/shahi-dal-biji/",
    cta: "View Snack →",
  },
  {
    title: "Masala Moongfali",
    hindiName: "मसाला मूंगफली",
    badge: "🥜 Crunchy Peanuts",
    price: "₹120",
    desc: "Crisp roasted peanuts slow-fried in mustard oil",
    image: "/images/masala_moongfali.webp",
    link: "/products/masala-peanuts/",
    cta: "View Snack →",
  },
];
---

<div class="hm-carousel-wrapper" id="hmCarouselWrapper" aria-label="Hariram Signature Namkeen Showcase">
  <div class="hm-carousel-header">
    <div class="hm-carousel-title-row">
      <span class="hm-header-icon">🌿</span>
      <span class="hm-header-text">Our Pure Mustard Oil Favourites</span>
    </div>
    <span class="hm-swipe-hint">Swipe to explore &rarr;</span>
  </div>

  <!-- Swipeable Card Track -->
  <div class="hm-carousel-track" id="hmCarouselTrack" tabindex="0" role="region" aria-label="Snack products carousel">
    {
      items.map((item, index) => (
        <a
          href={item.link}
          class={`hm-card ${item.featured ? "is-featured" : ""}`}
          data-slide-index={index}
          aria-label={`${item.title} - ${item.price}`}
        >
          <!-- Product Photography -->
          <div class="hm-card-media">
            <img
              src={item.image}
              alt={`${item.title} - Pure Mustard Oil Namkeen`}
              width="600"
              height="450"
              loading={index < 2 ? "eager" : "lazy"}
              class="hm-card-img"
            />
            <div class="hm-card-scrim" />

            <!-- Floating Top Badge Tag -->
            <div class="hm-card-top-tag">
              <span class="hm-badge-pill">{item.badge}</span>
            </div>

            <!-- Floating Bottom Name & Price Tag -->
            <div class="hm-card-bottom-tag">
              <div class="hm-card-titles">
                <div class="hm-card-name-row">
                  <h3 class="hm-card-name">{item.title}</h3>
                  <span class="hm-card-hindi">{item.hindiName}</span>
                </div>
                <p class="hm-card-desc">{item.desc}</p>
              </div>

              <div class="hm-card-action-row">
                <div class="hm-card-price-wrap">
                  {item.originalPrice && (
                    <span class="hm-card-old-price">{item.originalPrice}</span>
                  )}
                  <span class="hm-card-price">{item.price}</span>
                </div>
                <span class="hm-card-btn">
                  {item.cta}
                </span>
              </div>
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <!-- Carousel Navigation Controls & Dots -->
  <div class="hm-carousel-controls">
    <button class="hm-nav-btn hm-prev" id="hmPrevBtn" aria-label="Previous snack">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
    </button>

    <div class="hm-dots" id="hmDots" role="tablist" aria-label="Slide dots">
      {
        items.map((_, i) => (
          <button
            class={`hm-dot ${i === 0 ? "active" : ""}`}
            data-dot-index={i}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-label={`Go to slide ${i + 1}`}
          />
        ))
      }
    </div>

    <button class="hm-nav-btn hm-next" id="hmNextBtn" aria-label="Next snack">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
</div>

<style>
  /* ── MOBILE CAROUSEL WRAPPER ───────────────────────────── */
  .hm-carousel-wrapper {
    display: none; /* Shown only on mobile & tablet via media query */
    width: 100%;
    margin: 8px 0 16px 0;
    position: relative;
    user-select: none;
  }

  @media (max-width: 960px) {
    .hm-carousel-wrapper {
      display: block;
    }
  }

  /* ── HEADER ROW ────────────────────────────────────────── */
  .hm-carousel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px;
    margin-bottom: 8px;
  }

  .hm-carousel-title-row {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: var(--maroon, #751818);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hm-header-icon {
    font-size: 13px;
  }

  .hm-swipe-hint {
    font-size: 11px;
    font-weight: 600;
    color: var(--gold, #C8931A);
    opacity: 0.9;
    letter-spacing: 0.01em;
  }

  /* ── SCROLL TRACK ──────────────────────────────────────── */
  .hm-carousel-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Hide standard scrollbar */
    padding: 4px 2px 10px 2px;
    margin: 0 -4px;
  }

  .hm-carousel-track::-webkit-scrollbar {
    display: none;
  }

  /* ── PRODUCT CARD ──────────────────────────────────────── */
  .hm-card {
    flex: 0 0 84%;
    max-width: 320px;
    min-width: 260px;
    scroll-snap-align: center;
    position: relative;
    text-decoration: none;
    color: inherit;
    border-radius: 18px;
    overflow: hidden;
    background: #1A0D05;
    border: 1.5px solid rgba(200, 147, 26, 0.28);
    box-shadow: 0 8px 24px rgba(35, 15, 6, 0.16);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .hm-card.is-featured {
    border-color: rgba(200, 147, 26, 0.65);
    box-shadow: 0 8px 28px rgba(117, 24, 24, 0.22);
  }

  .hm-card:active {
    transform: scale(0.985);
  }

  /* ── CARD MEDIA ────────────────────────────────────────── */
  .hm-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .hm-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.04) brightness(1.02) saturate(1.06);
    transition: transform 0.4s ease;
  }

  .hm-card:hover .hm-card-img {
    transform: scale(1.04);
  }

  /* Gradient scrim for perfect text contrast */
  .hm-card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(24, 8, 2, 0.2) 0%,
      rgba(24, 8, 2, 0.05) 30%,
      rgba(20, 7, 2, 0.65) 65%,
      rgba(15, 5, 1, 0.94) 100%
    );
    pointer-events: none;
  }

  /* ── TOP BADGE TAG ─────────────────────────────────────── */
  .hm-card-top-tag {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
  }

  .hm-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3.5px 9px;
    background: rgba(24, 8, 2, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(254, 240, 138, 0.35);
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
    color: #FEF3C7;
    letter-spacing: 0.02em;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  /* ── BOTTOM NAME & PRICE TAG ───────────────────────────── */
  .hm-card-bottom-tag {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 12px 14px 10px 14px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hm-card-titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hm-card-name-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hm-card-name {
    font-family: var(--F, "Playfair Display", serif);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.15;
    color: #FFFDF9;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  .hm-card-hindi {
    font-size: 11px;
    font-weight: 500;
    color: #FBBF24;
    opacity: 0.85;
  }

  .hm-card-desc {
    font-size: 11px;
    color: rgba(253, 243, 227, 0.82);
    line-height: 1.25;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── ACTION ROW: PRICE & BUTTON ────────────────────────── */
  .hm-card-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 2px;
  }

  .hm-card-price-wrap {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .hm-card-old-price {
    font-size: 12px;
    color: rgba(248, 113, 113, 0.9);
    text-decoration: line-through;
    font-weight: 600;
  }

  .hm-card-price {
    font-family: var(--F, "Playfair Display", serif);
    font-size: 1.25rem;
    font-weight: 800;
    color: #FDE047;
    text-shadow: 0 1px 6px rgba(245, 158, 11, 0.4);
    line-height: 1;
  }

  .hm-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 11px;
    background: linear-gradient(135deg, #751818 0%, #991B1B 100%);
    color: #FFFDF9;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    border-radius: 999px;
    border: 1px solid rgba(251, 191, 36, 0.45);
    box-shadow: 0 2px 8px rgba(117, 24, 24, 0.4);
    white-space: nowrap;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .hm-card:hover .hm-card-btn {
    background: linear-gradient(135deg, #8B1E1E 0%, #B91C1C 100%);
    transform: translateX(2px);
  }

  /* ── CONTROLS & PAGINATION ─────────────────────────────── */
  .hm-carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  .hm-nav-btn {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(200, 147, 26, 0.12);
    border: 1px solid rgba(200, 147, 26, 0.35);
    color: var(--maroon, #751818);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .hm-nav-btn:active {
    background: rgba(200, 147, 26, 0.28);
    transform: scale(0.92);
  }

  .hm-dots {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .hm-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgba(115, 69, 3, 0.22);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hm-dot.active {
    width: 18px;
    background: var(--gold, #C8931A);
    box-shadow: 0 1px 4px rgba(200, 147, 26, 0.4);
  }
</style>

<script is:inline>
  (() => {
    const track = document.getElementById("hmCarouselTrack");
    const prevBtn = document.getElementById("hmPrevBtn");
    const nextBtn = document.getElementById("hmNextBtn");
    const dots = document.querySelectorAll(".hm-dot");

    if (!track) return;

    const cards = track.querySelectorAll(".hm-card");
    if (cards.length === 0) return;

    const updateActiveDot = (activeIndex) => {
      dots.forEach((dot, idx) => {
        const isActive = idx === activeIndex;
        dot.classList.toggle("active", isActive);
        dot.setAttribute("aria-selected", isActive ? "true" : "false");
      });
    };

    // Scroll by card offset
    const scrollToIndex = (index) => {
      const targetCard = cards[index];
      if (targetCard) {
        const offsetLeft = targetCard.offsetLeft - (track.clientWidth - targetCard.clientWidth) / 2;
        track.scrollTo({ left: offsetLeft, behavior: "smooth" });
        updateActiveDot(index);
      }
    };

    // Next / Prev clicks
    let currentIndex = 0;

    nextBtn?.addEventListener("click", () => {
      currentIndex = (currentIndex + 1) % cards.length;
      scrollToIndex(currentIndex);
    });

    prevBtn?.addEventListener("click", () => {
      currentIndex = (currentIndex - 1 + cards.length) % cards.length;
      scrollToIndex(currentIndex);
    });

    // Dot clicks
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = parseInt(dot.getAttribute("data-dot-index") || "0", 10);
        currentIndex = idx;
        scrollToIndex(idx);
      });
    });

    // IntersectionObserver to sync active dot during user touch swipe
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const idx = parseInt(entry.target.getAttribute("data-slide-index") || "0", 10);
              currentIndex = idx;
              updateActiveDot(idx);
            }
          });
        },
        { root: track, threshold: 0.6 }
      );

      cards.forEach((card) => observer.observe(card));
    }

    // Optional gentle auto-scroll preview every 4s, pauses permanently once user touches track
    let autoScrollTimer = null;
    let userInteracted = false;

    const startAutoScroll = () => {
      if (userInteracted) return;
      autoScrollTimer = setInterval(() => {
        if (userInteracted) {
          clearInterval(autoScrollTimer);
          return;
        }
        currentIndex = (currentIndex + 1) % cards.length;
        scrollToIndex(currentIndex);
      }, 4200);
    };

    const stopAutoScroll = () => {
      userInteracted = true;
      if (autoScrollTimer) clearInterval(autoScrollTimer);
    };

    track.addEventListener("touchstart", stopAutoScroll, { passive: true });
    track.addEventListener("mousedown", stopAutoScroll);
    track.addEventListener("wheel", stopAutoScroll, { passive: true });

    startAutoScroll();
  })();
</script>
