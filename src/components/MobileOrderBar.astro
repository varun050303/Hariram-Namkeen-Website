---
// MobileOrderBar.astro — sticky bottom order bar, phones only (CSS shows it at <=768px).
// Appears once the hero button scrolls out of view; hides again on CTA banner and footer.
const waUrl =
  'https://wa.me/916396122920?text=Hi%2C%20I%20want%20to%20order%20Hariram%20Namkeen.%20My%20pincode%20is%20___.';
---

<div class="m-order-bar" id="m-order-bar">
  <div class="m-order-info">
    <div class="m-order-price-row">
      <span class="m-order-label">Starts at</span>
      <strong>₹200</strong>
      <span class="m-order-unit">/ 500g</span>
    </div>
    <span class="m-order-delivery">Free Delivery on First Order</span>
  </div>
  <a href={waUrl} target="_blank" rel="noopener noreferrer" class="m-order-btn" data-wa-click>Order on WhatsApp</a>
</div>

<script is:inline>
  (() => {
    const bar = document.getElementById('m-order-bar');
    const heroOffer = document.getElementById('h-offer-card') || document.getElementById('hero-cta');
    if (!bar || !heroOffer || !('IntersectionObserver' in window)) return;

    let heroVisible = true;
    const overlapping = new Set();

    const update = () => bar.classList.toggle('show', !heroVisible && overlapping.size === 0);

    new IntersectionObserver((entries) => {
      heroVisible = entries[0].isIntersecting;
      update();
    }, { threshold: 0.1 }).observe(heroOffer);

    const hideOver = [
      document.getElementById('hamper'),
      document.querySelector('.cta-section'),
      document.querySelector('footer'),
    ].filter(Boolean);

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? overlapping.add(e.target) : overlapping.delete(e.target)));
      update();
    });
    hideOver.forEach((el) => io.observe(el));
  })();
</script>
