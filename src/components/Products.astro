<script is:inline>
  // Touch screens have no hover: tap a product photo to open / close its ingredient list
  (() => {
    if (!window.matchMedia('(hover: none)').matches) return;
    document.querySelectorAll('.pcard-img').forEach((img) => {
      img.addEventListener('click', () => {
        img.closest('.pcard')?.classList.toggle('ing-open');
      });
    });
  })();
</script>

<style>
  .pcard-link {
    text-decoration: none;
    color: inherit;
    display: inline-block;
  }
  .pcard-link:hover h3 {
    color: var(--gold);
    transition: color 0.2s ease;
  }

  .pcard-tap-hint {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(26, 13, 5, 0.82);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(226, 158, 40, 0.45);
    color: #FAF5EB;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 3.5px 9px;
    border-radius: 99px;
    z-index: 4;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .pcard.ing-open .pcard-tap-hint,
  .pcard:hover .pcard-tap-hint {
    opacity: 0;
    transform: scale(0.92);
  }

  .products-delivery-strip {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    background: #FFFDF9;
    border: 1px solid rgba(194, 127, 21, 0.25);
    border-radius: 999px;
    padding: 8px 20px;
    margin-top: -24px;
    margin-bottom: 32px;
  }

  .pds-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .pds-pill {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--maroon);
    background: rgba(117, 24, 24, 0.06);
    border: 1px solid rgba(117, 24, 24, 0.16);
    padding: 2.5px 8px;
    border-radius: 99px;
    white-space: nowrap;
  }

  .pds-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }

  .pds-sub {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .pds-sep {
    color: var(--gold);
    font-size: 9px;
    opacity: 0.6;
    user-select: none;
  }

  @media (max-width: 768px) {
    .products-delivery-strip {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border-radius: 999px;
      padding: 7px 16px;
      margin-top: -24px;
      margin-bottom: 22px;
      width: fit-content;
      margin-left: auto;
      margin-right: auto;
      box-shadow: 0 2px 8px rgba(35, 15, 6, 0.04);
    }

    .pds-sep {
      display: none;
    }

    .pds-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .pds-pill {
      font-size: 10px;
      padding: 2.5px 7px;
    }

    .pds-label {
      font-size: 12.5px;
      line-height: 1.35;
    }
  }

  /* ── 1kg Mix & Match Custom Box (Concise Bento Grid) ── */
  .products-custom-box-banner {
    background: linear-gradient(135deg, #FFFDF8 0%, #FAF3E6 100%);
    border: 1px solid rgba(194, 127, 21, 0.28);
    border-radius: 16px;
    padding: 16px 20px 14px;
