</section>

<script is:inline>
  // 360° video toggle for Aloo Bhujia
  (() => {
    const card = document.getElementById('pcard-bhujia');
    if (!card) return;
    const badge = card.querySelector('.pcard-360-badge');
    const videoWrap = card.querySelector('.pcard-video-wrap');
    const video = videoWrap?.querySelector('video');
    if (!badge || !video) return;

    let active = false;
    badge.addEventListener('click', (e) => {
      e.stopPropagation();
      active = !active;
      if (active) {
        card.classList.add('video-active');
        video.play();
        badge.textContent = '✕ Close';
      } else {
        card.classList.remove('video-active');
        video.pause();
        badge.textContent = '360° View';
      }
    });
  })();
</script>
