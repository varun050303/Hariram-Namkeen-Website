---
import type { MarkdownInstance } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

interface BlogPostFrontmatter {
  title: string;
  description: string;
  pubDate: string | Date;
  slug: string;
  topic?: string;
  faq?: Array<{ q: string; a: string }>;
  [key: string]: any;
}

export type BlogPost = MarkdownInstance<BlogPostFrontmatter>;

export async function getStaticPaths() {
  const posts = import.meta.glob<BlogPost>('../../content/blog/*.md', { eager: true });
  return Object.values(posts).map((post) => ({
    params: { slug: post.frontmatter.slug },
    props: { post }
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props as Props;
const { Content } = post;

const canonicalURL = `https://hariramnamkeen.com/blog/${post.frontmatter.slug}/`;
const pageTitle = `${post.frontmatter.title} — Hariram Namkeen Blog`;
const pubDateISO = new Date(post.frontmatter.pubDate).toISOString();
---

<BaseLayout title={pageTitle} description={post.frontmatter.description}>
  <!-- Article Structured Data for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.frontmatter.title,
    "description": post.frontmatter.description,
    "url": canonicalURL,
    "datePublished": pubDateISO,
    "dateModified": pubDateISO,
    "author": {
      "@type": "Organization",
      "@id": "https://hariramnamkeen.com/#brand",
      "name": "Hariram Namkeen",
      "url": "https://hariramnamkeen.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Hariram Namkeen",
      "logo": {
        "@type": "ImageObject",
        "url": "https://hariramnamkeen.com/images/logo.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalURL
    },
    "inLanguage": "en-IN",
    "isPartOf": {
      "@type": "Blog",
      "@id": "https://hariramnamkeen.com/blog",
      "name": "Hariram Stories — Namkeen, Mustard Oil & Honest Food",
      "url": "https://hariramnamkeen.com/blog"
    }
  })} />

  <!-- BreadcrumbList Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://hariramnamkeen.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://hariramnamkeen.com/blog"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": post.frontmatter.title,
        "item": canonicalURL
      }
    ]
  })} />

  <Header />

  <main class="article">
    <div class="article-inner">
      <a href="/blog/" class="back-link">
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Stories
      </a>
      <header class="article-header">
        <div class="sec-tag"><span>✦</span> HARIRAM STORIES</div>
        <h1>{post.frontmatter.title}</h1>
        <p class="date">{new Date(post.frontmatter.pubDate).toLocaleDateString('en-IN', {dateStyle:'long'})}</p>
      </header>
      <article class="content"><Content /></article>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
.article {
  padding: 140px 0 100px;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
}

.article-inner {
  max-width: 780px;
  margin: 0 auto;
  padding: 0 var(--gutter);
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
  color: var(--gold);
  text-decoration: none;
  margin-bottom: 32px;
  transition: transform .2s, color .2s;
}

.back-link:hover {
  transform: translateX(-4px);
  color: var(--gold-l);
}

.article-header {
  margin-bottom: 48px;
  border-bottom: 1px solid rgba(212, 168, 67, 0.15);
  padding-bottom: 36px;
}

h1 {
  font-family: var(--F);
  font-size: clamp(34px, 5vw, 56px);
  font-weight: 400;
  line-height: 1.12;
  color: var(--text);
  margin: 16px 0 20px;
}

.date {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-muted);
}

.content {
  font-size: 17px;
  line-height: 1.85;
  color: var(--text-dim);
}

.content :global(h2) {
  font-family: var(--F);
  font-size: 28px;
  font-weight: 500;
  color: var(--text);
  margin: 48px 0 16px;
}

.content :global(h3) {
  font-family: var(--F);
  font-size: 22px;
  font-weight: 500;
  color: var(--gold-l);
  margin: 36px 0 12px;
}

.content :global(p) {
  margin-bottom: 24px;
}

.content :global(strong) {
  color: var(--text);
  font-weight: 600;
}

.content :global(ul), .content :global(ol) {
  margin-bottom: 24px;
  padding-left: 24px;
}

.content :global(li) {
  margin-bottom: 10px;
}

.content :global(blockquote) {
  border-left: 3px solid var(--gold);
  padding-left: 24px;
  margin: 36px 0;
  font-style: italic;
  font-family: var(--F);
  font-size: 20px;
  color: var(--text);
}
</style>
