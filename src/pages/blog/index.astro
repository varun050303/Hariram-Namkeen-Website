---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true }))
  .map((post) => post.frontmatter)
  .sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());
---

<BaseLayout>
  <main class="blog-page">
    <section>
      <h1>Hariram Stories</h1>
      <p>Traditional food stories, ingredients, and the thoughts behind our namkeen.</p>

      <div class="blog-grid">
        {posts.map((post) => (
          <article class="blog-card">
            <h2>{post.title}</h2>
            <p>{post.description}</p>
            <a href={`/blog/${post.slug}`}>Read article →</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
