---
import type { MarkdownInstance } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

interface BlogPostFrontmatter {
  title: string;
  description: string;
  pubDate: string | Date;
  slug: string;
  topic?: string;
  faq?: Array<{ q?: string; a?: string; question?: string; answer?: string }>;
  [key: string]: any;
}

const posts = Object.values(import.meta.glob<MarkdownInstance<BlogPostFrontmatter>>('../../content/blog/*.md', { eager: true }))
  .map((post) => post.frontmatter)
  .sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());
---

<BaseLayout title="Stories & Craft — Hariram Namkeen" description="Stories behind our namkeen, pure mustard oil traditions, and authentic recipes from Muzaffarnagar." keywords="healthy namkeen guide, mustard oil namkeen stories, namkeen without palm oil, palmolein oil vs mustard oil, clean label indian snacks, diwali corporate gifting snacks, small batch namkeen, muzaffarnagar snacks">
  <!-- Blog Collection Structured Data for Google & AI Engines -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://hariramnamkeen.com/blog/",
    "name": "Hariram Stories — Namkeen, Mustard Oil & Honest Food",
    "description": "Stories behind our namkeen, pure mustard oil traditions, and authentic recipes from Muzaffarnagar.",
    "url": "https://hariramnamkeen.com/blog/",
    "publisher": {
      "@type": "Organization",
      "@id": "https://hariramnamkeen.com/#brand",
      "name": "Hariram Namkeen"
    },
    "blogPost": posts.map((post: any) => ({
      "@type": "BlogPosting",
      "headline": post.title,
      "description": post.description,
      "url": `https://hariramnamkeen.com/blog/${post.slug}/`,
      "datePublished": new Date(post.pubDate).toISOString(),
      "author": {
        "@type": "Organization",
        "name": "Hariram Namkeen"
      }
    }))
  })} />

  <!-- BreadcrumbList Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://hariramnamkeen.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Stories",
        "item": "https://hariramnamkeen.com/blog/"
      }
    ]
  })} />

  <Header />
  <main class="blog-page">
    <div class="blog-page-inner">
      <section class="blog-hero">
        <div class="sec-tag"><span>✦</span> HARIRAM STORIES</div>
        <h1>Tradition, Ingredients<br/><em>&amp; Honest Food.</em></h1>
        <p class="intro">The philosophy behind our craft, our insistence on pure yellow mustard oil, and the heritage that shapes every batch in our Muzaffarnagar kitchen.</p>
      </section>

      <section class="blog-grid">
        {posts.map((post) => (
          <article class="blog-card" data-tilt>
            <div class="top-line"></div>
            <div class="card-body">
              <span class="date">{new Date(post.pubDate).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              <h2>{post.title}</h2>
              <p>{post.description}</p>
              <a href={`/blog/${post.slug}/`} class="read-link">
                Read story
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
.blog-page {
  min-height: 100vh;
  padding: 140px 0 100px;
  background: var(--bg);
  color: var(--text);
  position: relative;
}

.blog-page-inner {
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 var(--gutter);
}

.blog-hero {
  max-width: 800px;
  margin-bottom: 64px;
}

.blog-hero h1 {
  font-family: var(--F);
  font-size: clamp(38px, 5vw, 64px);
  font-weight: 400;
  line-height: 1.08;
  color: var(--text);
  margin: 16px 0 24px;
}

.blog-hero h1 em {
  font-style: italic;
  color: var(--gold);
}

.intro {
  font-size: 16px;
  line-height: 1.7;
  color: var(--text-dim);
  max-width: 600px;
}

.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: 32px;
}

.blog-card {
  background: var(--bg-card);
  border: 1px solid rgba(212, 168, 67, 0.08);
  border-radius: 20px;
  overflow: hidden;
  transition: transform .4s var(--ease-out), border-color .3s, box-shadow .4s;
  display: flex;
  flex-direction: column;
}

.blog-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 40px rgba(117, 24, 24, 0.1), 0 0 24px rgba(194, 127, 21, 0.12);
}

.top-line {
  height: 4px;
  background: linear-gradient(90deg, var(--gold-d), var(--gold-l));
}

.card-body {
  padding: 36px 32px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.date {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 12px;
}

h2 {
  font-family: var(--F);
  font-size: 24px;
  font-weight: 500;
  line-height: 1.3;
  color: var(--text);
  margin-bottom: 14px;
}

.card-body p {
  font-size: 14px;
  line-height: 1.65;
  color: var(--text-dim);
  margin-bottom: 24px;
  flex: 1;
}

.read-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
  color: var(--gold-l);
  text-decoration: none;
  transition: gap .2s, color .2s;
}

.read-link:hover {
  color: var(--gold);
  gap: 12px;
}

@media (max-width: 768px) {
  .blog-page {
    padding: 100px 0 60px;
  }
  .blog-grid {
    grid-template-columns: 1fr;
  }
}
</style>
