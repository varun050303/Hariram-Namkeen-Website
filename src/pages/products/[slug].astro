<script is:inline define:vars={{ buyBoxCfg }}>
  (() => {
    const radioInputs = document.querySelectorAll('input[name="pack-choice"]');
    const optBox = document.getElementById('opt-box');
    const optSingle = document.getElementById('opt-single');
    const ctaButton = document.getElementById('prod-main-cta');
    const ctaLabel = document.getElementById('prod-cta-label');
    const stickyBar = document.getElementById('prod-sticky-bar');
    const stickyBtn = document.getElementById('prod-sticky-btn');
    const stickyPrice = document.getElementById('sticky-price-text');
    const stickyNote = document.getElementById('sticky-note-text');

    function getSelectedOption() {
      const checked = document.querySelector('input[name="pack-choice"]:checked');
      return checked && checked.value === 'single' ? buyBoxCfg.single : buyBoxCfg.box;
    }

    function updateBuyBoxUI() {
      const current = getSelectedOption();
      const isBox = current === buyBoxCfg.box;

      if (optBox) optBox.classList.toggle('is-active', isBox);
      if (optSingle) optSingle.classList.toggle('is-active', !isBox);

      if (ctaLabel) ctaLabel.textContent = current.cta;
      if (stickyPrice) stickyPrice.textContent = current.stickyPrice;
      if (stickyNote) stickyNote.textContent = current.stickyNote;
    }

    function executeOrder(source) {
      const current = getSelectedOption();
      if (typeof window.triggerHariramOrder === 'function') {
        window.triggerHariramOrder({
          item: current.item,
          price: current.price,
          shipping: current.shipping,
          source: source || 'product_page',
        });
      }
    }

    radioInputs.forEach((r) => r.addEventListener('change', updateBuyBoxUI));

    if (ctaButton) {
      ctaButton.addEventListener('click', () => executeOrder('product_page_buybox'));
    }

    if (stickyBtn) {
      stickyBtn.addEventListener('click', () => executeOrder('product_page_sticky_bar'));
    }

    // Initialize UI state
    updateBuyBoxUI();

    // Show sticky mobile bar when main CTA scrolls out of view
    if (stickyBar && ctaButton && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          stickyBar.classList.toggle('is-visible', !entries[0].isIntersecting);
        },
        { threshold: 0 }
      );
      observer.observe(ctaButton);
    } else if (stickyBar) {
      stickyBar.classList.add('is-visible');
    }
  })();
</script>

