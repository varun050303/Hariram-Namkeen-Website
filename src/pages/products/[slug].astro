---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import QuickViewModal from '../../components/QuickViewModal.astro';
import { products, boxProducts, BOX_OFFER, type Product } from '../../data/products';
import '../../styles/global.css';

export async function getStaticPaths() {
  const paths: { params: { slug: string }; props: { product: Product } }[] = [];

  for (const product of products) {
    paths.push({ params: { slug: product.slug }, props: { product } });

    // Backward-compatible alias paths to prevent 404s on existing search engine indexes & internal links
    if (product.slug === 'dal-biji') {
      paths.push({ params: { slug: 'dal-bhiji' }, props: { product } });
    }
    if (product.slug === 'chana-dal') {
      paths.push({ params: { slug: 'masala-chana-dal' }, props: { product } });
    }
    if (product.slug === 'shahi-dal-biji') {
      paths.push({ params: { slug: 'shahi-dal-bhiji' }, props: { product } });
    }
  }

  return paths;
}

const { product } = Astro.props as { product: Product };

// ── SEO & Canonical Data ──────────────────────────────────────────────────
const canonicalURL = `https://hariramnamkeen.com/products/${product.slug}/`;
const shareImage = product.image.startsWith('http')
  ? product.image
  : `https://hariramnamkeen.com${product.image}`;

const ship = BOX_OFFER.singleShipping;
const singleTotal = product.priceSingle + ship;
const lowPrice = Math.min(product.priceSingle, BOX_OFFER.price);
const highPrice = Math.max(product.priceSingle, BOX_OFFER.price);

const pageTitle = `Buy ${product.name} (${product.hindiName}) Online — Pure Yellow Mustard Oil Namkeen | Hariram`;
const pageDescription = `Order artisanal ${product.name} crafted in 100% cold-pressed yellow mustard oil with zero palm oil and zero TBHQ. ₹${product.priceSingle} single pack or ₹${BOX_OFFER.price} Special 4 Tasting Box with Free Pan-India Delivery.`;

const productKeywords = [
  `buy ${product.shortName.toLowerCase()} online`,
  `${product.shortName.toLowerCase()} without palm oil`,
  `${product.shortName.toLowerCase()} mustard oil`,
  product.name.toLowerCase(),
  product.hindiName,
  'mustard oil namkeen',
  'yellow mustard oil namkeen',
  'healthy namkeen without palm oil',
  'satvik namkeen without onion garlic',
  'clean label snacks india',
  'muzaffarnagar namkeen',
  'hariram namkeen',
].join(', ');

// ── Order Payloads for Margin-Protecting Buy Box & Mobile Bar ─────────────
const boxItem = product.inBox
  ? `${BOX_OFFER.name} (${BOX_OFFER.weight}) — incl. ${product.name}`
  : `${BOX_OFFER.name} (${BOX_OFFER.weight}) + ${product.name}`;

const buyBoxCfg = {
  box: {
    item: boxItem,
    price: BOX_OFFER.price,
    shipping: BOX_OFFER.shipping,
    cta: `Get The Special 4 Box · ₹${BOX_OFFER.price} (Free Delivery)`,
    stickyPrice: `₹${BOX_OFFER.price}`,
    stickyNote: 'The Special 4 Box (800g) · Free Pan-India Delivery',
  },
  single: {
    item: `${product.name} (${product.weightSingle}) — Single Pack`,
    price: product.priceSingle,
    shipping: ship,
    cta: `Order Single ${product.weightSingle} Pack · ₹${singleTotal}`,
    stickyPrice: `₹${singleTotal}`,
    stickyNote: `Single ${product.weightSingle} Pack · ₹${product.priceSingle} + ₹${ship} Shipping`,
  },
};

// ── Nutritional Table Rows ────────────────────────────────────────────────
const n = product.nutritionPer100g;
const f1 = (val: number) => (Math.round(val * 10) / 10).toFixed(1);

const nutritionRows = [
  { label: 'Energy (Calories)', value: `${Math.round(n.energyKcal)} kcal`, tone: 'default' },
  { label: 'Protein', value: `${f1(n.proteinG)} g`, tone: 'default' },
  { label: 'Carbohydrate', value: `${f1(n.carbsG)} g`, tone: 'default' },
  { label: 'of which Natural Sugars', value: `${f1(n.sugarsG)} g`, isSub: true, tone: 'default' },
  { label: 'Total Fat', value: `${f1(n.totalFatG)} g`, tone: 'default' },
  { label: 'of which Saturated Fatty Acids', value: `${f1(n.saturatedFatG)} g`, isSub: true, tone: 'default' },
  {
    label: 'Monounsaturated Fatty Acids (MUFA)',
    value: `${f1(n.mufaFatG)} g`,
    tone: 'amber',
    note: 'Heart-Healthy Fats from 100% Kachi Ghani Yellow Mustard Oil',
  },
  { label: 'Trans Fat', value: `${f1(n.transFatG)} g`, tone: 'emerald', note: '0.0g Trans Fat Guarantee' },
  { label: 'Cholesterol', value: `${f1(n.cholesterolMg)} mg`, tone: 'emerald', note: 'Zero Cholesterol' },
  { label: 'Sodium', value: `${Math.round(n.sodiumMg)} mg`, tone: 'default' },
];

// ── 3-Metric Showcase Badges ──────────────────────────────────────────────
const metrics = [
  { v: '0%', l: 'Palm Oil' },
  { v: `${f1(n.proteinG)}g`, l: 'Protein / 100g' },
  { v: `${f1(n.transFatG)}g`, l: 'Trans Fat' },
];

// ── 4 Clean-Label Trust Badges with SVG Icons ────────────────────────────
const trustBadges = [
  {
    title: '100% Satvik (No Onion / No Garlic)',
    desc: 'Pure Vedic preparation suited for puja, fasting, and clean household dining.',
    iconSvg: `<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-6h2v6zm4 0h-2v-6h2v6zm-2-8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>`,
  },
  {
    title: 'Real Hing & Rock Salt (Sendha/Kala Namak)',
    desc: 'Aids digestive ease with zero post-snacking bloating or burning.',
    iconSvg: `<path d="M12 3l1.8 4.2 4.5.4-3.4 3 1 4.5L12 13l-3.9 2.1 1-4.5-3.4-3 4.5-.4z"/>`,
  },
  {
    title: '0% Palm Oil & 0% Commercial Pre-Mix Masala',
    desc: 'No chemical blends, no synthetic flavor enhancers, no TBHQ preservatives.',
    iconSvg: `<circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>`,
  },
  {
    title: 'Small-Batch Hand-Fried in Heavy Iron Kadhais',
    desc: 'FSSAI Lic. No. 22725393001461. Hand-crafted daily in Muzaffarnagar, UP.',
    iconSvg: `<path d="M4 19h16M7 19v-3a5 5 0 0 1 10 0v3M12 5v4m-3-2h6"/>`,
  },
];

// ── Cross-Sell Items (The other signature snacks in the box) ──────────────
const crossSell = boxProducts.filter((p) => p.slug !== product.slug).slice(0, 3);

// ── Schema.org Structured Data ───────────────────────────────────────────
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${product.name} (${product.hindiName})`,
  image: [shareImage],
  description: `${product.shortDesc} ${product.longDesc}`,
  sku: `HN-${product.slug.toUpperCase()}`,
  keywords: productKeywords,
  brand: {
    '@type': 'Brand',
    name: 'Hariram Namkeen',
  },
  manufacturer: {
    '@type': 'Organization',
    name: 'Hariram Namkeen',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Muzaffarnagar',
      addressRegion: 'Uttar Pradesh',
      addressCountry: 'IN',
    },
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'INR',
    lowPrice: String(lowPrice),
    highPrice: String(highPrice),
    offerCount: 2,
    availability: 'https://schema.org/InStock',
    offers: [
      {
        '@type': 'Offer',
        name: `${product.name} — Single ${product.weightSingle} Pack`,
        price: String(product.priceSingle),
        priceCurrency: 'INR',
        availability: 'https://schema.org/InStock',
        url: canonicalURL,
      },
      {
        '@type': 'Offer',
        name: `${BOX_OFFER.name} (${BOX_OFFER.weight}) — Free Delivery`,
        price: String(BOX_OFFER.price),
        priceCurrency: 'INR',
        availability: 'https://schema.org/InStock',
        url: canonicalURL,
      },
    ],
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Cooking Medium', value: '100% Yellow Mustard Oil' },
    { '@type': 'PropertyValue', name: 'Palm Oil', value: '0%' },
    { '@type': 'PropertyValue', name: 'Preservatives', value: '0% (TBHQ Free)' },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hariramnamkeen.com/' },
    { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://hariramnamkeen.com/#products' },
    { '@type': 'ListItem', position: 3, name: product.name, item: canonicalURL },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={product.image}
  keywords={productKeywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />

  <main class="prod-page">
    <!-- Top Urgency Bar -->
    <aside class="prod-urgency-bar" aria-label="Fresh Batch Notification">
      <div class="prod-urgency-content">
        <span class="prod-urgency-item">
          <span class="prod-pulse-dot" aria-hidden="true"></span>
          Fresh Festive Batches Frying in Muzaffarnagar
        </span>
        <span class="prod-urgency-sep" aria-hidden="true">•</span>
        <span class="prod-urgency-item">100% Satvik (No Onion / No Garlic)</span>
        <span class="prod-urgency-sep" aria-hidden="true">•</span>
        <span class="prod-urgency-item">Free Pan-India Delivery on ₹{BOX_OFFER.price} Tasting Boxes</span>
      </div>
    </aside>

    <div class="prod-container">
      <!-- Breadcrumb Navigation -->
      <nav class="prod-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="prod-crumb-sep">/</span>
        <a href="/#products">Artisanal Snacks</a>
        <span class="prod-crumb-sep">/</span>
        <span class="prod-crumb-current" aria-current="page">{product.name}</span>
      </nav>

      <!-- ═══════════ ABOVE-THE-FOLD GRID (6 + 6 Columns) ═══════════ -->
      <section class="prod-hero-grid">
        <!-- LEFT 6 COLS: Showcase Card + Centerpiece + Metrics + Trust Badges -->
        <div class="prod-showcase-col">
          <!-- Mobile Header (Visible only on <900px screens so buyer immediately sees product name & tags) -->
          <div class="prod-header-mobile">
            <div class="prod-kicker">
              <span class="prod-sparkle">✦</span>
              <span>100% Cold-Pressed Yellow Mustard Oil · Muzaffarnagar Craft</span>
            </div>
            <h1 class="prod-heading font-serif-editorial">{product.name}</h1>
            <div class="prod-mobile-tags">
              <span class="prod-badge-hindi" lang="hi">{product.hindiName}</span>
              {product.badge && <span class="prod-badge-tag">{product.badge}</span>}
            </div>
            <p class="prod-tagline">{product.tagline}</p>
          </div>

          <div class="prod-card-stage">
            <div class="prod-card-top-badges">
              <span class="prod-badge-hindi" lang="hi">{product.hindiName}</span>
              {product.badge && <span class="prod-badge-tag">{product.badge}</span>}
            </div>

            <!-- Tactile Centerpiece Container -->
            <div class="prod-visual-wrap">
              <img
                src={product.image}
                alt={`${product.name} handcrafted in pure yellow mustard oil`}
                width="800"
                height="600"
                class="prod-main-img"
                loading="eager"
                fetchpriority="high"
              />
            </div>

            <!-- 3-Metric Proof Bar -->
            <div class="prod-metrics-strip" role="list" aria-label="Key Nutrition Metrics">
              {metrics.map((m) => (
                <div class="prod-metric-box" role="listitem">
                  <strong class="prod-metric-val">{m.v}</strong>
                  <span class="prod-metric-lbl">{m.l}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- 4 Clean-Label Satvik / Digestive Trust Badges (Desktop Only Here) -->
          <div class="prod-trust-list prod-trust-list--desktop">
            {trustBadges.map((badge) => (
              <div class="prod-trust-card">
                <div class="prod-trust-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={badge.iconSvg} />
                </div>
                <div class="prod-trust-texts">
                  <h4 class="prod-trust-title">{badge.title}</h4>
                  <p class="prod-trust-desc">{badge.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- RIGHT 6 COLS: Product Story + Margin-Protecting Upsell Buy Box -->
        <div class="prod-details-col">
          <!-- Desktop Header (Visible only on ≥900px screens) -->
          <div class="prod-header-desktop">
            <div class="prod-kicker">
              <span class="prod-sparkle">✦</span>
              <span>100% Cold-Pressed Yellow Mustard Oil · Muzaffarnagar Craft</span>
            </div>

            <h1 class="prod-heading font-serif-editorial">{product.name}</h1>
            <p class="prod-hindi-title" lang="hi">{product.hindiName}</p>
            <p class="prod-tagline">{product.tagline}</p>
          </div>

          <div class="prod-story-box">
            <p class="prod-story-text">{product.longDesc}</p>
            <div class="prod-taste-note">
              <strong>Taste & Texture:</strong> {product.tasteProfile}
            </div>
          </div>

          <!-- ── MARGIN-PROTECTING UPSELL BUY BOX ── -->
          <fieldset class="prod-buybox" id="prod-buybox" aria-labelledby="buybox-legend">
            <legend class="prod-buybox-legend" id="buybox-legend">
              Select Package Configuration
            </legend>

            <!-- Option A: The Special 4 Tasting Box (DEFAULT & RECOMMENDED) -->
            <label class="prod-option-card is-active" id="opt-box" for="radio-pack-box">
              <input
                type="radio"
                id="radio-pack-box"
                name="pack-choice"
                value="box"
                checked
                class="prod-radio-input"
              />
              <span class="prod-custom-radio" aria-hidden="true"></span>

              <div class="prod-option-main">
                <div class="prod-option-pills">
                  <span class="prod-pill-diwali">💥 Diwali offer</span>
                  <span class="prod-pill-savings">Save ₹50</span>
                </div>
                <span class="prod-option-title">Get in The Special 4 Tasting Box (800g)</span>
                <span class="prod-option-sub">
                  Includes {product.name} + 3 other signature snacks (4 × 200g pouches)
                </span>
              </div>

              <div class="prod-option-pricing">
                <div class="prod-dual-price">
                  <span class="prod-price-struck">₹{BOX_OFFER.originalPrice || 499}</span>
                  <span class="prod-option-price">₹{BOX_OFFER.price}</span>
                </div>
                <span class="prod-option-shipping prod-shipping-free">FREE Pan-India Delivery</span>
              </div>
            </label>

            <!-- Option B: Single 200g Pack Only -->
            <label class="prod-option-card" id="opt-single" for="radio-pack-single">
              <input
                type="radio"
                id="radio-pack-single"
                name="pack-choice"
                value="single"
                class="prod-radio-input"
              />
              <span class="prod-custom-radio" aria-hidden="true"></span>

              <div class="prod-option-main">
                <span class="prod-option-title">Single {product.weightSingle} Pack Only</span>
                <span class="prod-option-sub">
                  + ₹{ship} Standard Shipping = ₹{singleTotal} Total Delivered
                </span>
              </div>

              <div class="prod-option-pricing">
                <span class="prod-option-price">₹{product.priceSingle}</span>
                <span class="prod-option-shipping">+ ₹{ship} Shipping</span>
              </div>
            </label>

            <!-- Primary Action CTA Button -->
            <button type="button" class="prod-cta-button" id="prod-main-cta">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span id="prod-cta-label">{buyBoxCfg.box.cta}</span>
            </button>

            <div class="prod-buybox-footer">
              <span>✦ Direct from Kadhai to Pouch</span>
              <span>•</span>
              <span>Fresh Batch Dispatched via Express Courier</span>
            </div>
          </fieldset>

          <!-- 4 Clean-Label Satvik / Digestive Trust Badges (Mobile Clean Grid Below Buy Box) -->
          <div class="prod-trust-list prod-trust-list--mobile">
            {trustBadges.map((badge) => (
              <div class="prod-trust-card">
                <div class="prod-trust-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={badge.iconSvg} />
                </div>
                <div class="prod-trust-texts">
                  <h4 class="prod-trust-title">{badge.title}</h4>
                  <p class="prod-trust-desc">{badge.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ═══════════ BELOW-THE-FOLD TRANSPARENCY (7 + 5 Cols) ═══════════ -->
      <section class="prod-transparency-grid" aria-labelledby="transparency-heading">
        <!-- LEFT 7 COLS: 4-Tier Clean Ingredient Breakdown -->
        <div class="prod-ingredients-col">
          <div class="prod-kicker">
            <span class="prod-sparkle">✦</span>
            <span>Radical Transparency</span>
          </div>
          <h2 class="prod-section-heading font-serif-editorial" id="transparency-heading">
            Exactly What Goes Inside This Pack
          </h2>
          <p class="prod-section-sub">
            We hold ourselves to pure culinary honesty. No hidden chemical codes, no ambiguous "edible vegetable oil" blends, and no factory syrups.
          </p>

          <div class="prod-tiers-container">
            <!-- Tier 1 -->
            <div class="prod-tier-item">
              <div class="prod-tier-badge">1</div>
              <div class="prod-tier-body">
                <h3 class="prod-tier-title">Primary Base</h3>
                <p class="prod-tier-text">{product.ingredients.base}</p>
              </div>
            </div>

            <!-- Tier 2 -->
            <div class="prod-tier-item prod-tier-item--highlight">
              <div class="prod-tier-badge prod-tier-badge--amber">2</div>
              <div class="prod-tier-body">
                <h3 class="prod-tier-title">Frying Medium: 100% Cold-Pressed Yellow Sarson</h3>
                <p class="prod-tier-text">
                  <strong>{product.ingredients.oil}</strong>. Extracted without extreme heat or solvent chemicals. Pure Kachi Ghani richness with zero palm oil and zero cottonseed oil.
                </p>
              </div>
            </div>

            <!-- Tier 3 -->
            <div class="prod-tier-item">
              <div class="prod-tier-badge">3</div>
              <div class="prod-tier-body">
                <h3 class="prod-tier-title">In-House Stone-Ground Spices</h3>
                <p class="prod-tier-text">{product.ingredients.spices}</p>
              </div>
            </div>

            <!-- Tier 4 -->
            <div class="prod-tier-item prod-tier-item--excluded">
              <div class="prod-tier-badge prod-tier-badge--red">4</div>
              <div class="prod-tier-body">
                <h3 class="prod-tier-title">Strictly Excluded (0% Tolerance)</h3>
                <div class="prod-chips-list">
                  {product.ingredients.noNasties.map((nastie) => (
                    <span class="prod-chip">✕ {nastie}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT 5 COLS: Bold Bordered Nutritional Information Table -->
        <aside class="prod-nutrition-col" aria-labelledby="nutrition-table-heading">
          <div class="prod-nutrition-card">
            <header class="prod-nutrition-head">
              <h2 class="prod-nutrition-heading font-serif-editorial" id="nutrition-table-heading">
                Nutritional Information
              </h2>
              <span class="prod-nutrition-basis">Values measured per 100g serving</span>
            </header>

            <table class="prod-nutri-table">
              <thead>
                <tr>
                  <th scope="col">Nutrient Metric</th>
                  <th scope="col" class="prod-text-right">Per 100g</th>
                </tr>
              </thead>
              <tbody>
                {nutritionRows.map((row) => (
                  <tr class={`prod-row-${row.tone} ${row.isSub ? 'prod-row-sub' : ''}`}>
                    <th scope="row">
                      <span class="prod-row-label">{row.label}</span>
                      {row.note && <small class="prod-row-note">{row.note}</small>}
                    </th>
                    <td class="prod-text-right">
                      <strong class="prod-row-val">{row.value}</strong>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>

            <footer class="prod-nutrition-footer">
              <div class="prod-veg-indicator">
                <span class="prod-veg-box">
                  <span class="prod-veg-circle"></span>
                </span>
                <span><strong>100% Pure Vegetarian</strong></span>
              </div>
              <span class="prod-fssai-lic">FSSAI Lic. No. 22725393001461</span>
            </footer>
          </div>
        </aside>
      </section>

      <!-- ═══════════ CROSS-SELL SECTION ═══════════ -->
      <section class="prod-cross-section" aria-labelledby="cross-sell-heading">
        <div class="prod-cross-header">
          <div class="prod-kicker">
            <span class="prod-sparkle">✦</span>
            <span>Inside The Special 4 Box</span>
          </div>
          <h2 class="prod-section-heading font-serif-editorial" id="cross-sell-heading">
            Also Inside The Special 4 Tasting Box
          </h2>
          <p class="prod-section-sub">
            Sample the four authentic culinary traditions of Western UP in one 800g box with Free Pan-India Delivery.
          </p>
        </div>

        <div class="prod-cross-grid">
          {crossSell.map((item) => (
            <article class="prod-cross-card">
