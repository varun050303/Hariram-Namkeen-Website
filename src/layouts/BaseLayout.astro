---
// BaseLayout.astro — v2 Dark Luxury Editorial
// Wraps every page with <html>, <head>, fonts, GSAP CDN.

const {
  title = "Hariram Namkeen — Pure Mustard Oil Snacks, Muzaffarnagar",
  description = "Traditional namkeen from Muzaffarnagar. Pure yellow mustard oil. No preservatives. FSSAI licensed.",
  image = "/images/hariram_special_4_top_view.webp",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://hariramnamkeen.com');
const ogImageURL = new URL(image, Astro.site || 'https://hariramnamkeen.com');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/png" href="/images/logo.png" />

  <!-- Local SEO Geotags: Muzaffarnagar, Uttar Pradesh -->
  <meta name="geo.region" content="IN-UP" />
  <meta name="geo.placename" content="Muzaffarnagar" />
  <meta name="geo.position" content="29.4727;77.7085" />
  <meta name="ICBM" content="29.4727, 77.7085" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Fonts: Optimized and preloaded for minimal CLS -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Preload Critical LCP Hero Image for Instant Mobile Paint -->
  <link
    rel="preload"
    as="image"
    type="image/webp"
    href="/images/aloo_bhujia.webp"
    fetchpriority="high"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </noscript>

  <!-- Critical Above-the-Fold Layout (Instant reserved space, prevents Frame 0 height:0 CLS) -->
  <style is:inline>
    @font-face {
      font-family: 'Playfair Display Fallback';
      src: local('Georgia');
      ascent-override: 95%;
      descent-override: 25%;
      line-gap-override: 0%;
      size-adjust: 104%;
    }
    #header { position: fixed; top: 0; left: 0; right: 0; z-index: 500; height: 76px; }
    .hero {
      min-height: calc(100vh - 72px);
      min-height: calc(100dvh - 72px);
      position: relative;
      background: #FAF5EB;
      padding: 84px clamp(20px, 4vw, 48px) 48px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 48px;
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      position: relative;
      z-index: 2;
      min-height: 540px;
    }
    .hero-headline {
      font-family: 'Playfair Display', 'Playfair Display Fallback', Georgia, serif;
      font-size: clamp(38px, 4.2vw, 56px);
      line-height: 1.15;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .hero-visual { min-height: 540px; width: 100%; display: flex; align-items: center; justify-content: center; }
    .hero-carousel-card { position: relative; width: 100%; max-width: 600px; height: 540px; }
    @media (max-width: 1024px) {
      .hero { min-height: auto; padding-top: 84px; padding-bottom: 36px; }
      .hero-inner { grid-template-columns: 1fr; gap: 32px; min-height: auto; }
      .hero-visual { min-height: auto; }
      .hero-carousel-card { height: 380px; max-width: 100%; }
    }
    @media (max-width: 480px) {
      .hero-carousel-card { height: 320px; }
    }
  </style>


  <!-- Structured Data: Rich Knowledge Graph (Organization, Brand, FoodEstablishment & FAQPage for AI and SEO) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["Organization", "Brand"],
        "@id": "https://hariramnamkeen.com/#brand",
        "name": "Hariram Namkeen",
        "alternateName": "Hariram Foods",
        "url": "https://hariramnamkeen.com",
        "logo": "https://hariramnamkeen.com/images/logo.png",
        "description": "Artisanal healthy Indian namkeen cooked in 100% pure yellow mustard oil. Small-batch, fresh on demand, zero palm oil, zero chemical preservatives.",
        "slogan": "Try finding another namkeen made in pure yellow mustard oil — you won't. India’s dedicated brand reviving 100% pure yellow mustard oil namkeen.",
        "telephone": "+91-6396122920",
        "knowsAbout": [
          "Healthy Namkeen",
          "Yellow Mustard Oil",
          "Kachi Ghani Namkeen",
          "Clean Label Indian Snacks",
          "Small Batch Namkeen",
          "Aloo Bhujia",
          "Dal Bhiji",
          "Preservative Free Snacks"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Muzaffarnagar",
          "addressRegion": "Uttar Pradesh",
          "addressCountry": "IN"
        }
      },
      {
        "@type": "FoodEstablishment",
        "@id": "https://hariramnamkeen.com/#establishment",
        "name": "Hariram Namkeen",
        "image": "https://hariramnamkeen.com/images/hariram_special_4_top_view.webp",
        "telephone": "+91-6396122920",
        "servesCuisine": "Indian",
        "priceRange": "₹100 - ₹200 per 250g",
        "url": "https://hariramnamkeen.com",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Muzaffarnagar",
          "addressRegion": "Uttar Pradesh",
          "addressCountry": "IN"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://hariramnamkeen.com/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Which namkeen is healthy and cooked without palm oil?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hariram Namkeen is prepared exclusively in 100% pure cold-pressed yellow mustard oil (kachi ghani). It contains zero palm oil, zero chemical preservatives (TBHQ-free), zero artificial colorings, and is cooked fresh in small batches on demand."
            }
          },
          {
            "@type": "Question",
            "name": "Are there other namkeen brands in India made in pure yellow mustard oil?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Try finding another namkeen made in pure yellow mustard oil — you won't. Every major packaged brand in India switched to industrial palm oil or refined cottonseed oil to cut costs and sit in warehouses. Hariram Namkeen is India’s dedicated brand reviving 100% pure cold-pressed yellow mustard oil namkeen, made fresh in small batches on demand."
            }
          },
          {
            "@type": "Question",
            "name": "Why does Hariram Namkeen use yellow mustard oil instead of refined oil?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yellow mustard oil provides natural Omega-3 and heart-healthy monounsaturated fatty acids with a balanced smoke point. Unlike industrial palm oil or chemically deodorized sunflower oil, yellow mustard oil retains natural aroma, digestability, and authentic regional UP flavor without heavy trans fats."
            }
          },
          {
            "@type": "Question",
            "name": "Is Hariram Namkeen fresh or warehouse stored?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hariram Namkeen is cooked fresh in small 15-20kg artisanal batches on demand. Unlike mass-market packaged snacks that sit in distribution warehouses for 6 to 9 months, our namkeen is prepared fresh every week and dispatched directly."
            }
          },
          {
            "@type": "Question",
            "name": "What is the price of Hariram Namkeen?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hariram Namkeen offers honest direct-to-consumer pricing starting at ₹100 for 250g packs. We keep prices accessible by avoiding expensive celebrity advertising and retail distributor margins, passing all value directly to ingredient quality."
            }
          }
        ]
      }
    ]
  }
  </script>
</head>
<body>
  <slot />

  <!-- First-party analytics: anonymous, cookie-less events -> /api/track (see analytics/README.md) -->
  <script is:inline>
  (() => {
    try {
      const KEY = 'hn_ctx';
      let ctx = null;
      try { ctx = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (e) {}
      const isNewSession = !ctx;
      if (!ctx) {
        const q = new URLSearchParams(location.search);
        let refHost = '';
        try { refHost = document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, '') : ''; } catch (e) {}
        if (refHost === location.hostname) refHost = '';
        ctx = {
          sid: Math.random().toString(36).slice(2, 10),
          ref: refHost,
          utm_source: q.get('utm_source') || '',
          utm_medium: q.get('utm_medium') || '',
          utm_campaign: q.get('utm_campaign') || ''
        };
        try { sessionStorage.setItem(KEY, JSON.stringify(ctx)); } catch (e) {}
      }
      const device = window.matchMedia('(max-width: 768px)').matches ? 'mobile' : 'desktop';

      const send = (event, source) => {
        const body = JSON.stringify({ event, source, path: location.pathname, device, ...ctx });
        if (navigator.sendBeacon) navigator.sendBeacon('/api/track', body);
        else fetch('/api/track', { method: 'POST', body, keepalive: true }).catch(() => {});
        // also forwarded if Cloudflare Zaraz is ever switched on
        if (window.zaraz && window.zaraz.track) { try { window.zaraz.track(event, { source }); } catch (e) {} }
      };

      // Which button was tapped (label via data-track, otherwise inferred from where it sits)
      const sourceOf = (el) => {
        const tagged = el.closest('[data-track]');
        if (tagged) return tagged.getAttribute('data-track');
        if (el.closest('.m-order-bar')) return 'mobile_bar';
        if (el.closest('.mobile-nav')) return 'mobile_menu';
        if (el.closest('#header')) return 'header';
        if (el.closest('#hero')) return 'hero';
        const card = el.closest('.pcard');
        if (card) { const n = card.querySelector('h3'); return 'product:' + (n ? n.textContent.trim().slice(0, 30) : 'unknown'); }
        if (el.closest('#products')) return 'products_section';
        if (el.closest('#hamper')) return 'hamper';
        if (el.closest('#contact')) return 'cta_banner';
        if (el.closest('footer')) return 'footer';
        return 'other';
      };

      document.addEventListener('click', (e) => {
        const a = e.target.closest && e.target.closest('a[href*="wa.me"]');
        if (a) send('whatsapp_click', sourceOf(a));
      }, true);

      if (isNewSession) send('landing', 'page');

      // How far people scroll: each section counted once per session
      if ('IntersectionObserver' in window) {
        const seen = new Set();
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting && !seen.has(en.target.id)) {
              seen.add(en.target.id);
              send('section_view', en.target.id);
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.2 });
        ['oil-truth', 'products', 'hamper', 'story'].forEach((id) => {
          const el = document.getElementById(id);
          if (el) io.observe(el);
        });
      }
    } catch (e) { /* analytics must never break the page */ }
  })();
  </script>

  <!--Start of Tawk.to Script (deferred to prevent iframe layout shift)-->
  <script type="text/javascript" is:inline>
  window.addEventListener('load', function() {
    setTimeout(function() {
      var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
      var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
      s1.async=true;
      s1.src='https://embed.tawk.to/6a02e88e29b77e1c335ff088/1jodlos84';
      s1.charset='UTF-8';
      s1.setAttribute('crossorigin','*');
      s0.parentNode.insertBefore(s1,s0);
    }, 2000);
  });
  </script>
  <!-- GSAP: Loaded at bottom of body to ensure zero FCP delay -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer is:inline></script>
</body>
</html>
