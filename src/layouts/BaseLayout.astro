---
// BaseLayout.astro — v2 Dark Luxury Editorial
// Wraps every page with <html>, <head>, fonts, GSAP CDN.

const {
  title = "Hariram Namkeen — Pure Mustard Oil Snacks, Muzaffarnagar",
  description = "Traditional namkeen from Muzaffarnagar. Pure Kachi Ghani mustard oil. No preservatives. FSSAI licensed.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/images/logo.png" />

  <!-- Fonts: Playfair Display (heavy display serif), Plus Jakarta Sans & Inter (body), Noto Sans Devanagari -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700;1,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;600;700;900&display=swap"
    rel="stylesheet"
  />

  <!-- GSAP -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FoodEstablishment",
    "name": "Hariram Namkeen",
    "description": "Traditional homemade namkeen from Muzaffarnagar UP, cooked in pure Kachi Ghani mustard oil",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Muzaffarnagar",
      "addressRegion": "Uttar Pradesh",
      "addressCountry": "IN"
    },
    "telephone": "+91-6396122920",
    "servesCuisine": "Indian",
    "priceRange": "₹100-₹200",
    "url": "https://hariramnamkeen.com"
  }
  </script>
</head>
<body>
  <slot />

  <!--Start of Tawk.to Script-->
  <script type="text/javascript" is:inline>
  var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
  (function(){
  var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
  s1.async=true;
  s1.src='https://embed.tawk.to/6a02e88e29b77e1c335ff088/1jodlos84';
  s1.charset='UTF-8';
  s1.setAttribute('crossorigin','*');
  s0.parentNode.insertBefore(s1,s0);
  })();
  </script>
  <!--End of Tawk.to Script-->
</body>
</html>
