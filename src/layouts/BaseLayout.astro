---
// BaseLayout.astro — v2 Dark Luxury Editorial
// Wraps every page with <html>, <head>, fonts, GSAP CDN.

const {
  title = "Buy Healthy Namkeen Online | Pure Mustard Oil Snacks — Hariram",
  description = "Order fresh artisanal namkeen made in 100% pure yellow mustard oil. Zero palm oil, zero preservatives. Aloo Bhujia, Dal Biji & more. Free delivery across India.",
  image = "/images/hariram_special_4_top_view.webp",
} = Astro.props;

import { GOOGLE_ADS_CONFIG, isGoogleAdsConfigured } from '../config/googleAds';

const gadsActive = isGoogleAdsConfigured();
const { tagId, conversionSendTo } = GOOGLE_ADS_CONFIG;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://hariramnamkeen.com');
const ogImageURL = new URL(image, Astro.site || 'https://hariramnamkeen.com');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="alternate" hreflang="en-IN" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />
  <meta name="keywords" content="namkeen online, buy namkeen online, healthy namkeen, mustard oil namkeen, namkeen without palm oil, kachi ghani namkeen, aloo bhujia, dal bhiji, masala chana dal, namkeen gift box, namkeen hamper, fresh namkeen delivery India, preservative free namkeen, Muzaffarnagar namkeen, artisanal Indian snacks, TBHQ free namkeen, small batch namkeen, yellow mustard oil snacks, सरसों के तेल की नमकीन, शुद्ध नमकीन" />
  <meta name="author" content="Hariram Namkeen" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  {gadsActive && (
    <>
      <!-- Google tag (gtag.js) -->
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(tagId)}`}></script>
      <script is:inline define:vars={{ tagId, conversionSendTo }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = window.gtag || gtag;
        gtag('js', new Date());
        gtag('config', tagId);
        window.__GADS_SEND_TO__ = conversionSendTo;
      </script>
    </>
  )}

  <!-- Local SEO Geotags: Muzaffarnagar, Uttar Pradesh -->
  <meta name="geo.region" content="IN-UP" />
  <meta name="geo.placename" content="Muzaffarnagar" />
  <meta name="geo.position" content="29.4727;77.7085" />
  <meta name="ICBM" content="29.4727, 77.7085" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Fonts: Optimized and preloaded for minimal CLS -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Preload Critical LCP Hero Image for Instant Mobile Paint -->
  <link
    rel="preload"
    as="image"
    type="image/webp"
    href="/images/aloo_bhujia.webp"
    fetchpriority="high"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </noscript>

  <!-- Critical Above-the-Fold Layout (Instant reserved space, prevents Frame 0 height:0 CLS) -->
  <style is:inline>
    @font-face {
      font-family: 'Playfair Display Fallback';
      src: local('Georgia');
      ascent-override: 95%;
      descent-override: 25%;
      line-gap-override: 0%;
      size-adjust: 104%;
    }
    #header { position: fixed; top: 0; left: 0; right: 0; z-index: 500; height: 76px; }
    .hero {
      min-height: calc(100vh - 72px);
      min-height: calc(100dvh - 72px);
      position: relative;
      background: #FAF5EB;
      padding: 84px clamp(20px, 4vw, 48px) 48px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 48px;
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      position: relative;
      z-index: 2;
      min-height: 540px;
    }
    .hero-headline {
      font-family: 'Playfair Display', 'Playfair Display Fallback', Georgia, serif;
      font-size: clamp(38px, 4.2vw, 56px);
      line-height: 1.15;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .hero-visual { min-height: 540px; width: 100%; display: flex; align-items: center; justify-content: center; }
    .hero-carousel-card { position: relative; width: 100%; max-width: 600px; height: 540px; }
    @media (max-width: 1024px) {
      .hero { min-height: auto; padding-top: 84px; padding-bottom: 36px; }
      .hero-inner { grid-template-columns: 1fr; gap: 32px; min-height: auto; }
      .hero-visual { min-height: auto; }
      .hero-carousel-card { height: 380px; max-width: 100%; }
    }
    @media (max-width: 480px) {
      .hero-carousel-card { height: 320px; }
    }
  </style>


