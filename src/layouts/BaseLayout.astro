---
// BaseLayout.astro — v2 Dark Luxury Editorial
// Wraps every page with <html>, <head>, fonts, GSAP CDN.

const {
  title = "Buy Healthy Namkeen Online | Pure Mustard Oil Snacks — Hariram",
  description = "Order fresh artisanal namkeen made in 100% pure yellow mustard oil. Zero palm oil, zero preservatives. Aloo Bhujia, Dal Biji & more. Free delivery across India.",
  image = "/images/hariram_special_4_top_view.webp",
  keywords = "namkeen online, buy namkeen online, healthy namkeen, mustard oil namkeen, namkeen without palm oil, yellow mustard oil namkeen, aloo bhujia, dal biji, dal bhiji, masala chana dal, masala moongfali, spicy malka, namkeen gift box, namkeen hamper, fresh namkeen delivery India, preservative free namkeen, Muzaffarnagar namkeen, artisanal Indian snacks, TBHQ free namkeen, small batch namkeen, yellow mustard oil snacks, सरसों के तेल की नमकीन, शुद्ध नमकीन",
} = Astro.props;

import {
  GOOGLE_TAG_CONFIG,
  isGoogleTagConfigured,
  isGaConfigured,
  isAnyGoogleTagActive,
} from '../config/googleAds';

const adsTagActive = isGoogleTagConfigured();
const gaActive = isGaConfigured();
const anyTagActive = isAnyGoogleTagActive();

const adsTagId = GOOGLE_TAG_CONFIG.adsTagId;
const gaMeasurementId = GOOGLE_TAG_CONFIG.gaMeasurementId;
const conversionSendTo = GOOGLE_TAG_CONFIG.conversionSendTo;
const primaryTagId = adsTagActive ? adsTagId : gaMeasurementId;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://hariramnamkeen.com');
const ogImageURL = new URL(image, Astro.site || 'https://hariramnamkeen.com');
---

<!DOCTYPE html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="alternate" hreflang="en-IN" href={canonicalURL} />
  <link rel="alternate" hreflang="en" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Hariram Namkeen" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  {anyTagActive && (
    <>
      <!-- Google tag (gtag.js) -->
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(primaryTagId)}`}></script>
      <script is:inline define:vars={{ adsTagActive, adsTagId, gaActive, gaMeasurementId, conversionSendTo }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = window.gtag || gtag;
        gtag('js', new Date());
        if (adsTagActive) {
          gtag('config', adsTagId);
        }
        if (gaActive) {
          gtag('config', gaMeasurementId);
        }
        window.__GADS_SEND_TO__ = conversionSendTo;
      </script>
    </>
  )}

  <!-- Local SEO Geotags: Muzaffarnagar, Uttar Pradesh -->
  <meta name="geo.region" content="IN-UP" />
  <meta name="geo.placename" content="Muzaffarnagar" />
  <meta name="geo.position" content="29.4727;77.7085" />
  <meta name="ICBM" content="29.4727, 77.7085" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Fonts: Optimized and preloaded for minimal CLS -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..800&family=Noto+Sans+Devanagari:wght@400;600;700&family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Sacramento&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..800&family=Noto+Sans+Devanagari:wght@400;600;700&family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Sacramento&display=swap"
      rel="stylesheet"
    />
  </noscript>

  <!-- Critical Above-the-Fold Layout (Instant reserved space, prevents Frame 0 height:0 CLS) -->
  <style is:inline>
    @font-face {
      font-family: 'Playfair Display Fallback';
      src: local('Georgia');
      ascent-override: 95%;
      descent-override: 25%;
      line-gap-override: 0%;
      size-adjust: 104%;
    }
    #header { position: fixed; top: 0; left: 0; right: 0; z-index: 500; height: 76px; }
    .hero {
      min-height: calc(100vh - 76px);
      min-height: calc(100dvh - 76px);
      display: grid;
      grid-template-columns: 1fr 1fr;
      overflow: hidden;
      padding-top: 76px;
      position: relative;
    }
    .hero-mobile-img { display: none; }
    .hero-headline {
      font-family: 'Playfair Display', 'Playfair Display Fallback', Georgia, serif;
      font-size: clamp(36px, 4.8vw, 60px);
      line-height: 1.18;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    @media (max-width: 768px) {
      .hero {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        padding-top: 100px;
        padding-bottom: 40px;
        min-height: auto;
        max-height: none;
      }
      .hero-visual { display: none; }
      .hero-mobile-img { display: block; }
    }
  </style>


  <!-- Structured Data: Rich Knowledge Graph (Organization, Brand, FoodEstablishment, LocalBusiness, WebSite for AI and SEO) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://hariramnamkeen.com/#website",
        "url": "https://hariramnamkeen.com",
        "name": "Hariram Namkeen",
        "description": "Buy healthy namkeen online made in 100% pure yellow mustard oil. Fresh, small-batch, preservative-free Indian snacks from Muzaffarnagar.",
        "publisher": { "@id": "https://hariramnamkeen.com/#brand" },
        "inLanguage": ["en-IN", "hi-IN"],
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://hariramnamkeen.com/?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": ["Organization", "Brand"],
        "@id": "https://hariramnamkeen.com/#brand",
        "name": "Hariram Namkeen",
        "alternateName": ["Hariram Foods", "हरिराम नमकीन"],
        "url": "https://hariramnamkeen.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://hariramnamkeen.com/images/logo.png",
          "width": 600,
          "height": 400
        },
        "image": "https://hariramnamkeen.com/images/hariram_special_4_top_view.webp",
        "description": "Artisanal healthy Indian namkeen cooked in 100% pure yellow mustard oil. Small-batch, fresh on demand, zero palm oil, zero chemical preservatives. Buy namkeen online with free delivery across India.",
        "slogan": "Try finding another namkeen made in pure yellow mustard oil — you won't.",
        "telephone": "+91-6396122920",
        "email": "namaste@hariramnamkeen.com",
        "foundingLocation": "Muzaffarnagar, Uttar Pradesh, India",
        "knowsAbout": [
          "Healthy Namkeen",
          "Yellow Mustard Oil",
          "Mustard Oil Namkeen",
          "Namkeen Without Palm Oil",
          "Zero Palm Oil Snacks",
          "TBHQ Free Namkeen",
          "Clean Label Indian Snacks",
          "Small Batch Namkeen",
          "Aloo Bhujia",
          "Dal Biji",
          "Masala Chana Dal",
          "Masala Moongfali",
          "Spicy Malka",
          "Shahi Dal Biji",
          "Preservative Free Snacks",
          "Palm Oil Free Snacks",
          "Namkeen Online Delivery India",
          "Artisanal Indian Snacks",
          "Peeli Sarson Ka Tel Namkeen"
        ],
        "sameAs": [
          "https://instagram.com/hariram.namkeen"
        ],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Main Market",
          "addressLocality": "Muzaffarnagar",
          "addressRegion": "Uttar Pradesh",
          "postalCode": "251001",
          "addressCountry": "IN"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+91-6396122920",
          "contactType": "customer service",
          "availableLanguage": ["English", "Hindi"],
          "areaServed": "IN"
        }
      },
      {
        "@type": ["LocalBusiness", "FoodEstablishment"],
        "@id": "https://hariramnamkeen.com/#localbusiness",
        "name": "Hariram Namkeen — Pure Mustard Oil Namkeen, Muzaffarnagar",
        "image": "https://hariramnamkeen.com/images/hariram_special_4_top_view.webp",
        "telephone": "+91-6396122920",
        "email": "namaste@hariramnamkeen.com",
        "url": "https://hariramnamkeen.com",
        "servesCuisine": "Indian Namkeen & Snacks",
        "priceRange": "₹100 - ₹499",
        "currenciesAccepted": "INR",
        "paymentAccepted": "UPI, WhatsApp Pay, Bank Transfer",
        "areaServed": {
          "@type": "Country",
          "name": "India"
        },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Main Market",
          "addressLocality": "Muzaffarnagar",
          "addressRegion": "Uttar Pradesh",
          "postalCode": "251001",
          "addressCountry": "IN"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 29.4727,
          "longitude": 77.7085
        }
      }
    ]
  }
  </script>
</head>
<body>
  <slot />

  <!-- First-party analytics: anonymous, cookie-less events -> /api/track (see analytics/README.md) -->
  <script is:inline>
  (() => {
    try {
      const KEY = 'hn_ctx';
      let ctx = null;
      try { ctx = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (e) {}
      const isNewSession = !ctx;
      const q = new URLSearchParams(location.search);
      const incomingSource = q.get('utm_source') || (q.get('gclid') ? 'google_ads' : '');
      if (!ctx) {
        let refHost = '';
        try { refHost = document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, '') : ''; } catch (e) {}
        if (refHost === location.hostname) refHost = '';
        ctx = {
          sid: Math.random().toString(36).slice(2, 10),
          ref: refHost,
          utm_source: incomingSource,
          utm_medium: q.get('utm_medium') || (q.get('gclid') ? 'cpc' : ''),
          utm_campaign: q.get('utm_campaign') || (q.get('gclid') ? 'gads_click' : '')
        };
        try { sessionStorage.setItem(KEY, JSON.stringify(ctx)); } catch (e) {}
      } else if (incomingSource && (!ctx.utm_source || ctx.utm_source !== incomingSource)) {
        ctx.utm_source = incomingSource;
        ctx.utm_medium = q.get('utm_medium') || (q.get('gclid') ? 'cpc' : (ctx.utm_medium || ''));
        ctx.utm_campaign = q.get('utm_campaign') || (q.get('gclid') ? 'gads_click' : (ctx.utm_campaign || ''));
        try { sessionStorage.setItem(KEY, JSON.stringify(ctx)); } catch (e) {}
      }
      const device = window.matchMedia('(max-width: 768px)').matches ? 'mobile' : 'desktop';

      // Dynamic WhatsApp attribution helper:
      // Only append campaign references (e.g. Ref: GAds or Ref: instagram) when an explicit campaign source exists.
      // Organic and direct visitors remain clean with zero Ref tags so attribution is never polluted.
      const getAttributedWaUrl = (rawHref) => {
        if (!rawHref || !rawHref.includes('wa.me') || !ctx || !ctx.utm_source) return rawHref;
        try {
          const src = String(ctx.utm_source);
          const refTag = (src === 'google_ads' || src.toLowerCase() === 'gads') ? 'GAds' : src;
          const u = new URL(rawHref, location.origin);
          const currentText = u.searchParams.get('text');
          if (currentText) {
            if (!currentText.includes('Ref:')) {
              u.searchParams.set('text', currentText + ' Ref: ' + refTag);
            }
          } else {
            u.searchParams.set('text', 'Ref: ' + refTag);
          }
          return u.toString();
        } catch (e) {
          return rawHref;
        }
      };

      const decorateWaLinks = () => {
        if (!ctx || !ctx.utm_source) return;
        document.querySelectorAll('a[href*="wa.me"]').forEach((a) => {
          a.href = getAttributedWaUrl(a.href);
        });
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', decorateWaLinks);
      } else {
        decorateWaLinks();
      }

      const send = (event, source) => {
        const body = JSON.stringify({ event, source, path: location.pathname, device, ...ctx });
        if (navigator.sendBeacon) navigator.sendBeacon('/api/track', body);
        else fetch('/api/track', { method: 'POST', body, keepalive: true }).catch(() => {});
        // also forwarded if Cloudflare Zaraz is ever switched on
        if (window.zaraz && window.zaraz.track) { try { window.zaraz.track(event, { source }); } catch (e) {} }
      };

      // Which button was tapped (label via data-track, otherwise inferred from where it sits)
      const sourceOf = (el) => {
        const tagged = el.closest('[data-track]');
        if (tagged) return tagged.getAttribute('data-track');
        if (el.closest('.m-order-bar')) return 'mobile_bar';
        if (el.closest('.mobile-nav')) return 'mobile_menu';
        if (el.closest('#header')) return 'header';
        if (el.closest('#hero')) return 'hero';
        const card = el.closest('.pcard');
        if (card) { const n = card.querySelector('h3'); return 'product:' + (n ? n.textContent.trim().slice(0, 30) : 'unknown'); }
        if (el.closest('#products')) return 'products_section';
        if (el.closest('#hamper')) return 'hamper';
        if (el.closest('#contact')) return 'cta_banner';
        if (el.closest('footer')) return 'footer';
        return 'other';
      };

      document.addEventListener('click', (e) => {
        const a = e.target.closest && e.target.closest('a[href*="wa.me"]');
        if (a) {
          a.href = getAttributedWaUrl(a.href);
          send('whatsapp_click', sourceOf(a));
        }
      }, true);

      if (isNewSession) send('landing', 'page');

      // How far people scroll: each section counted once per session
      if ('IntersectionObserver' in window) {
        const seen = new Set();
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting && !seen.has(en.target.id)) {
              seen.add(en.target.id);
              send('section_view', en.target.id);
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.2 });
        ['oil-truth', 'products', 'hamper', 'story'].forEach((id) => {
          const el = document.getElementById(id);
          if (el) io.observe(el);
        });
      }
    } catch (e) { /* analytics must never break the page */ }
  })();
  </script>

  <!--Start of Tawk.to Script (desktop only to prevent mobile clutter and button blocking)-->
  <script type="text/javascript" is:inline>
  window.addEventListener('load', function() {
    if (window.innerWidth <= 768) return; // Keep mobile screen clean and focused on WhatsApp
    setTimeout(function() {
      var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
      var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
      s1.async=true;
      s1.src='https://embed.tawk.to/6a02e88e29b77e1c335ff088/1jodlos84';
      s1.charset='UTF-8';
      s1.setAttribute('crossorigin','*');
      s0.parentNode.insertBefore(s1,s0);
    }, 2000);
  });
  </script>
  <!-- GSAP: Loaded at bottom of body to ensure zero FCP delay -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer is:inline></script>
  <!-- Google Ads WhatsApp Click Conversion Tracking -->
  <script is:inline>
  (() => {
    document.addEventListener('click', (e) => {
      const link = e.target && e.target.closest
        ? e.target.closest('a[data-wa-click]')
        : null;
      if (!link) return;

      // Track WhatsApp lead in Google Analytics 4
      if (typeof window.gtag === 'function') {
        try {
          window.gtag('event', 'generate_lead', {
            event_category: 'engagement',
            event_label: 'whatsapp_order',
            transport_type: 'beacon'
          });
        } catch (err) {}
      }

      const sendTo = window.__GADS_SEND_TO__;

      // Rule 1: If Google Ads conversion is unconfigured, placeholder, or gtag not loaded: proceed natively
      if (
        !sendTo ||
        typeof window.gtag !== 'function' ||
        sendTo === 'AW-XXXXXXXXXX/LABEL' ||
        sendTo.indexOf('XXXXXXXXXX') !== -1 ||
        sendTo.indexOf('/LABEL') !== -1
      ) {
        return; // Standard native navigation proceeds immediately without delay
      }

      // Rule 3: Never fire twice per click
      if (link.__wa_in_flight) {
        e.preventDefault();
        return;
      }
      link.__wa_in_flight = true;

      // For modified or non-left clicks (middle click, Cmd/Ctrl-click), fire conversion without preventing native browser navigation
      if (e.button > 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) {
        try {
          window.gtag('event', 'conversion', { send_to: sendTo });
        } catch (err) {}
        link.__wa_in_flight = false;
        return;
      }

      const url = link.href;
      const target = link.target;
      let navigated = false;

      const openWhatsApp = () => {
        if (navigated) return;
        navigated = true;
        link.__wa_in_flight = false;

        if (target === '_blank') {
          const win = window.open(url, '_blank', 'noopener,noreferrer');
          if (!win || win.closed || typeof win.closed === 'undefined') {
            window.location.href = url;
          }
        } else {
          window.location.href = url;
        }
      };

      // Rule 3: Never delay opening WhatsApp by more than ~300 ms
      const safetyTimer = setTimeout(openWhatsApp, 280);

      try {
        e.preventDefault();
        // Rule 3: Fire one conversion event. Counts a WhatsApp CLICK only, not a sale (no monetary value).
        window.gtag('event', 'conversion', {
          send_to: sendTo,
          event_callback: () => {
            clearTimeout(safetyTimer);
            openWhatsApp();
          }
        });
      } catch (err) {
        clearTimeout(safetyTimer);
        openWhatsApp();
      }
    }, false);
  })();
  </script>
</body>
</html>
