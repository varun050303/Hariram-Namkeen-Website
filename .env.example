# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default primary model (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Override fallback models if primary model hits rate limits
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Google Ads Tracking
PUBLIC_GADS_TAG_ID=AW-18507413408
# PUBLIC_GADS_CONVERSION_SEND_TO=AW-18507413408/your_conversion_label

