---
// BaseLayout.astro
// Wraps every page with <html>, <head>, fonts, GSAP CDN.

const {
  title = "Hariram Namkeen — Pure Mustard Oil Snacks, Muzaffarnagar",
  description = "Traditional namkeen from Muzaffarnagar. Pure Kachi Ghani mustard oil. No preservatives. FSSAI licensed.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/images/logo.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Noto+Sans+Devanagari:wght@400;700&display=swap"
    rel="stylesheet"
  />

  <!-- GSAP (free since Webflow acquisition 2024) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>
</head>
<body>
  <slot />
</body>
</html>
