---
// CTA.astro
// WhatsApp-first conversion section.
// TODO: Replace phone number with business WhatsApp/call number.
---

<section class="cta-section">
  <div style="max-width:1200px;margin:0 auto;padding:0 40px;">
    <div class="cta-inner">
      <div class="cta-text">
        <h2>Fresh batch ready. Order on WhatsApp.</h2>
        <p>Get today's prices, pack sizes, and delivery details in one message.</p>
      </div>
      <div class="cta-actions">
        <a
          class="cta-btn cta-btn-wa"
          href="https://wa.me/919999999999?text=Hi%20Hariram%20Namkeen%2C%20please%20share%20today%27s%20menu%20and%20prices."
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic
        >
          <span>WhatsApp Order</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="cta-btn cta-btn-call" href="tel:+919999999999" data-magnetic>
          <span>Call Now</span>
        </a>
      </div>
    </div>
  </div>
</section>
