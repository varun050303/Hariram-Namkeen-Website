---
// Hero.astro
// Animation: headline line-by-line reveal, parallax on hero-visual
// All driven by GSAP timeline in animations.js (heroTl)
---

<section class="hero" id="hero">
  <div class="hero-content">
    <div class="hero-origin" id="h-origin">
      <span class="hero-origin-dot"></span>
      Muzaffarnagar, UP
    </div>

    <h1 class="hero-headline">
      <span class="split-line"><span class="split-inner" id="hl1">Prepared in pure</span></span>
      <span class="split-line"><em><span class="split-inner" id="hl2">Yellow Mustard Oil.</span></em></span>
      <span class="split-line"><span class="gold"><span class="split-inner" id="hl3">No cheap palm or refined oil.</span></span></span>
    </h1>

    <p class="hero-sub" id="h-sub">
      Unlike other brands that cut costs with cheap, unhealthy oils, we prioritize your health. Experience authentic UP namkeen, made without compromise.
    </p>

    <div class="hero-btns" id="h-btns">
      <a href="#order" class="btn-p" data-magnetic>
        Order Now
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="https://wa.me/916396122920" target="_blank" rel="noopener noreferrer" class="btn-wa" data-magnetic>
