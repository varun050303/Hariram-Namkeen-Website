---
// Products.astro
// Product cards with:
//   - 3D tilt on mousemove (GSAP)
//   - Ingredient overlay on hover (CSS)
//   - Staggered entrance via ScrollTrigger
---

<section class="products" id="products">
  <div class="sec-bg-text" aria-hidden="true">नमकीन</div>
  <div style="max-width:1200px;margin:0 auto;padding:0 40px;position:relative;z-index:1;">
    <div class="products-head">
      <div>
        <div class="sec-tag">Our Products</div>
        <h2 class="sec-title">Made right. <em>Priced honestly.</em></h2>
        <p class="sec-sub">Hover any product to see what's inside. Every SKU — pure mustard oil.</p>
      </div>
      <a href="https://wa.me/916396122920" target="_blank" rel="noopener noreferrer" class="view-all">Order Online ↗</a>
    </div>
    <div class="products-grid">

      <div class="pcard" data-tilt>
        <div class="pcard-img">
          <img src="/images/dal-bhiji.jpg" alt="Dal Bhiji"/>
          <span class="pbadge">Best Seller</span>
          <div class="pcard-ingredients">
            <div class="ing-title">What's inside</div>
            <div class="ing-item">Moong Dal</div>
            <div class="ing-item">Kachi Ghani Mustard Oil</div>
            <div class="ing-item">Turmeric &amp; Cumin</div>
            <div class="ing-item">Rock Salt</div>
            <div class="ing-item">Bay Leaf</div>
          </div>
        </div>
        <div class="pinfo">
          <h3>Dal Bhiji</h3>
          <div class="pinfo-hi">दाल भीजी</div>
          <div class="ptags"><span class="ptag">Mustard Oil</span><span class="ptag">No Preservatives</span></div>
          <div class="pweight">⚖ 250g</div>
          <div class="pfoot">
            <div class="pprice">₹125 <span>/ 250g</span></div>
            <a href="https://wa.me/916396122920" target="_blank" rel="noopener noreferrer" class="porder">Order ↗</a>
          </div>
        </div>
      </div>

      <div class="pcard" data-tilt>
        <div class="pcard-img">
          <img src="/images/premium.jpg" alt="Shahi Dal Bhiji"/>
          <div class="pcard-ingredients">
            <div class="ing-title">What's inside</div>
            <div class="ing-item">Moong Dal + Sev</div>
            <div class="ing-item">Kachi Ghani Mustard Oil</div>
            <div class="ing-item">Whole Cashews</div>
            <div class="ing-item">Raisins &amp; Dried Coconut</div>
            <div class="ing-item">Premium Spice Blend</div>
          </div>
        </div>
        <div class="pinfo">
          <h3>Shahi Dal Bhiji</h3>
          <div class="pinfo-hi">शाही दाल भीजी</div>
          <div class="ptags"><span class="ptag">Dry Fruits</span><span class="ptag">Premium</span></div>
          <div class="pweight">⚖ 250g</div>
          <div class="pfoot">
            <div class="pprice">₹200 <span>/ 250g</span></div>
            <a href="https://wa.me/916396122920" target="_blank" rel="noopener noreferrer" class="porder">Order ↗</a>
          </div>
        </div>
      </div>

      <div class="pcard" data-tilt>
        <div class="pcard-img">
          <img src="/images/chana-dal.jpg" alt="Masala Chana Dal"/>
          <div class="pcard-ingredients">
            <div class="ing-title">What's inside</div>
            <div class="ing-item">Chana Dal (Bengal Gram)</div>
            <div class="ing-item">Kachi Ghani Mustard Oil</div>
            <div class="ing-item">Chilli &amp; Coriander</div>
            <div class="ing-item">Amchur (Dry Mango)</div>
            <div class="ing-item">Chat Masala</div>
          </div>
        </div>
        <div class="pinfo">
          <h3>Masala Chana Dal</h3>
          <div class="pinfo-hi">मसाला चना दाल</div>
          <div class="ptags"><span class="ptag">High Protein</span><span class="ptag">Spicy</span></div>
          <div class="pweight">⚖ 250g</div>
          <div class="pfoot">
            <div class="pprice">₹100 <span>/ 250g</span></div>
            <a href="https://wa.me/916396122920" target="_blank" rel="noopener noreferrer" class="porder">Order ↗</a>
          </div>
        </div>
      </div>


      <div class="pcard" data-tilt>
        <div class="pcard-img" style="background:#f9f9f9;">
          <div class="placeholder" style="background:linear-gradient(135deg,#f0f0f0,#e8e8e8);color:#ccc;">⏳</div>
        </div>
        <div class="pinfo">
          <h3>Coming Soon</h3>
          <div class="pinfo-hi">जल्द आ रहा है</div>
          <div class="ptags"><span class="ptag">New Recipe</span><span class="ptag">In Kitchen</span></div>
          <div class="pweight">⚖ ???</div>
          <div class="pfoot">
            <div class="pprice" style="font-size:16px;color:var(--muted);font-style:italic;">Testing...</div>
          </div>
        </div>
      </div>

    </div>

    <!-- Coming Soon Banner -->
    <div class="products-coming-soon">
      <div class="pcs-icon">🍲</div>
      <div class="pcs-content">
        <h3>More Flavours In The Kitchen</h3>
        <p>We cook what you crave. We're testing new authentic UP recipes every month based on your demand. Have a favourite namkeen you want us to make in your preferred oil?</p>
      </div>
      <a href="https://wa.me/916396122920?text=I'd%20love%20to%20suggest%20a%20new%20namkeen%20flavour%21" target="_blank" rel="noopener noreferrer" class="pcs-btn" data-magnetic>
        Suggest a Flavour ↗
      </a>
    </div>
  </div>
</section>
