---
// Platforms.astro
// Where to order: Swiggy, Zomato, Amazon, Flipkart, Meesho
// TODO: Replace href="#" with actual storefront URLs
---

<section class="platforms-section" id="order">
  <div style="max-width:1200px;margin:0 auto;padding:0 40px;">
    <div class="platforms-label">Available On</div>
    <h2 class="platforms-hl">Order where you <em>already shop.</em></h2>
    <p class="platforms-sub">No app to download. No new account. Just order on the platform you trust.</p>
    <div class="platforms-grid">
      <a href="#" class="platform-card" data-magnetic>
        <span class="platform-icon" style="background:rgba(252,88,0,.15);">🟠</span>
        <span>Swiggy</span>
      </a>
      <a href="#" class="platform-card" data-magnetic>
        <span class="platform-icon" style="background:rgba(203,31,27,.12);">🔴</span>
        <span>Zomato</span>
      </a>
      <a href="#" class="platform-card" data-magnetic>
        <span class="platform-icon" style="background:rgba(247,155,0,.12);">📦</span>
        <span>Amazon</span>
      </a>
      <a href="#" class="platform-card" data-magnetic>
        <span class="platform-icon" style="background:rgba(67,160,71,.12);">🛒</span>
        <span>Flipkart</span>
      </a>
      <a href="#" class="platform-card" data-magnetic>
        <span class="platform-icon" style="background:rgba(255,58,129,.12);">🛍</span>
        <span>Meesho</span>
      </a>
    </div>
  </div>
</section>
